void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
{
   if (!EnableAnalysisCsv)
      return;
   if (trans.type == TRADE_TRANSACTION_DEAL_ADD)
      QueueTradeEvent(trans.deal, trans.order, trans.position);
}

string TrendTypeToString(TrendType t)
{
   return EnumToString(t);
}

string TrendStateToString(TrendState s)
{
   return EnumToString(s);
}

string DivergenceTypeToString(DivergenceType d)
{
   switch(d)
   {
      case DIVERGENCE_NONE:
         return "なし";
      case DIVERGENCE_BULLISH:
         return "強気";
      case DIVERGENCE_BEARISH:
         return "弱気";
      case DIVERGENCE_CONFLICT:
         return "競合";
      default:
         return "不明";
   }
}

