bool ClosePositionByTicket(ulong ticket, const string reason, bool weekendForceClose = false)
{
   if (!PositionSelectByTicket(ticket))
      return (false);
   long ptype = PositionGetInteger(POSITION_TYPE);
   long positionId = EnableAnalysisCsv ? PositionGetInteger(POSITION_IDENTIFIER) : 0;
   double vol = PositionGetDouble(POSITION_VOLUME);
   double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ask - bid) / _Point;
   double requestedPrice = ptype == POSITION_TYPE_BUY ? bid : ask;
   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.position = ticket;
   req.symbol = _Symbol;
   req.volume = vol;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.price = requestedPrice;
   req.type = (ptype == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
   datetime requestTime = GetRequestServerTime();
   if (weekendForceClose)
      ResetLastError();
   bool sent = OrderSend(req, res);
   int lastError = weekendForceClose ? GetLastError() : 0;
   RequestEvaluation evaluation = !sent ? REQUEST_SEND_FAILED :
      ((res.retcode == TRADE_RETCODE_DONE || res.retcode == TRADE_RETCODE_DONE_PARTIAL)
       ? REQUEST_EXECUTION_SUCCEEDED : REQUEST_EXECUTION_FAILED);
   RecordRequest(ptype == POSITION_TYPE_BUY ? "BUYポジション決済" : "SELLポジション決済",
                 evaluation, res.retcode, requestTime);
   if (!sent || (res.retcode != TRADE_RETCODE_DONE && res.retcode != TRADE_RETCODE_DONE_PARTIAL))
   {
      if (weekendForceClose)
      {
         if (EnableAnalysisCsv)
         {
            SAnalysisRecord analysis;
            ResetAnalysisRecord(analysis, "WEEKEND");
            SetAnalysisContext(analysis, requestTime, (long)requestTime * 1000);
            analysis.values[AC_DIRECTION] = ptype == POSITION_TYPE_BUY ? "BUY" : "SELL";
            analysis.values[AC_TICKET] = AnalysisLong((long)ticket);
            analysis.values[AC_REASON] = "Force close failed";
            analysis.values[AC_REASON_DETAIL] = "Success=false;GetLastError=" + IntegerToString(lastError);
            analysis.values[AC_RETCODE] = IntegerToString((int)res.retcode);
            analysis.values[AC_COMMENT] = res.comment;
            WriteAnalysisRecord(analysis);
         }
      }
      else if (!sent)
         PrintFormat("決済失敗 type=%s ticket=%I64u entry=%.5f price=%.5f lot=%.2f spread=%.1f reason=%s retcode=%d comment=%s err=%d", ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", ticket, openPrice, requestedPrice, vol, spreadPts, reason, res.retcode, res.comment, GetLastError());
      else
         PrintFormat("決済実行失敗 type=%s ticket=%I64u entry=%.5f price=%.5f lot=%.2f spread=%.1f reason=%s retcode=%d comment=%s err=%d", ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", ticket, openPrice, requestedPrice, vol, spreadPts, reason, res.retcode, res.comment, GetLastError());
      return (false);
   }
   if (EnableAnalysisCsv)
   {
      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "EXIT_REQUEST");
      double closePrice = 0.0;
      if (res.deal > 0)
      {
         ResetLastError();
         if (HistoryDealSelect(res.deal))
         {
            closePrice = HistoryDealGetDouble(res.deal, DEAL_PRICE);
         }
         else
            PrintFormat("Deal情報取得中止：Deal選択失敗 deal=%I64u error=%d", res.deal, GetLastError());
      }
      SetAnalysisContext(analysis, requestTime, (long)requestTime * 1000L);
      analysis.values[AC_DIRECTION] = ptype == POSITION_TYPE_BUY ? "BUY" : "SELL";
      analysis.values[AC_TICKET] = AnalysisLong((long)ticket);
      analysis.values[AC_POSITION] = AnalysisLong(positionId);
      analysis.values[AC_ENTRY_PRICE] = AnalysisNumber(openPrice, _Digits);
      if (closePrice > 0.0)
      {
         analysis.values[AC_PRICE] = AnalysisNumber(closePrice, _Digits);
         analysis.values[AC_EXIT_PRICE] = AnalysisNumber(closePrice, _Digits);
         analysis.values[AC_EXECUTION_PRICE] = AnalysisNumber(closePrice, _Digits);
      }
      analysis.values[AC_LOT] = AnalysisNumber(vol, 2);
      analysis.values[AC_BID] = AnalysisNumber(bid, _Digits);
      analysis.values[AC_ASK] = AnalysisNumber(ask, _Digits);
      analysis.values[AC_SPREAD_POINTS] = AnalysisNumber(spreadPts, 1);
      analysis.values[AC_REASON] = reason;
      analysis.values[AC_REASON_DETAIL] = "EA close request; actual Deal reason is recorded separately in DEAL.";
      analysis.values[AC_REQUESTED_PRICE] = AnalysisNumber(req.price, _Digits);
      analysis.values[AC_ORDER_VOLUME] = AnalysisNumber(req.volume, 2);
      analysis.values[AC_MAGIC_NUMBER] = AnalysisLong(MagicNumber);
      analysis.values[AC_RETCODE] = IntegerToString((int)res.retcode);
      analysis.values[AC_COMMENT] = res.comment;
      analysis.values[AC_DEAL] = AnalysisLong((long)res.deal);
      analysis.values[AC_ORDER] = AnalysisLong((long)res.order);
      WriteAnalysisRecord(analysis);
      CaptureExitLightSnapshot((ulong)res.order, (ulong)res.deal, (ulong)positionId,
                              req.price, req.volume, reason);
      FlushTradeTickHistoryToCsv();
      g_tradeTickWritePos = 0;
      g_tradeTickCount = 0;
   }
   return (true);
}

bool IsPyramidAllowedByM15(bool isBuy)
{
   if (!g_m15AllOk || !g_m15_rsi_ok || ArraySize(g_m15_rsiArr) == 0)
      return false;

   int sameDirCount = isBuy ? BuyCount : SellCount;
   if (sameDirCount == 0)
      return true;
   if (!g_M15Signal.pendingNextM1)
      return true;

   double rsi = g_m15_rsiArr[1];
   if (!IsIndicatorValueValid(rsi))
      return false;
   if (isBuy)
      return !g_M15Signal.suppressBuyPyramid && rsi >= 70.0;
   return !g_M15Signal.suppressSellPyramid && rsi <= 30.0;
}

