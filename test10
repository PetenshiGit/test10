   }

   h_emaS = iMA(_Symbol, PERIOD_H1, emaShortPeriod, 0, MODE_EMA, PRICE_CLOSE);
   h_emaL = iMA(_Symbol, PERIOD_H1, emaLongPeriod, 0, MODE_EMA, PRICE_CLOSE);
   if (h_emaS == INVALID_HANDLE || h_emaL == INVALID_HANDLE)
   {
      Print("EMAハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_rsi = iRSI(_Symbol, PERIOD_M15, rsiPeriod, PRICE_CLOSE);
   if (h_rsi == INVALID_HANDLE)
   {
      Print("RSIハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_macd = iMACD(_Symbol, PERIOD_M15, macdFast, macdSlow, macdSignal, PRICE_CLOSE);
   if (h_macd == INVALID_HANDLE)
   {
      Print("MACDハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_bb = iBands(_Symbol, PERIOD_M1, bbPeriod, bbDeviation, 0, PRICE_CLOSE);
   if (h_bb == INVALID_HANDLE)
   {
      Print("BBハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_std = iStdDev(_Symbol, PERIOD_M1, bbPeriod, 0, MODE_SMA, PRICE_CLOSE);
   if (h_std == INVALID_HANDLE)
   {
      Print("StdDevハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_stoch = iStochastic(_Symbol, PERIOD_M1, stochK, stochD, stochSlowing, MODE_SMA, 0);
   if (h_stoch == INVALID_HANDLE)
   {
      Print("Stochasticハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   h_atr = iATR(_Symbol, PERIOD_M1, atrPeriod);
   if (h_atr == INVALID_HANDLE)
   {
      Print("ATRハンドルの作成に失敗しました。");
      return (INIT_FAILED);
   }

   TrendH1.Init(h_adx, h_emaS, h_emaL);
   TrendM15.Init(h_rsi, h_macd);
   TrendM1.Init(h_bb, h_stoch, h_atr, h_std);

   for (int i = 0; i < CACHE_BARS; i++)
   {
      g_bbUpper[i] = g_bbMiddle[i] = g_bbLower[i] = 0.0;
      g_stochK[i] = g_stochD[i] = 0.0;
      g_atr[i] = 0.0;
      g_superTrend[i] = 0.0;
      g_superTrendDir[i] = 0;
   }

   // 価格・フラグ変数の初期化
   g_closePriceBuy = g_closePriceSell = 0.0;
   g_entryPriceBuy = g_entryPriceSell = 0.0;
   g_canEntryBuy = g_canEntrySell = false;
   g_canCloseBuy = g_canCloseSell = false;
   g_entryThresholdCrossedBuy = g_entryThresholdCrossedSell = false;
   g_closeThresholdCrossedBuy = g_closeThresholdCrossedSell = false;

   // M15 signal 初期化
   g_M15Signal.barTime = 0;
   g_M15Signal.hasDiv = false;
   g_M15Signal.divType = DIVERGENCE_NONE;
   g_M15Signal.hasMACDCross = false;
   g_M15Signal.macdCrossDir = 0;
   g_M15Signal.pendingNextM1 = false;
   g_M15Signal.usedForEntry = false;
   g_M15Signal.usedForClose = false;

   return (INIT_SUCCEEDED);
}

