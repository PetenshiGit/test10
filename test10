bool ModifyPositionSLTP(ulong ticket, double newSL, double newTP)
{
   if (!PositionSelectByTicket(ticket))
      return(false);
   long ptype = PositionGetInteger(POSITION_TYPE);
   double currentSL = PositionGetDouble(POSITION_SL);
   double currentPrice = ptype == POSITION_TYPE_BUY ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   bool sent = trade.PositionModify(ticket, newSL, newTP);
   uint retcode = trade.ResultRetcode();
   if (!sent)
   {
      RecordRequest(REQUEST_SEND_FAILED, retcode);
      PrintFormat("SL更新失敗 ticket=%I64u type=%s currentSL=%.5f newSL=%.5f price=%.5f retcode=%d comment=%s err=%d", ticket, ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", currentSL, newSL, currentPrice, retcode, trade.ResultComment(), GetLastError());
      return (false);
   }
   if (retcode != TRADE_RETCODE_DONE)
   {
      RecordRequest(REQUEST_EXECUTION_FAILED, retcode);
      PrintFormat("SL更新実行失敗 ticket=%I64u type=%s currentSL=%.5f newSL=%.5f price=%.5f retcode=%d comment=%s err=%d", ticket, ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", currentSL, newSL, currentPrice, retcode, trade.ResultComment(), GetLastError());
      return false;
   }
   RecordRequest(REQUEST_EXECUTION_SUCCEEDED, retcode);
   PrintFormat("SL更新成功 ticket=%I64u type=%s currentSL=%.5f newSL=%.5f price=%.5f reason=Trailing Stop retcode=%d comment=%s", ticket, ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", currentSL, newSL, currentPrice, retcode, trade.ResultComment());
   return (true);
}

void UpdateTrailingStops()
{
   if (!EnableStopLoss)
      return;

   double buyNewSL = 0.0;
   double sellNewSL = 0.0;
   if (g_h1AllOk && g_m1AllOk && g_TrendTypeH != TREND_RANGE && g_TrendTypeH != TREND_UNKNOWN && IsIndicatorValueValid(g_superTrend[1]))
   {
      buyNewSL = g_superTrend[1];
      sellNewSL = g_superTrend[1];
   }
   if (buyNewSL <= 0.0 && sellNewSL <= 0.0)
      return;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket) || PositionGetString(POSITION_SYMBOL) != _Symbol || (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      long ptype = PositionGetInteger(POSITION_TYPE);
      double currentSL = PositionGetDouble(POSITION_SL);
      if (ptype == POSITION_TYPE_BUY && g_superTrendDir[1] > 0 && buyNewSL > currentSL && buyNewSL - currentSL >= MinSLUpdatePoints * _Point)
         ModifyPositionSLTP(ticket, buyNewSL, PositionGetDouble(POSITION_TP));
      else if (ptype == POSITION_TYPE_SELL && g_superTrendDir[1] < 0 && (currentSL == 0.0 || sellNewSL < currentSL) && (currentSL == 0.0 || currentSL - sellNewSL >= MinSLUpdatePoints * _Point))
         ModifyPositionSLTP(ticket, sellNewSL, PositionGetDouble(POSITION_TP));
   }
}

datetime ServerDayStart(datetime value)
{
   MqlDateTime parts;
   TimeToStruct(value, parts);
   parts.hour = 0;
   parts.min = 0;
   parts.sec = 0;
   return StructToTime(parts);
}

long SessionSeconds(datetime value)
{
   long seconds = (long)value % 86400;
   if (seconds < 0)
      seconds += 86400;
   return seconds;
}

bool FindWeekendSession(datetime now, datetime &sessionEnd, datetime &nextSessionStart, long &gapSeconds)
{
   datetime today = ServerDayStart(now);
   datetime currentEnd = 0;
   datetime previousSessionEnd = 0;
   datetime candidateNextStart = 0;
   bool hasCurrentSession = false;

   for (int dayOffset = -1; dayOffset <= 8; dayOffset++)
   {
      datetime dayStart = today + dayOffset * 86400;
      MqlDateTime dayParts;
      TimeToStruct(dayStart, dayParts);
      for (uint sessionIndex = 0; ; sessionIndex++)
      {
         datetime from = 0;
         datetime to = 0;
         if (!SymbolInfoSessionTrade(_Symbol, (ENUM_DAY_OF_WEEK)dayParts.day_of_week, sessionIndex, from, to))
            break;

         long fromSeconds = SessionSeconds(from);
         long toSeconds = SessionSeconds(to);
         datetime start = dayStart + fromSeconds;
         datetime end = 0;
         if (fromSeconds == 0 && toSeconds == 0)
            end = start + 86400;
         else
         {
            end = dayStart + toSeconds;
            if (end <= start)
               end += 86400;
         }

         if (end <= now && end > previousSessionEnd)
            previousSessionEnd = end;

         if (now >= start && now < end && (!hasCurrentSession || end < currentEnd))
         {
            currentEnd = end;
            hasCurrentSession = true;
         }
      }
   }

   if (!hasCurrentSession)
      currentEnd = previousSessionEnd;
   if (currentEnd == 0)
      return false;

   for (int dayOffset = -1; dayOffset <= 8; dayOffset++)
   {
      datetime dayStart = today + dayOffset * 86400;
      MqlDateTime dayParts;
      TimeToStruct(dayStart, dayParts);
      for (uint sessionIndex = 0; ; sessionIndex++)
      {
         datetime from = 0;
         datetime to = 0;
         if (!SymbolInfoSessionTrade(_Symbol, (ENUM_DAY_OF_WEEK)dayParts.day_of_week, sessionIndex, from, to))
            break;

         datetime start = dayStart + SessionSeconds(from);
         if (start > currentEnd && (candidateNextStart == 0 || start < candidateNextStart))
            candidateNextStart = start;
      }
   }

   if (candidateNextStart == 0)
      return false;
   sessionEnd = currentEnd;
   nextSessionStart = candidateNextStart;
   gapSeconds = (long)(candidateNextStart - currentEnd);
   return true;
}

void UpdateWeekendSessionSchedule(datetime now)
{
   if (g_weekendTargetValid && now < g_weekendNextSessionStart)
      return;

   datetime sessionEnd = 0;
   datetime nextSessionStart = 0;
   long gapSeconds = 0;
   if (!FindWeekendSession(now, sessionEnd, nextSessionStart, gapSeconds))
      return;

   g_weekendScheduleInitialized = true;

   bool isWeekendTarget = gapSeconds >= 24 * 60 * 60;
   if (!isWeekendTarget)
   {
      g_weekendTargetValid = false;
      return;
   }

   datetime stopTime = sessionEnd - NewEntryStopBeforeClose;
   datetime forceTime = sessionEnd - ForceCloseBeforeClose;
   bool changed = !g_weekendTargetValid || g_weekendSessionEnd != sessionEnd || g_weekendNextSessionStart != nextSessionStart;
   g_weekendTargetValid = true;
   g_weekendSessionEnd = sessionEnd;
   g_weekendNextSessionStart = nextSessionStart;
   g_weekendEntryStopTime = stopTime;
   g_weekendForceCloseTime = forceTime;
   if (changed)
   {
      PrintFormat("週末休場判定：対象 現在セッション終了=%s 次回セッション開始=%s 休場時間=%I64d秒 24時間以上=true 新規発注停止=%s 強制決済=%s",
                  TimeToString(sessionEnd, TIME_DATE | TIME_SECONDS), TimeToString(nextSessionStart, TIME_DATE | TIME_SECONDS), gapSeconds,
                  TimeToString(stopTime, TIME_DATE | TIME_SECONDS), TimeToString(forceTime, TIME_DATE | TIME_SECONDS));
   }
}

void ForceCloseWeekendPositions()
{
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol || (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      ClosePositionByTicket(ticket, "週末休場前の強制決済");
   }
}

void ProcessWeekendSession(datetime now, bool refreshSchedule)
{
   if (g_weekendTargetValid && now >= g_weekendNextSessionStart)
   {
      g_weekendTargetValid = false;
      g_weekendEntryStopped = false;
      g_weekendForceCloseActive = false;
      PrintFormat("週末停止解除：次回セッション開始=%s", TimeToString(now, TIME_DATE | TIME_SECONDS));
      UpdateWeekendSessionSchedule(now);
   }

   if (refreshSchedule || !g_weekendScheduleInitialized)
      UpdateWeekendSessionSchedule(now);
   if (!g_weekendTargetValid)
      return;

   if (now >= g_weekendEntryStopTime && !g_weekendEntryStopped)
   {
      g_weekendEntryStopped = true;
      PrintFormat("週末新規発注停止：時刻=%s", TimeToString(now, TIME_DATE | TIME_SECONDS));
   }
   if (now >= g_weekendForceCloseTime && !g_weekendForceCloseActive)
   {
      g_weekendEntryStopped = true;
      g_weekendForceCloseActive = true;
      PrintFormat("週末強制全決済開始：時刻=%s", TimeToString(now, TIME_DATE | TIME_SECONDS));
      ForceCloseWeekendPositions();
   }
}

