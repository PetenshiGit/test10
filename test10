}

void LogAnalysisFlagTransitionAt(const string flagName, bool wasEnabled, bool isEnabled,
                                 const string reason, datetime eventTime, long eventTimeMsc)
{
   if (!EnableAnalysisCsv || wasEnabled == isEnabled || eventTime <= 0)
      return;
   SAnalysisRecord analysis;
   ResetAnalysisRecord(analysis, isEnabled ? "FLAG_ON" : "FLAG_OFF");
   SetAnalysisContext(analysis, eventTime, eventTimeMsc);
   analysis.values[AC_REASON] = flagName;
   analysis.values[AC_REASON_DETAIL] = reason;
   WriteAnalysisRecord(analysis);
}

void LogAnalysisFlagTransition(const string flagName, bool wasEnabled, bool isEnabled,
                               const string reason)
{
   if (!EnableAnalysisCsv || wasEnabled == isEnabled)
      return;
   if (g_currentAnalysisEventTime <= 0 || g_currentAnalysisEventTimeMsc <= 0)
      return;
   LogAnalysisFlagTransitionAt(flagName, wasEnabled, isEnabled, reason,
                               g_currentAnalysisEventTime, g_currentAnalysisEventTimeMsc);
}

void SetAnalysisFlag(bool &flag, const string flagName, bool isEnabled, const string reason)
{
   bool wasEnabled = flag;
   flag = isEnabled;
   if (EnableAnalysisCsv)
      LogAnalysisFlagTransition(flagName, wasEnabled, isEnabled, reason);
}

