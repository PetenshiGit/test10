void OnDeinit(const int reason)
{
   switch (reason)
   {
      case REASON_REMOVE:
         Print("EAを手動で終了しました。");
         break;
      case REASON_CHARTCHANGE:
      case REASON_CHARTCLOSE:
      case REASON_PARAMETERS:
      case REASON_ACCOUNT:
      case REASON_TEMPLATE:
