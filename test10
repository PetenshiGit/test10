//| Timer function                                                   |
//+------------------------------------------------------------------+
void OnTimer()
{
    datetime bH1 = iTime(_Symbol, PERIOD_H1, 0);
    datetime bM15 = iTime(_Symbol, PERIOD_M15, 0);
    datetime bM1 = iTime(_Symbol, PERIOD_M1, 0);

    // H1 更新判定
    if (bH1 != LastH1)
    {
        ResetH1Data();
        if (TrendH1.Calculate())
        {
            g_TrendTypeH = TrendH1.getType();
            g_TrendStateH = TrendH1.getState();
            g_TrendValueH = TrendH1.getValue();
            PrintFormat("OnTimer: 1時間足更新ができた 時刻=%s ADX=%.3f Type=%s State=%s",
                        TimeToString(bH1, TIME_DATE | TIME_SECONDS), g_TrendValueH, TrendTypeToString(g_TrendTypeH), TrendStateToString(g_TrendStateH));
            LastH1 = bH1;
        }
        else
        {
            g_TrendTypeH = TREND_UNKNOWN;
            PrintFormat("OnTimer: 1時間足更新ができなかった 時刻=%s", TimeToString(bH1, TIME_DATE | TIME_SECONDS));
        }
    }

   // M15 更新判定（ダイバージェンスとMACDクロス判定）
   if (bM15 != LastM15)
   {
      ResetM15Data();
      if (TrendM15.Calculate(g_TrendTypeH, bM15))
      {
         LastM15 = bM15;
         PrintFormat("OnTimer: 15分足更新ができた 時刻=%s", TimeToString(bM15, TIME_DATE | TIME_SECONDS));
      }
      else
      {
         g_m15AllOk = false;
         PrintFormat("OnTimer: 15分足更新ができなかった 時刻=%s", TimeToString(bM15, TIME_DATE | TIME_SECONDS));
      }
   }

   // M15 シグナルの有効期限管理
   if (g_M15Signal.pendingNextM1 && bM1 != LastM1 && TimeCurrent() >= g_M15Signal.expireM1BarTime)
   {
      g_M15Signal.pendingNextM1 = false;
   }

   // M1 更新判定（指標を取得してグローバルに保存）
   if (bM1 != LastM1)
   {
      ResetM1Data();
      if (TrendM1.Calculate())
      {
         TrendM1.ComputeEntryExit(g_TrendTypeH);
         LastM1 = bM1;
         PrintFormat("OnTimer: 1分足更新ができた 時刻=%s", TimeToString(bM1, TIME_DATE | TIME_SECONDS));
      }
      else
      {
         g_m1AllOk = false;
         PrintFormat("OnTimer: 1分足更新ができなかった 時刻=%s", TimeToString(bM1, TIME_DATE | TIME_SECONDS));
      }
   }
}
