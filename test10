input int SL_Points                 = 40;    // 逆指値（StopLoss）の最低幅（Points）（ATRによるSL幅がこの値より小さい場合は、この値を使用する）
input int MinSLUpdatePoints         = 1;     // SL更新を実行する際の最低価格差（Points）（現在のSLと新しいSLの差がこの値未満の場合はSLを更新しない）
input double RiskRewardRatio        = 2.0;   // リスク・リワード比率（TP幅をSL幅の何倍にするか）（現在のレンジTP計算では使用しない）
input bool EnableStochasticClose    = true;  // Stochasticによる決済を有効/無効（トレンド・レンジ時の両方で同じ判定を使用する）
input bool EnableRangeTP            = true;  // レンジ時の反対側BB外側バンドTPを有効化。
                                              // TP価格はエントリー約定時点のM1 BB外側バンド値で固定する。
                                              // エントリー後にBBが移動してもTP価格は変更しない。
input int RangeMinProfitPoints      = 5;     // レンジ時の最低利益確保幅（Points）。
                                              // BUYはBIDがエントリー価格＋この値を上回った時点で、
                                              // SLをエントリー価格＋この値へ1回だけ移動する。
                                              // SELLはASKがエントリー価格－この値を下回った時点で、
                                              // SLをエントリー価格－この値へ1回だけ移動する。
                                              // このレンジ利益確保SLは、1ポジションにつき最大1回だけ更新する。
                                              // その後さらに利益が増えても、この方式ではSLを再更新しない。
input bool EnableEntryOnCloseSignal = true;  // 決済シグナルと新規エントリーシグナルが同時成立した場合にエントリーを許可
input bool EnableTrendTrading       = true;  // H1トレンド判定時の新規エントリーの許可
input bool EnableRangeTrading       = true;  // H1レンジ判定時の新規エントリーの許可
input double atr2MinExtensionSeconds = 0.0;  // 2ATR特殊エントリーの時間条件（秒）。今回は0秒で実質常時成立。

