   EventKillTimer();
   Comment("");
   PrintFormat("終了時の保有ポジション数: %d", PositionsTotal());
}

// ===================================================================
// ヘルパー関数: 決済処理
// グローバル変数 g_canCloseBuy/Sell, g_closeThresholdCrossedBuy/Sell を使用
// ===================================================================
void ClosePositions(bool canClose, ENUM_POSITION_TYPE posType, double closePrice, double currentPrice)
{
   if (!canClose || closePrice <= 0)
      return;

   bool isBuy = (posType == POSITION_TYPE_BUY);
   
   // ブレイク後リトレース判定
   bool condition;
   
   if (isBuy)
   {
      bool thresholdCrossed = g_closeThresholdCrossedBuy;
      if (!thresholdCrossed)
      {
         // 1回目の閾値チェック
         if (currentPrice <= closePrice)
         {
            thresholdCrossed = true;  // 閾値を超えたことを記録
         }
         condition = false;  // まだ戻りまでは決済しない
      }
      else
      {
         // 既に閾値を超えている＝戻り確認後に決済
         condition = (currentPrice > closePrice);
      }
   }
   else
   {
      bool thresholdCrossed = g_closeThresholdCrossedSell;
      if (!thresholdCrossed)
      {
         // 1回目の閾値チェック
         if (currentPrice >= closePrice)
         {
            thresholdCrossed = true;  // 閾値を超えたことを記録
         }
         condition = false;  // まだ戻りまでは決済しない
      }
      else
      {
         // 既に閾値を超えている＝戻り確認後に決済
         condition = (currentPrice < closePrice);
      }
   }

   if (!condition)
      return;

   int count = isBuy ? BuyCount : SellCount;
   if (count <= 0)
      return;

   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      if (PositionGetInteger(POSITION_TYPE) != posType)
         continue;

      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double volume = PositionGetDouble(POSITION_VOLUME);
      double exitPrice = currentPrice;
      double profit = isBuy ? (exitPrice - openPrice) * volume : (openPrice - exitPrice) * volume;
      if (ClosePositionByTicket(ticket))
      {
         PrintFormat("OnTick: %s 決済 ticket=%I64u entry=%.5f exit=%.5f profit=%.5f",
                     isBuy ? "BUY" : "SELL", ticket, openPrice, exitPrice, profit);
         if (g_M15Signal.pendingNextM1 && !g_M15Signal.usedForClose)
         {
            g_M15Signal.usedForClose = true;
            g_M15Signal.pendingNextM1 = false;
            Print("OnTick: M15 シグナル（決済）を適用しました。");
         }
      }
   }
}

// ===================================================================
// ヘルパー関数: エントリー処理
// グローバル変数 g_canEntryBuy/Sell, g_entryThresholdCrossedBuy/Sell を使用
// ===================================================================
void EnterPosition(bool canEntry, ENUM_POSITION_TYPE posType, double entryPrice, double currentPrice, double ask, double bid)
{
   if (!canEntry || entryPrice <= 0)
      return;

   bool isBuy = (posType == POSITION_TYPE_BUY);
   bool condition;

   if (isBuy)
   {
      bool thresholdCrossed = g_entryThresholdCrossedBuy;
      // エントリ閾値は一度超えた（ブレイク）後に戻ってきた場合にのみ有効にする
      if (!thresholdCrossed)
      {
         // まだ閾値を超えていなければ、超えたことを記録するのみ
         if (ask > entryPrice)
            thresholdCrossed = true;
         condition = false; // 超えるまではエントリさせない
      }
      else
      {
         // 既に閾値を超えている場合、戻ってきたらエントリ
         condition = (ask <= entryPrice);
      }
   }
   else
   {
      bool thresholdCrossed = g_entryThresholdCrossedSell;
      // SELL側も同様に、まず閾値を超えたことを確認してから、戻りでエントリ
      if (!thresholdCrossed)
      {
         if (bid < entryPrice)
            thresholdCrossed = true;
         condition = false;
      }
      else
      {
         condition = (bid >= entryPrice);
      }
   }

   if (!condition)
      return;

   double price = currentPrice;
   double sl = isBuy ? (price - SL_Points * _Point) : (price + SL_Points * _Point);
   double tp = 0.0;
   if (g_TrendTypeH == TREND_RANGE || g_TrendTypeH == TREND_UNKNOWN)
      tp = isBuy ? (price + SL_Points * RiskRewardRatio * _Point) : (price - SL_Points * RiskRewardRatio * _Point);
   double lot = 1.0;

   double vol_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double vol_min = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   if (vol_step <= 0)
      vol_step = 0.01;
   if (vol_min <= 0)
      vol_min = vol_step;

   // ロット計算: トレンド時=1.0, 追撃(chase)=0.7, レンジ=0.5 に BaseLot を掛ける
   double lotMultiplier = 1.0;
   if (g_TrendTypeH == TREND_RANGE || g_TrendTypeH == TREND_UNKNOWN)
      lotMultiplier = 0.5; // レンジ
   else
   {
      // トレンド時。M15 シグナルがあり未使用なら追撃倍率を適用
      if (g_M15Signal.pendingNextM1 && !g_M15Signal.usedForEntry)
         lotMultiplier = 0.7; // 追撃
      else
         lotMultiplier = 1.0; // 通常トレンド
   }
   lot = BaseLot * lotMultiplier;

   // OnTimer で決めた倍率（例えばM15での強調）を適用
   if (g_M15Signal.pendingNextM1 && !g_M15Signal.usedForEntry && g_M15LotMultiplier != 1.0)
   {
      lot = MathMin(lot * g_M15LotMultiplier, MaxLot);
      g_M15Signal.usedForEntry = true;
      // pendingNextM1 は OnTimer と OnTick の協調で管理するためここでは変更しない
      PrintFormat("OnTick: M15 シグナルを初回エントリに適用しました。倍率=%.2f", g_M15LotMultiplier);
   }

   // 発注量をシンボルのステップに合わせる（丸め）
   double steps = MathRound(lot / vol_step);
   lot = MathMax(vol_min, steps * vol_step);

   if (lot > 0)
   {
      ENUM_ORDER_TYPE orderType = isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
      if (SendMarketOrder(orderType, lot, sl, tp, false))
         PrintFormat("OnTick: 条件達成により %s を発注しました。", isBuy ? "BUY" : "SELL");
   }
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   double ASK = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double BID = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ASK - BID) / _Point;
   PrintFormat("OnTick: ASK=%.5f BID=%.5f スプレッド(pips)=%.1f", ASK, BID, spreadPts);

   if (ASK <= 0 || BID <= 0)
   {
      Print("価格データが無効のため処理を中断します。");
      return;
   }

   // BuyCount/SellCount の判定をg_closePrice 判定より前に移動
   NowPositions = 0;
   BuyCount = 0;
   SellCount = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      NowPositions++;
      if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
         BuyCount++;
      else if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL)
         SellCount++;
   }

   // 決済処理
   ClosePositions(g_canCloseBuy, POSITION_TYPE_BUY, g_closePriceBuy, ASK);
   ClosePositions(g_canCloseSell, POSITION_TYPE_SELL, g_closePriceSell, BID);

   // 決済後にスプレッド閾値チェック（スプレッドが大きければエントリを中止）
   if (spreadPts >= MaxAllowedSpread)
   {
      Print("スプレッドが閾値を超えたため処理を中断します。");
      return;
   }

   // エントリ判定は OnTimer で算出した価格・フラグを使用
   EnterPosition(g_canEntryBuy, POSITION_TYPE_BUY, g_entryPriceBuy, ASK, ASK, BID);
   EnterPosition(g_canEntrySell, POSITION_TYPE_SELL, g_entryPriceSell, BID, ASK, BID);
}

//+------------------------------------------------------------------+
//| Trade function                                                   |
//+------------------------------------------------------------------+
void OnTrade()
{
   TotalPositions = PositionsTotal();
   NowPositions = 0;
   BuyCount = 0;
   SellCount = 0;
   for (int i = 0; i < TotalPositions; i++)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      NowPositions++;
      if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
         BuyCount++;
      else
         SellCount++;
   }
   PrintFormat("OnTrade: ポジション数更新 buy=%d sell=%d total=%d", BuyCount, SellCount, NowPositions);
}

