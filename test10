//--- トレンド・相場状態
enum TrendType
{
   TREND_STRONG_UP,     // 強い上昇トレンド（ADXとDI方向で分類）
   TREND_WEAK_UP,       // 弱い上昇トレンド（ADXとDI方向で分類）
   TREND_STRONG_DOWN,   // 強い下降トレンド（ADXとDI方向で分類）
   TREND_WEAK_DOWN,     // 弱い下降トレンド（ADXとDI方向で分類）
   TREND_DIRECTION_UNKNOWN, // ADXはトレンド域だが方向不明
   TREND_RANGE,         // レンジ相場
   TREND_UNKNOWN        // 相場不明
};

//--- トレンドの状態（成長/減速等）
enum TrendState
{
   TREND_ACCELERATE,       // トレンド加速
   TREND_DECELERATE,       // トレンド減速
   TREND_REACCELERATE,     // トレンド再加速
   TREND_RECOVERY_MAINTAIN,// トレンド回復維持
   TREND_STALL_MAINTAIN,   // トレンド失速維持
   TREND_MAINTAIN,         // トレンド維持
   RANGE_MAINTAIN,         // レンジ維持
   RANGE_TO_TREND,         // レンジ⇒トレンド移行 （強弱問わず）
   TREND_TO_RANGE,         // トレンド⇒レンジ移行
   STATE_UNKNOWN           // 判定不能
};

//--- ダイバージェンス判定用enum
enum EntrySignalType
{
   ENTRY_SIGNAL_NONE,               // なし
   ENTRY_SIGNAL_REACCEL,            // 押し目→再加速
   ENTRY_SIGNAL_INITIAL_BREAKOUT,   // 初動ブレイク
   ENTRY_SIGNAL_CONTINUATION,       // トレンド継続
   ENTRY_SIGNAL_ATR2_EXTENSION      // 2ATR超過連続Tickによる特殊エントリー
};

enum DivergenceType
{
   DIVERGENCE_NONE,     // ダイバージェンスなし
   DIVERGENCE_BULLISH,  // 強気（ブル）ダイバージェンス （価格が下降/指標が上昇）
   DIVERGENCE_BEARISH,  // 弱気（ベア）ダイバージェンス （価格が上昇/指標が下降）
   DIVERGENCE_CONFLICT  // 強気・弱気両方同時発生
};

bool IsDirectionalTrendType(TrendType type)
{
   return type == TREND_STRONG_UP || type == TREND_WEAK_UP ||
          type == TREND_STRONG_DOWN || type == TREND_WEAK_DOWN;
}

