void LogPositionSummary(string action, datetime eventTime = 0, long eventTimeMsc = 0)
{
   if (!EnableAnalysisCsv)
      return;
   int buy = 0, sell = 0, total = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket) || PositionGetString(POSITION_SYMBOL) != _Symbol || (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      total++;
      if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
         buy++;
      else if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL)
         sell++;
   }
   SAnalysisRecord analysis;
   ResetAnalysisRecord(analysis, "POSITION_SUMMARY");
   if (eventTime > 0)
      SetAnalysisContext(analysis, eventTime, eventTimeMsc);
   else
      SetAnalysisContext(analysis, TimeCurrent(), AnalysisCurrentTimeMsc());
   analysis.values[AC_REASON] = action;
   analysis.values[AC_REASON_DETAIL] = "BUY=" + IntegerToString(buy) + ";SELL=" + IntegerToString(sell) + ";TOTAL=" + IntegerToString(total);
   analysis.values[AC_SAME_DIRECTION_COUNT] = IntegerToString(total);
   WriteAnalysisRecord(analysis);
}

string DealReasonToString(long reason)
{
   if (reason == DEAL_REASON_EXPERT)
      return "EA/Expert";
   if (reason == DEAL_REASON_SL)
      return "Stop Loss";
   if (reason == DEAL_REASON_TP)
      return "Take Profit";
   return "Other/Unknown";
}

bool SaveEntryLogRecord(ulong positionId, ulong inDeal, datetime inTime, long inTimeMsc,
                        double inPrice, double inVolume, long positionType)
{
   int size = ArraySize(g_entryLogRecords);
   if (ArrayResize(g_entryLogRecords, size + 1) != size + 1)
   {
      PrintFormat("IN Deal情報保持失敗 position=%I64u deal=%I64u error=%d",
                  positionId, inDeal, GetLastError());
      return false;
   }
   g_entryLogRecords[size].positionId = positionId;
   g_entryLogRecords[size].inDeal = inDeal;
   g_entryLogRecords[size].inTime = inTime;
   g_entryLogRecords[size].inTimeMsc = inTimeMsc;
   g_entryLogRecords[size].inPrice = inPrice;
   g_entryLogRecords[size].inVolume = inVolume;
   g_entryLogRecords[size].positionType = positionType;
   return true;
}

bool FindEntryLogRecord(ulong positionId, datetime &inTime, long &inTimeMsc)
{
   for (int i = ArraySize(g_entryLogRecords) - 1; i >= 0; i--)
   {
      if (g_entryLogRecords[i].positionId == positionId)
      {
         inTime = g_entryLogRecords[i].inTime;
         inTimeMsc = g_entryLogRecords[i].inTimeMsc;
         return true;
      }
   }
   return false;
}

bool FindEntryAveragePrice(ulong positionId, long positionType, double &averagePrice)
{
   double weightedPrice = 0.0;
   double totalVolume = 0.0;
   for (int i = 0; i < ArraySize(g_entryLogRecords); i++)
   {
      if (g_entryLogRecords[i].positionId != positionId ||
          g_entryLogRecords[i].positionType != positionType ||
          g_entryLogRecords[i].inVolume <= 0.0)
         continue;
      weightedPrice += g_entryLogRecords[i].inPrice * g_entryLogRecords[i].inVolume;
      totalVolume += g_entryLogRecords[i].inVolume;
   }
   if (totalVolume <= 0.0)
      return false;
   averagePrice = weightedPrice / totalVolume;
   return true;
}

bool GetPositionStateBeforeDeal(ulong positionId, ulong currentDeal, long currentDealTimeMsc,
                                double &positionVolume, long &positionType)
{
   positionVolume = 0.0;
   positionType = -1;
   if (positionId == 0 || currentDeal == 0 || !HistorySelectByPosition(positionId))
      return false;

   double signedVolume = 0.0;
   for (int i = 0; i < HistoryDealsTotal(); i++)
   {
      ulong priorDeal = HistoryDealGetTicket(i);
      if (priorDeal == 0 || priorDeal == currentDeal)
         continue;
      long priorTimeMsc = HistoryDealGetInteger(priorDeal, DEAL_TIME_MSC);
      if (priorTimeMsc > currentDealTimeMsc ||
          (priorTimeMsc == currentDealTimeMsc && priorDeal > currentDeal))
         continue;
      long priorType = HistoryDealGetInteger(priorDeal, DEAL_TYPE);
      if (priorType != DEAL_TYPE_BUY && priorType != DEAL_TYPE_SELL)
         continue;
      double priorVolume = HistoryDealGetDouble(priorDeal, DEAL_VOLUME);
      signedVolume += priorType == DEAL_TYPE_BUY ? priorVolume : -priorVolume;
   }
   if (MathAbs(signedVolume) <= 0.0)
      return false;

   positionVolume = MathAbs(signedVolume);
   positionType = signedVolume > 0.0 ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;
   return true;
}

bool IsTradeDealQueuedOrProcessed(ulong deal)
{
   for (int i = 0; i < ArraySize(g_pendingTradeEvents); i++)
      if (g_pendingTradeEvents[i].deal == deal)
         return true;
   for (int i = 0; i < ArraySize(g_processedTradeDeals); i++)
      if (g_processedTradeDeals[i] == deal)
         return true;
   return false;
}

bool IsTradeDealProcessed(ulong deal)
{
   for (int i = 0; i < ArraySize(g_processedTradeDeals); i++)
      if (g_processedTradeDeals[i] == deal)
         return true;
   return false;
}

void QueueTradeEvent(ulong deal, ulong order, ulong position)
{
   if (!EnableAnalysisCsv)
      return;
   if (deal == 0 || IsTradeDealQueuedOrProcessed(deal))
      return;
   int size = ArraySize(g_pendingTradeEvents);
   if (ArrayResize(g_pendingTradeEvents, size + 1) != size + 1)
   {
      PrintFormat("取引Dealイベントをキューに追加できません。deal=%I64u order=%I64u position=%I64u error=%d",
                  deal, order, position, GetLastError());
      return;
   }
   g_pendingTradeEvents[size].deal = deal;
   g_pendingTradeEvents[size].order = order;
   g_pendingTradeEvents[size].position = position;
   g_pendingTradeEvents[size].detailedWritten = false;
   g_pendingTradeEvents[size].lightWritten = false;
   g_pendingTradeEvents[size].lightAttempted = false;
   g_pendingTradeEvents[size].reversalExitDetailedWritten = false;
   g_pendingTradeEvents[size].reversalEntryDetailedWritten = false;
   g_pendingTradeEvents[size].reversalExitLightAttempted = false;
   g_pendingTradeEvents[size].reversalExitLightWritten = false;
   g_pendingTradeEvents[size].reversalEntryLightAttempted = false;
   g_pendingTradeEvents[size].reversalEntryLightWritten = false;
}

void RemovePendingTradeEvent(int index)
{
   int size = ArraySize(g_pendingTradeEvents);
   for (int i = index; i < size - 1; i++)
   {
      g_pendingTradeEvents[i].deal = g_pendingTradeEvents[i + 1].deal;
      g_pendingTradeEvents[i].order = g_pendingTradeEvents[i + 1].order;
      g_pendingTradeEvents[i].position = g_pendingTradeEvents[i + 1].position;
      g_pendingTradeEvents[i].detailedWritten = g_pendingTradeEvents[i + 1].detailedWritten;
      g_pendingTradeEvents[i].lightWritten = g_pendingTradeEvents[i + 1].lightWritten;
      g_pendingTradeEvents[i].lightAttempted = g_pendingTradeEvents[i + 1].lightAttempted;
      g_pendingTradeEvents[i].reversalExitDetailedWritten = g_pendingTradeEvents[i + 1].reversalExitDetailedWritten;
      g_pendingTradeEvents[i].reversalEntryDetailedWritten = g_pendingTradeEvents[i + 1].reversalEntryDetailedWritten;
      g_pendingTradeEvents[i].reversalExitLightAttempted = g_pendingTradeEvents[i + 1].reversalExitLightAttempted;
      g_pendingTradeEvents[i].reversalExitLightWritten = g_pendingTradeEvents[i + 1].reversalExitLightWritten;
      g_pendingTradeEvents[i].reversalEntryLightAttempted = g_pendingTradeEvents[i + 1].reversalEntryLightAttempted;
      g_pendingTradeEvents[i].reversalEntryLightWritten = g_pendingTradeEvents[i + 1].reversalEntryLightWritten;
   }
   ArrayResize(g_pendingTradeEvents, size - 1);
}

int ProcessPendingTradeEvents()
{
   if (!EnableAnalysisCsv)
      return 0;
   int processedCount = 0;
   int index = 0;
   while (index < ArraySize(g_pendingTradeEvents))
   {
      ulong deal = g_pendingTradeEvents[index].deal;
      ulong fallbackOrder = g_pendingTradeEvents[index].order;
      ulong fallbackPosition = g_pendingTradeEvents[index].position;
      if (IsTradeDealProcessed(deal))
      {
         RemovePendingTradeEvent(index);
         continue;
      }

      ResetLastError();
      if (!HistoryDealSelect(deal))
      {
         PrintFormat("保留Deal情報取得失敗。後続OnTimerで再試行します。deal=%I64u error=%d",
                     deal, GetLastError());
         index++;
         continue;
      }

      string symbol = HistoryDealGetString(deal, DEAL_SYMBOL);
      long magic = HistoryDealGetInteger(deal, DEAL_MAGIC);
      if (symbol != _Symbol || magic != MagicNumber)
      {
         RemovePendingTradeEvent(index);
         continue;
      }

      long dealType = HistoryDealGetInteger(deal, DEAL_TYPE);
      long dealEntry = HistoryDealGetInteger(deal, DEAL_ENTRY);
      long dealReason = HistoryDealGetInteger(deal, DEAL_REASON);
      long dealTimeMsc = HistoryDealGetInteger(deal, DEAL_TIME_MSC);
      datetime dealTime = (datetime)HistoryDealGetInteger(deal, DEAL_TIME);
      ulong order = (ulong)HistoryDealGetInteger(deal, DEAL_ORDER);
      ulong positionId = (ulong)HistoryDealGetInteger(deal, DEAL_POSITION_ID);
      double price = HistoryDealGetDouble(deal, DEAL_PRICE);
      double volume = HistoryDealGetDouble(deal, DEAL_VOLUME);
      double requestedPrice = 0.0;
      double orderVolume = 0.0;
      double orderSL = 0.0;
      double orderTP = 0.0;
      if (order == 0)
         order = fallbackOrder;
      if (positionId == 0)
         positionId = fallbackPosition;
      if (order > 0 && HistoryOrderSelect(order))
      {
         requestedPrice = HistoryOrderGetDouble(order, ORDER_PRICE_OPEN);
         orderVolume = HistoryOrderGetDouble(order, ORDER_VOLUME_INITIAL);
         orderSL = HistoryOrderGetDouble(order, ORDER_SL);
         orderTP = HistoryOrderGetDouble(order, ORDER_TP);
      }

      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "DEAL");
      SetAnalysisContext(analysis, dealTime, dealTimeMsc);
      analysis.values[AC_SYMBOL] = symbol;
      analysis.values[AC_ORDER] = AnalysisLong((long)order);
      analysis.values[AC_DEAL] = AnalysisLong((long)deal);
      analysis.values[AC_POSITION] = AnalysisLong((long)positionId);
      analysis.values[AC_PRICE] = AnalysisNumber(price, _Digits);
      analysis.values[AC_EXECUTION_PRICE] = AnalysisNumber(price, _Digits);
      analysis.values[AC_LOT] = AnalysisNumber(volume, 2);
      if (orderVolume > 0.0)
         analysis.values[AC_ORDER_VOLUME] = AnalysisNumber(orderVolume, 2);
      analysis.values[AC_DEAL_VOLUME] = AnalysisNumber(volume, 2);
      if (dealReason != DEAL_REASON_SL && dealReason != DEAL_REASON_TP && requestedPrice > 0.0)
         analysis.values[AC_REQUESTED_PRICE] = AnalysisNumber(requestedPrice, _Digits);
      if (orderSL > 0.0)
         analysis.values[AC_SL] = AnalysisNumber(orderSL, _Digits);
      if (orderTP > 0.0)
         analysis.values[AC_TP] = AnalysisNumber(orderTP, _Digits);
      analysis.values[AC_DEAL_REASON] = EnumToString((ENUM_DEAL_REASON)dealReason);
      analysis.values[AC_DEAL_PROFIT] = AnalysisNumber(HistoryDealGetDouble(deal, DEAL_PROFIT), 2);
      analysis.values[AC_DEAL_COMMISSION] = AnalysisNumber(HistoryDealGetDouble(deal, DEAL_COMMISSION), 2);
      analysis.values[AC_DEAL_SWAP] = AnalysisNumber(HistoryDealGetDouble(deal, DEAL_SWAP), 2);
      analysis.values[AC_DEAL_FEE] = AnalysisNumber(HistoryDealGetDouble(deal, DEAL_FEE), 2);
      analysis.values[AC_REASON_DETAIL] = DealReasonToString(dealReason);
      analysis.values[AC_MAGIC_NUMBER] = AnalysisLong(magic);

      bool isReversal = dealEntry == DEAL_ENTRY_INOUT;
      bool isEntry = dealEntry == DEAL_ENTRY_IN || isReversal;
      bool isExit = dealEntry == DEAL_ENTRY_OUT || dealEntry == DEAL_ENTRY_OUT_BY || isReversal;
      long newPositionType = dealType == DEAL_TYPE_BUY ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;
      long positionType = isExit && !isReversal
         ? (dealType == DEAL_TYPE_SELL ? POSITION_TYPE_BUY : POSITION_TYPE_SELL)
         : newPositionType;
      double reversalExitVolume = 0.0;
      double reversalEntryVolume = 0.0;
      if (isReversal)
      {
         double preDealPositionVolume = 0.0;
         long preDealPositionType = -1;
         if (!GetPositionStateBeforeDeal(positionId, deal, dealTimeMsc,
                                         preDealPositionVolume, preDealPositionType))
         {
            PrintFormat("反転Deal直前のポジション状態を復元できません。後続OnTimerで再試行します。deal=%I64u position=%I64u",
                        deal, positionId);
            index++;
            continue;
         }
         positionType = preDealPositionType;
         reversalExitVolume = MathMin(preDealPositionVolume, volume);
         reversalEntryVolume = MathMax(0.0, volume - reversalExitVolume);
      }

      analysis.values[AC_DIRECTION] = positionType == POSITION_TYPE_BUY ? "BUY" : "SELL";
      analysis.values[AC_REASON] =
         dealEntry == DEAL_ENTRY_IN ? "IN" :
         dealEntry == DEAL_ENTRY_OUT ? "OUT" :
         dealEntry == DEAL_ENTRY_INOUT ? "INOUT" :
         dealEntry == DEAL_ENTRY_OUT_BY ? "OUT_BY" : "OTHER";

      datetime inTime = 0;
      long inTimeMsc = 0;
      if (isEntry)
      {
         SLightEntrySnapshot entrySnapshot;
         if (order > 0 && FindLightEntrySnapshotByOrder(order, entrySnapshot))
         {
            requestedPrice = entrySnapshot.requestedPrice;
            orderVolume = entrySnapshot.orderVolume;
            orderSL = entrySnapshot.sl;
            orderTP = entrySnapshot.tp;
            analysis.values[AC_ORDER_VOLUME] = AnalysisNumber(orderVolume, 2);
            analysis.values[AC_REQUESTED_PRICE] = AnalysisNumber(requestedPrice, _Digits);
            analysis.values[AC_SL] = AnalysisNumber(orderSL, _Digits);
            analysis.values[AC_TP] = AnalysisNumber(orderTP, _Digits);
         }
         analysis.values[AC_ENTRY_PRICE] = AnalysisNumber(price, _Digits);
      }
      if (isExit)
      {
         SLightExitSnapshot exitSnapshot;
         if (order > 0 && FindLightExitSnapshotByOrder(order, exitSnapshot))
         {
            requestedPrice = exitSnapshot.requestedPrice;
            orderVolume = exitSnapshot.orderVolume;
            analysis.values[AC_ORDER_VOLUME] = AnalysisNumber(orderVolume, 2);
            if (dealReason != DEAL_REASON_SL && dealReason != DEAL_REASON_TP && requestedPrice > 0.0)
               analysis.values[AC_REQUESTED_PRICE] = AnalysisNumber(requestedPrice, _Digits);
            else
               analysis.values[AC_REQUESTED_PRICE] = "";
         }
         analysis.values[AC_EXIT_PRICE] = AnalysisNumber(price, _Digits);
         double averageEntryPrice = 0.0;
         if (FindEntryAveragePrice(positionId, positionType, averageEntryPrice))
         {
            analysis.values[AC_ENTRY_PRICE] = AnalysisNumber(averageEntryPrice, _Digits);
            double difference = positionType == POSITION_TYPE_BUY
               ? price - averageEntryPrice
               : averageEntryPrice - price;
            analysis.values[AC_PRICE_DIFFERENCE] = AnalysisNumber(difference, _Digits);
            analysis.values[AC_REASON_DETAIL] += ";per-Deal price difference;not aggregated across partial exits";
         }
         else
         {
            analysis.values[AC_REASON_DETAIL] += ";entry price unavailable;price difference omitted";
         }
         if ((dealEntry == DEAL_ENTRY_OUT || dealEntry == DEAL_ENTRY_OUT_BY || dealEntry == DEAL_ENTRY_INOUT) &&
             FindEntryLogRecord(positionId, inTime, inTimeMsc) &&
             dealTimeMsc >= inTimeMsc)
            analysis.values[AC_ELAPSED_SECONDS] = AnalysisNumber((dealTimeMsc - inTimeMsc) / 1000.0, 1);
      }

      int processedSize = ArraySize(g_processedTradeDeals);
      if (ArrayResize(g_processedTradeDeals, processedSize + 1) != processedSize + 1)
      {
         PrintFormat("処理済みDeal識別子を保持できません。deal=%I64u error=%d",
                     deal, GetLastError());
         index++;
         continue;
      }
      bool detailedReady = true;
      if (isReversal)
      {
         SAnalysisRecord exitAnalysis = analysis;
         exitAnalysis.values[AC_REASON] = "INOUT_EXIT";
         exitAnalysis.values[AC_DIRECTION] = positionType == POSITION_TYPE_BUY ? "BUY" : "SELL";
         exitAnalysis.values[AC_LOT] = AnalysisNumber(reversalExitVolume, 2);
         exitAnalysis.values[AC_DEAL_VOLUME] = AnalysisNumber(reversalExitVolume, 2);

         SAnalysisRecord entryAnalysis = analysis;
         entryAnalysis.values[AC_REASON] = "INOUT_ENTRY";
         entryAnalysis.values[AC_DIRECTION] = newPositionType == POSITION_TYPE_BUY ? "BUY" : "SELL";
         entryAnalysis.values[AC_ENTRY_PRICE] = AnalysisNumber(price, _Digits);
         entryAnalysis.values[AC_EXIT_PRICE] = "";
         entryAnalysis.values[AC_PRICE_DIFFERENCE] = "";
         entryAnalysis.values[AC_ELAPSED_SECONDS] = "";
         entryAnalysis.values[AC_LOT] = AnalysisNumber(reversalEntryVolume, 2);
         entryAnalysis.values[AC_DEAL_VOLUME] = AnalysisNumber(reversalEntryVolume, 2);
         entryAnalysis.values[AC_DEAL_PROFIT] = "";
         entryAnalysis.values[AC_DEAL_COMMISSION] = "";
         entryAnalysis.values[AC_DEAL_SWAP] = "";
         entryAnalysis.values[AC_DEAL_FEE] = "";
         entryAnalysis.values[AC_REASON_DETAIL] = "Reversal opening portion; profit and costs are recorded on the exit portion only.";

         SLightAnalysisRecord exitLight;
         SLightAnalysisRecord entryLight;
         BuildLightExitRecordFromDeal(exitLight, deal, order, positionId, dealTime, dealTimeMsc,
                                      price, reversalExitVolume,
                                      positionType == POSITION_TYPE_BUY ? "BUY" : "SELL",
                                      dealReason, HistoryDealGetDouble(deal, DEAL_PROFIT),
                                      HistoryDealGetDouble(deal, DEAL_COMMISSION),
                                      HistoryDealGetDouble(deal, DEAL_SWAP),
                                      HistoryDealGetDouble(deal, DEAL_FEE), DealReasonToString(dealReason),
                                      (dealReason == DEAL_REASON_SL || dealReason == DEAL_REASON_TP)
                                         ? 0.0 : requestedPrice,
                                      orderVolume, inTime, inTimeMsc);
         BuildLightEntryRecordFromDeal(entryLight, deal, order, positionId, dealTime, dealTimeMsc,
                                       price, reversalEntryVolume,
                                       newPositionType == POSITION_TYPE_BUY ? "BUY" : "SELL",
                                       requestedPrice, orderVolume, DealReasonToString(dealReason));

         WriteAnalysisEvent(exitAnalysis, true,
                            g_pendingTradeEvents[index].reversalExitDetailedWritten,
                            exitLight, true,
                            g_pendingTradeEvents[index].reversalExitLightAttempted,
                            g_pendingTradeEvents[index].reversalExitLightWritten);
         WriteAnalysisEvent(entryAnalysis, reversalEntryVolume > 0.0,
                            g_pendingTradeEvents[index].reversalEntryDetailedWritten,
                            entryLight, reversalEntryVolume > 0.0,
                            g_pendingTradeEvents[index].reversalEntryLightAttempted,
                            g_pendingTradeEvents[index].reversalEntryLightWritten);
         detailedReady = g_pendingTradeEvents[index].reversalExitDetailedWritten &&
                         (reversalEntryVolume <= 0.0 || g_pendingTradeEvents[index].reversalEntryDetailedWritten);
      }
      else
      {
         SLightAnalysisRecord lightRecord;
         bool shouldWriteLight = isEntry || isExit;
         if (isEntry)
            BuildLightEntryRecordFromDeal(lightRecord, deal, order, positionId, dealTime, dealTimeMsc,
                                          price, volume,
                                          positionType == POSITION_TYPE_BUY ? "BUY" : "SELL",
                                          requestedPrice, orderVolume, DealReasonToString(dealReason));
         else if (isExit)
            BuildLightExitRecordFromDeal(lightRecord, deal, order, positionId, dealTime, dealTimeMsc,
                                         price, volume,
                                         positionType == POSITION_TYPE_BUY ? "BUY" : "SELL",
                                         dealReason, HistoryDealGetDouble(deal, DEAL_PROFIT),
                                         HistoryDealGetDouble(deal, DEAL_COMMISSION),
                                         HistoryDealGetDouble(deal, DEAL_SWAP),
                                         HistoryDealGetDouble(deal, DEAL_FEE), DealReasonToString(dealReason),
                                         (dealReason == DEAL_REASON_SL || dealReason == DEAL_REASON_TP)
                                            ? 0.0 : requestedPrice,
                                         orderVolume, inTime, inTimeMsc);
         WriteAnalysisEvent(analysis, true, g_pendingTradeEvents[index].detailedWritten,
                            lightRecord, shouldWriteLight,
                            g_pendingTradeEvents[index].lightAttempted,
                            g_pendingTradeEvents[index].lightWritten);
         detailedReady = g_pendingTradeEvents[index].detailedWritten;
      }
      if (!detailedReady)
      {
         ArrayResize(g_processedTradeDeals, processedSize);
         index++;
         continue;
      }

      ReleaseLightSnapshotsForCompletedOrder(order, index);
      g_processedTradeDeals[processedSize] = deal;
      AddTradeHistoryTimestamp(TimeCurrent());
      if (isEntry && (!isReversal || reversalEntryVolume > 0.0))
         SaveEntryLogRecord(positionId, deal, dealTime, dealTimeMsc,
                            price, isReversal ? reversalEntryVolume : volume,
                            isReversal ? newPositionType : positionType);
      if (isReversal)
         LogPositionSummary("Position reversal: exit and entry recorded", dealTime, dealTimeMsc);
      else if (isEntry)
         LogPositionSummary(positionType == POSITION_TYPE_BUY ? "BUY deal filled" : "SELL deal filled",
                            dealTime, dealTimeMsc);
      else if (isExit)
         LogPositionSummary(positionType == POSITION_TYPE_BUY ? "BUY position closed" : "SELL position closed",
                            dealTime, dealTimeMsc);
      else
         LogPositionSummary("Trade deal recorded", dealTime, dealTimeMsc);

      RemovePendingTradeEvent(index);
      processedCount++;
   }
   return processedCount;
}

