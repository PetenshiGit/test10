{
   return AnalysisDirection(dir);
}

//+------------------------------------------------------------------+
//| Timer function                                                   |
//+------------------------------------------------------------------+
void OnTimer()
{
   ProcessPendingTradeEvents();

   MqlTick updateTick;
   ZeroMemory(updateTick);
   bool hasUpdateTick = EnableAnalysisCsv && SymbolInfoTick(_Symbol, updateTick) &&
                        updateTick.time > 0 && updateTick.time_msc > 0;
   bool sameMillisecondTickChanged = hasUpdateTick && g_hasLastTimerObservedTick &&
      updateTick.time_msc == g_lastTimerObservedTick.time_msc &&
      (updateTick.bid != g_lastTimerObservedTick.bid ||
       updateTick.ask != g_lastTimerObservedTick.ask ||
       updateTick.last != g_lastTimerObservedTick.last ||
       updateTick.volume != g_lastTimerObservedTick.volume ||
       updateTick.volume_real != g_lastTimerObservedTick.volume_real ||
       updateTick.flags != g_lastTimerObservedTick.flags);
   bool freshUpdateTick = hasUpdateTick &&
      (!g_hasLastTimerObservedTick || updateTick.time_msc > g_lastTimerObservedTick.time_msc ||
       sameMillisecondTickChanged);
   if (freshUpdateTick)
   {
      g_lastTimerObservedTick = updateTick;
      g_hasLastTimerObservedTick = true;
   }
   g_currentAnalysisEventTime = freshUpdateTick ? (datetime)updateTick.time : 0;
   g_currentAnalysisEventTimeMsc = freshUpdateTick ? updateTick.time_msc : 0;
   datetime bM1 = iTime(_Symbol, PERIOD_M1, 0);
   datetime bM15 = iTime(_Symbol, PERIOD_M15, 0);
   datetime bH1 = iTime(_Symbol, PERIOD_H1, 0);
   bool h1Updated = false;

   bool newM1Bar = bM1 != LastM1;

   // M1 更新判定
   if (newM1Bar || !g_m1AllOk)
   {
      SetAnalysisFlag(g_superTrendPullbackBuy, "g_superTrendPullbackBuy", false,
                      "M1 bar update.");
      SetAnalysisFlag(g_superTrendPullbackSell, "g_superTrendPullbackSell", false,
                      "M1 bar update.");
      SetAnalysisFlag(g_superTrendReaccelBuy, "g_superTrendReaccelBuy", false,
                      "M1 bar update.");
      SetAnalysisFlag(g_superTrendReaccelSell, "g_superTrendReaccelSell", false,
                      "M1 bar update.");
      if (newM1Bar)
         ResetM1Data();
      if (TrendM1.Calculate())
      {
         LastM1 = bM1;
         if (EnableAnalysisCsv)
         {
            datetime completedM1BarTime = iTime(_Symbol, PERIOD_M1, 1);
            datetime eventTime = 0;
            long eventTimeMsc = 0;
            if (completedM1BarTime > 0 && completedM1BarTime != g_lastM1CsvBarTime &&
                GetAnalysisBarEventTime(bM1, updateTick, eventTime, eventTimeMsc))
            {
               MqlRates rates[];
               ArraySetAsSeries(rates, true);
               if (CopyRates(_Symbol, PERIOD_M1, 0, 2, rates) == 2)
               {
                  SAnalysisRecord analysis;
                  ResetAnalysisRecord(analysis, "M1_UPDATE");
                  SetAnalysisContext(analysis, eventTime, eventTimeMsc);
                  analysis.values[AC_M1_BAR_TIME] = AnalysisDateTime(completedM1BarTime);
                  analysis.values[AC_M1_OPEN] = AnalysisNumber(rates[1].open, _Digits);
                  analysis.values[AC_M1_HIGH] = AnalysisNumber(rates[1].high, _Digits);
                  analysis.values[AC_M1_LOW] = AnalysisNumber(rates[1].low, _Digits);
                  analysis.values[AC_M1_CLOSE] = AnalysisNumber(rates[1].close, _Digits);
                  analysis.values[AC_M1_TICK_VOLUME] = IntegerToString((int)rates[1].tick_volume);
                  analysis.values[AC_M1_BB_UPPER] = AnalysisArrayValue(g_bbUpper, 1, _Digits);
                  analysis.values[AC_M1_BB_MIDDLE] = AnalysisArrayValue(g_bbMiddle, 1, _Digits);
                  analysis.values[AC_M1_BB_LOWER] = AnalysisArrayValue(g_bbLower, 1, _Digits);
                  analysis.values[AC_M1_STOCH_K] = AnalysisArrayValue(g_stochK, 1, 3);
                  analysis.values[AC_M1_STOCH_D] = AnalysisArrayValue(g_stochD, 1, 3);
                  analysis.values[AC_M1_ATR] = AnalysisArrayValue(g_atr, 1, _Digits);
                  analysis.values[AC_M1_SUPER_TREND] = AnalysisArrayValue(g_superTrend, 1, _Digits);
                  if (ArraySize(g_superTrendDir) > 1)
                     analysis.values[AC_M1_SUPER_TREND_DIRECTION] = LogSuperTrendDirection(1);
                  if (WriteAnalysisRecord(analysis))
                     g_lastM1CsvBarTime = completedM1BarTime;
               }
            }
         }
      }
      else
      {
         g_m1AllOk = false;
         PrintFormat("OnTimer: 1分足更新ができなかった 時刻=%s", TimeToString(bM1, TIME_DATE | TIME_SECONDS));
      }
   }

   // M15 更新判定
   if (bM15 != LastM15 || !g_m15AllOk)
   {
      if (bM15 != LastM15)
         ResetM15Data();
      datetime m15EventTime = 0;
      long m15EventTimeMsc = 0;
      if (EnableAnalysisCsv)
         GetAnalysisBarEventTime(bM15, updateTick, m15EventTime, m15EventTimeMsc);
      if (TrendM15.Calculate(bM15, m15EventTime, m15EventTimeMsc))
      {
         LastM15 = bM15;
      }
      else
      {
         g_m15AllOk = false;
         PrintFormat("OnTimer: 15分足更新ができなかった 時刻=%s", TimeToString(bM15, TIME_DATE | TIME_SECONDS));
      }
   }

   // H1 更新判定
   if (bH1 != LastH1 || !g_h1AllOk)
   {
      if (bH1 != LastH1)
         ResetH1Data();
      if (TrendH1.Calculate())
      {
         g_TrendTypeH = TrendH1.getType();
         g_TrendStateH = TrendH1.getState();
         g_TrendValueH = TrendH1.getValue();
         if (EnableAnalysisCsv)
         {
            datetime completedH1BarTime = iTime(_Symbol, PERIOD_H1, 1);
            datetime h1EventTime = 0;
            long h1EventTimeMsc = 0;
            if (completedH1BarTime > 0 && completedH1BarTime != g_lastH1CsvBarTime &&
                GetAnalysisBarEventTime(bH1, updateTick, h1EventTime, h1EventTimeMsc))
            {
               SAnalysisRecord analysis;
               ResetAnalysisRecord(analysis, "H1_UPDATE");
               SetAnalysisContext(analysis, h1EventTime, h1EventTimeMsc);
               analysis.values[AC_H1_BAR_TIME] = AnalysisDateTime(completedH1BarTime);
               analysis.values[AC_H1_TREND_TYPE] = EnumToString(g_TrendTypeH);
               analysis.values[AC_H1_TREND_STATE] = EnumToString(g_TrendStateH);
               analysis.values[AC_H1_DI_DIRECTION] = AnalysisDirection(g_H1DiDir);
               analysis.values[AC_H1_EMA_DIRECTION] = AnalysisDirection(g_H1EmaDir);
               analysis.values[AC_ADX] = AnalysisArrayValue(g_h1_adxArr, 1, 3);
               analysis.values[AC_DI_PLUS] = AnalysisArrayValue(g_h1_dipArr, 1, 3);
               analysis.values[AC_DI_MINUS] = AnalysisArrayValue(g_h1_dimArr, 1, 3);
               analysis.values[AC_EMA_SHORT] = AnalysisArrayValue(g_h1_emaSArr, 1, _Digits);
               analysis.values[AC_EMA_LONG] = AnalysisArrayValue(g_h1_emaLArr, 1, _Digits);
               if (WriteAnalysisRecord(analysis))
                  g_lastH1CsvBarTime = completedH1BarTime;
            }
         }
         // ADXの取得成功値表示はコメントアウト。
         LastH1 = bH1;
         h1Updated = true;
      }
      else
      {
         g_TrendTypeH = TREND_UNKNOWN;
         PrintFormat("OnTimer: 1時間足更新ができなかった 時刻=%s", TimeToString(bH1, TIME_DATE | TIME_SECONDS));
      }
   }

   // M1売買条件統合判定は、M15/H1更新後に実行する。
   if (newM1Bar)
   {
      TrendM1.ComputeEntryExit(g_TrendTypeH);
      if (EnableAnalysisCsv)
      {
         SAnalysisRecord buyPrices;
         ResetAnalysisRecord(buyPrices, "OTHER_ANALYSIS");
         SetAnalysisContext(buyPrices, g_currentAnalysisEventTime,
                            g_currentAnalysisEventTimeMsc);
         buyPrices.values[AC_REASON] = "OnTimer entry and exit prices";
         buyPrices.values[AC_DIRECTION] = "BUY";
         buyPrices.values[AC_ENTRY_PRICE] = AnalysisNumber(g_entryPriceBuy, _Digits);
         buyPrices.values[AC_PRICE] = AnalysisNumber(g_closePriceBuy, _Digits);
         buyPrices.values[AC_ENTRY_SIGNAL] = EnumToString(g_lastTrendEntrySignalBuy);
         buyPrices.values[AC_REASON_DETAIL] = "CanEntry=" + (g_canEntryBuy ? "true" : "false") +
            ";CanClose=" + (g_canCloseBuy ? "true" : "false");
         WriteAnalysisRecord(buyPrices);

         SAnalysisRecord sellPrices;
         ResetAnalysisRecord(sellPrices, "OTHER_ANALYSIS");
         SetAnalysisContext(sellPrices, g_currentAnalysisEventTime,
                            g_currentAnalysisEventTimeMsc);
         sellPrices.values[AC_REASON] = "OnTimer entry and exit prices";
         sellPrices.values[AC_DIRECTION] = "SELL";
         sellPrices.values[AC_ENTRY_PRICE] = AnalysisNumber(g_entryPriceSell, _Digits);
         sellPrices.values[AC_PRICE] = AnalysisNumber(g_closePriceSell, _Digits);
         sellPrices.values[AC_ENTRY_SIGNAL] = EnumToString(g_lastTrendEntrySignalSell);
         sellPrices.values[AC_REASON_DETAIL] = "CanEntry=" + (g_canEntrySell ? "true" : "false") +
            ";CanClose=" + (g_canCloseSell ? "true" : "false");
         WriteAnalysisRecord(sellPrices);
      }
   }

   // M15シグナルは、M15確定後に最初に処理したM1足でのみ有効とする。
   // M1判定が完了した後に失効させ、同じ足の追撃判定では利用できるようにする。
   if (newM1Bar && g_M15Signal.pendingNextM1 && bM1 >= g_M15Signal.expireM1BarTime)
      SetAnalysisFlag(g_M15Signal.pendingNextM1, "g_M15Signal.pendingNextM1", false,
                      "Next M1 bar period expired.");

   datetime tradeServerTime = TimeTradeServer();
   g_currentAnalysisEventTime = 0;
   g_currentAnalysisEventTimeMsc = 0;
   if (tradeServerTime <= 0)
      return;
   ProcessWeekendSession(tradeServerTime, h1Updated);
}
