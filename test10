ulong NowMs()
{
   return (GetTickCount64());
}
void PushReq(ulong t)
{
   if (ReqCount < REQ_CAP)
      ReqTimes[ReqCount++] = t;
   else
   {
      for (int i = 1; i < ReqCount; i++)
         ReqTimes[i - 1] = ReqTimes[i];
      ReqTimes[ReqCount - 1] = t;
   }
}
int CountReqSince(ulong window_ms)
{
   if (ReqCount == 0)
      return 0;
   ulong now = NowMs();
   int cnt = 0;
   for (int i = ReqCount - 1; i >= 0; i--)
   {
      if (now - ReqTimes[i] <= window_ms)
         cnt++;
      else
         break;
   }
   return (cnt);
}
bool CanReq(bool urgent = false)
{
   int window = RequestWindowMS();
   if (urgent)
      window = MathMax(200, RequestWindowMS() / 2);
   return (CountReqSince(window) < RequestLimitCount());
}
void RegReq()
{
   PushReq(NowMs());
}

int RequestLimitCount()
{
   return 20;
}

int RequestWindowMS()
{
   return 2000;
}

void AddTradeHistoryTimestamp(datetime t)
{
   if (TradeHistorySize < MAX_HISTORY)
   {
      for (int i = TradeHistorySize; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
      TradeHistorySize++;
   }
   else
   {
      for (int i = MAX_HISTORY - 1; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
   }
}

// ===================================================================
// ダイバージェンス補助（配列は参照で渡す）
// ===================================================================
void FindPeaks(const double &arr[], int period, bool mode, int minDistance, int peakCount, int &outIdx[])
{
   ArrayInitialize(outIdx, -1);
   int found = 0;
   int lastIdx = -minDistance - 1;
   for (int i = 0; i < period && found < peakCount; i++)
   {
      bool isPeak = true;
      for (int j = -1; j <= 1; j++)
      {
         int k = i + j;
         if (k < 0 || k >= period)
            continue;
         if ((mode && arr[i] < arr[k]) || (!mode && arr[i] > arr[k]))
         {
            isPeak = false;
            break;
         }
      }
      if (isPeak && (i - lastIdx) >= minDistance)
      {
         outIdx[found] = i;
         lastIdx = i;
         found++;
      }
   }
}

int FindIndicatorPeak(double &indi[], int center, int period, bool mode, int win, bool &used[])
{
   int start = MathMax(0, center - win);
   int end = MathMin(period - 1, center + win);
   int idx = -1;
   double val = mode ? -DBL_MAX : DBL_MAX;
   for (int i = start; i <= end; i++)
   {
      if (used[i])
         continue;
      if ((mode && indi[i] > val) || (!mode && indi[i] < val))
      {
         val = indi[i];
         idx = i;
      }
   }
   if (idx >= 0)
      used[idx] = true;
   return (idx);
}

DivergenceType CheckDivergenceFull(string symbol, ENUM_TIMEFRAMES timeframe, double &indicator[], int period, int peakCount = 3, int minDistance = 2, int win = 2)
{
   double highs[], lows[];
   if (CopyHigh(symbol, timeframe, 0, period, highs) <= 0 ||
       CopyLow(symbol, timeframe, 0, period, lows) <= 0)
   {
      Print("ダイバージェンス判定用の価格データ取得に失敗しました。");
      return (DIVERGENCE_NONE);
   }
   ArraySetAsSeries(highs, true);
   ArraySetAsSeries(lows, true);

   int high_idx[10];
   int low_idx[10];
   FindPeaks(highs, period, true, minDistance, peakCount, high_idx);
   FindPeaks(lows, period, false, minDistance, peakCount, low_idx);

   bool usedIndi[200];
   ArrayInitialize(usedIndi, false);
   int indiHigh[10];
   int indiLow[10];
   for (int i = 0; i < peakCount; i++)
   {
      if (high_idx[i] >= 0)
         indiHigh[i] = FindIndicatorPeak(indicator, high_idx[i], period, true, win, usedIndi);
      else
         indiHigh[i] = -1;
      if (low_idx[i] >= 0)
         indiLow[i] = FindIndicatorPeak(indicator, low_idx[i], period, false, win, usedIndi);
      else
         indiLow[i] = -1;
   }

   bool bearish = false;
   bool bullish = false;
   if (high_idx[0] >= 0 && high_idx[1] >= 0 && high_idx[2] >= 0 && indiHigh[0] >= 0 && indiHigh[1] >= 0 && indiHigh[2] >= 0)
   {
      if (highs[high_idx[0]] < highs[high_idx[1]] && highs[high_idx[1]] < highs[high_idx[2]] &&
          indicator[indiHigh[0]] > indicator[indiHigh[1]] && indicator[indiHigh[1]] > indicator[indiHigh[2]])
         bearish = true;
   }
   if (low_idx[0] >= 0 && low_idx[1] >= 0 && low_idx[2] >= 0 && indiLow[0] >= 0 && indiLow[1] >= 0 && indiLow[2] >= 0)
   {
      // 簡略化：詳細な判定ロジックは省略
      if (lows[low_idx[0]] > lows[low_idx[1]] && lows[low_idx[1]] > lows[low_idx[2]] &&
          indicator[indiLow[0]] < indicator[indiLow[1]] && indicator[indiLow[1]] < indicator[indiLow[2]])
         bullish = true;
   }

   if (bullish && !bearish)
      return DIVERGENCE_BULLISH;
   if (bearish && !bullish)
      return DIVERGENCE_BEARISH;
   if (bearish && bullish)
      return DIVERGENCE_CONFLICT;
   return DIVERGENCE_NONE;
}

// ===================================================================
// H1 用クラス
// ADX と EMA を使ってトレンド/レンジ種別や方向性を判定する
// ===================================================================
class CTrend1H
{
private:
   TrendType m_type;
   TrendState m_state;
   double m_value;
   int h_adx;
   int h_emaS;
   int h_emaL;
public:
   CTrend1H() { m_type = TREND_UNKNOWN; m_state = STATE_UNKNOWN; m_value = 0.0; h_adx = h_emaS = h_emaL = INVALID_HANDLE; }
   void Init(int _h_adx, int _h_emaS, int _h_emaL) { h_adx = _h_adx; h_emaS = _h_emaS; h_emaL = _h_emaL; }
   bool Calculate()
   {
      datetime lastH1BarTime = iTime(_Symbol, PERIOD_H1, 0);
      datetime nowTime = TimeCurrent();
      int timeDiffSeconds = (int)(nowTime - lastH1BarTime);
      const int SKIP_THRESHOLD_SECONDS = 3600; // 1時間

      // 前回の取得が全て成功していれば、新しい足を待つ（OnTimer で呼ばれる想定なら不要）
      if (g_h1AllOk && timeDiffSeconds >= SKIP_THRESHOLD_SECONDS)
      {
         PrintFormat("1時間足更新スキップ: 最終更新 %s 現在 %s 次回足更新まで待機", TimeToString(lastH1BarTime), TimeToString(nowTime));
         return(true);
      }

      const int need = 3;
      double adxArr[], dipArr[], dimArr[], emaSArr[], emaLArr[];

      // 各指標ごとに、直近成功キャッシュがあれば再取得しない
      int copied_adx = 0, copied_dip = 0, copied_dim = 0, copied_emaS = 0, copied_emaL = 0;

      if (g_h1_adx_ok)
      {
         ArrayResize(adxArr, need);
         for (int i=0;i<need;i++) adxArr[i] = g_h1_adxArr[i];
         copied_adx = need;
      }
      else
      {
         copied_adx = CopyBuffer(h_adx, 0, 0, need, adxArr);
         if (copied_adx < need) copied_adx = CopyBuffer(h_adx, 0, 0, need, adxArr); // 1回だけリトライ
         if (copied_adx >= need)
         {
            for (int i=0;i<need && i<ArraySize(adxArr); i++) g_h1_adxArr[i] = adxArr[i];
            g_h1_adx_ok = true;
         }
      }

      if (g_h1_dip_ok)
      {
         ArrayResize(dipArr, need);
         for (int i=0;i<need;i++) dipArr[i] = g_h1_dipArr[i];
         copied_dip = need;
      }
      else
      {
         copied_dip = CopyBuffer(h_adx, 1, 0, need, dipArr);
         if (copied_dip < need) copied_dip = CopyBuffer(h_adx, 1, 0, need, dipArr);
         if (copied_dip >= need)
         {
            for (int i=0;i<need && i<ArraySize(dipArr); i++) g_h1_dipArr[i] = dipArr[i];
            g_h1_dip_ok = true;
         }
      }

      if (g_h1_dim_ok)
      {
         ArrayResize(dimArr, need);
         for (int i=0;i<need;i++) dimArr[i] = g_h1_dimArr[i];
         copied_dim = need;
      }
      else
      {
         copied_dim = CopyBuffer(h_adx, 2, 0, need, dimArr);
         if (copied_dim < need) copied_dim = CopyBuffer(h_adx, 2, 0, need, dimArr);
         if (copied_dim >= need)
         {
            for (int i=0;i<need && i<ArraySize(dimArr); i++) g_h1_dimArr[i] = dimArr[i];
            g_h1_dim_ok = true;
         }
      }

      if (g_h1_emaS_ok)
      {
         ArrayResize(emaSArr, need);
         for (int i=0;i<need;i++) emaSArr[i] = g_h1_emaSArr[i];
         copied_emaS = need;
      }
      else
      {
         copied_emaS = CopyBuffer(h_emaS, 0, 0, need, emaSArr);
         if (copied_emaS < need) copied_emaS = CopyBuffer(h_emaS, 0, 0, need, emaSArr);
         if (copied_emaS >= need)
         {
            for (int i=0;i<need && i<ArraySize(emaSArr); i++) g_h1_emaSArr[i] = emaSArr[i];
            g_h1_emaS_ok = true;
         }
      }

      if (g_h1_emaL_ok)
      {
         ArrayResize(emaLArr, need);
         for (int i=0;i<need;i++) emaLArr[i] = g_h1_emaLArr[i];
         copied_emaL = need;
      }
      else
      {
         copied_emaL = CopyBuffer(h_emaL, 0, 0, need, emaLArr);
         if (copied_emaL < need) copied_emaL = CopyBuffer(h_emaL, 0, 0, need, emaLArr);
         if (copied_emaL >= need)
         {
            for (int i=0;i<need && i<ArraySize(emaLArr); i++) g_h1_emaLArr[i] = emaLArr[i];
            g_h1_emaL_ok = true;
         }
      }

      // 取得失敗判定
      bool fail_adx = (copied_adx < need);
      bool fail_dip = (copied_dip < need);
      bool fail_dim = (copied_dim < need);
      bool fail_emaS = (copied_emaS < need);
      bool fail_emaL = (copied_emaL < need);

      // 1つでも失敗があれば、全体フラグは false にして戻る
      if (fail_adx || fail_dip || fail_dim || fail_emaS || fail_emaL)
      {
         g_h1AllOk = false;
         PrintFormat("1時間足指標取得失敗：取得結果 (ADX=%d DI+=%d DI-=%d EMA短=%d EMA長=%d)", 
                    copied_adx, copied_dip, copied_dim, copied_emaS, copied_emaL);
         return(false);
      }

      // すべて取得成功 → 全体フラグを true
      g_h1AllOk = true;

      ArraySetAsSeries(adxArr, true);
      ArraySetAsSeries(dipArr, true);
      ArraySetAsSeries(dimArr, true);
      ArraySetAsSeries(emaSArr, true);
      ArraySetAsSeries(emaLArr, true);

      double adx0 = adxArr[0], adx1 = adxArr[1], adx2 = adxArr[2];
      double dip0 = dipArr[0], dim0 = dimArr[0];
      double emaS0 = emaSArr[0], emaL0 = emaLArr[0];

      bool adxAllAbove = (adx0 >= adxThreshold && adx1 >= adxThreshold && adx2 >= adxThreshold);
      bool adxAllBelow = (adx0 < adxRangeThreshold && adx1 < adxRangeThreshold && adx2 < adxRangeThreshold);
      bool adxAscending = (adx2 < adx1 && adx1 < adx0);
      bool adxDescending = (adx2 > adx1 && adx1 > adx0);

      // トレンド種別判定
      if (adxAllBelow)
      {
         m_type = TREND_RANGE;
      }
      else if (adxAllAbove)
      {
         if (dip0 > dim0 && emaS0 > emaL0) m_type = TREND_STRONG_UP;
         else if (dip0 > dim0 || emaS0 > emaL0) m_type = TREND_WEAK_UP;
         else if (dip0 < dim0 && emaS0 < emaL0) m_type = TREND_STRONG_DOWN;
         else if (dip0 < dim0 || emaS0 < emaL0) m_type = TREND_WEAK_DOWN;
         else m_type = TREND_UNKNOWN;
      }
      else
      {
         // 中間領域: ADX の傾きと DI/EMA の方向で判定
         if (dip0 > dim0 || emaS0 > emaL0)
            m_type = TREND_WEAK_UP;
         else if (dip0 < dim0 || emaS0 < emaL0)
            m_type = TREND_WEAK_DOWN;
         else
            m_type = TREND_UNKNOWN;
      }

      // トレンド状態（加速/減速/維持）
      if (adx0 > adx1) m_state = TREND_ACCELERATE;
      else if (adx0 < adx1) m_state = TREND_DECELERATE;
      else m_state = TREND_MAINTAIN;

      m_value = adx0;
      return(true);
   }
   TrendType getType() const { return(m_type); }
   TrendState getState() const { return(m_state); }
   double getValue() const { return(m_value); }
};

// ===================================================================
// M15 用クラス
// RSI と MACD を使ってトレンド状態・過熱感・ダイバージェンス・クロスを判定する
// ===================================================================
class CTrend15
{
private:
    TrendState m_state;
    OverheatType m_overheat;
    DivergenceType m_div;
    double m_value;
    bool m_macdCross;
    int m_macdCrossDir; // 1 up, -1 down
    int rsiH, macdH;
public:
    CTrend15() { m_state = STATE_UNKNOWN; m_overheat = OVERHEAT_NONE; m_div = DIVERGENCE_NONE; m_value = 0.0; m_macdCross = false; m_macdCrossDir = 0; rsiH = macdH = INVALID_HANDLE; }
    void Init(int _rsiH, int _macdH) { rsiH = _rsiH; macdH = _macdH; }
   bool Calculate(TrendType h1Type, datetime barTime)
    {
        datetime lastM15BarTime = iTime(_Symbol, PERIOD_M15, 0);
        datetime nowTime = TimeCurrent();
        int timeDiffSeconds = (int)(nowTime - lastM15BarTime);
        const int SKIP_THRESHOLD_SECONDS = 900;  // 15分

      // 前回の取得が全て成功していれば、新しい足を待つ
      if (g_m15AllOk && timeDiffSeconds >= SKIP_THRESHOLD_SECONDS)
      {
         PrintFormat("15分足更新スキップ: 最終更新 %s 現在 %s 次回足更新まで待機", TimeToString(lastM15BarTime), TimeToString(nowTime));
         m_value = 0.0;
         m_state = STATE_UNKNOWN;
         m_overheat = OVERHEAT_NONE;
         m_div = DIVERGENCE_NONE;
         m_macdCross = false;
         m_macdCrossDir = 0;
         return(true);
      }

      const int need = 3;
      double rsiArr[], macdMain[], macdSig[];

      int copied_rsi = 0, copied_macdMain = 0, copied_macdSig = 0;

      // RSI
      if (g_m15_rsi_ok)
      {
         ArrayResize(rsiArr, need);
         for (int i=0;i<need;i++) rsiArr[i] = g_m15_rsiArr[i];
         copied_rsi = need;
      }
      else
      {
         copied_rsi = CopyBuffer(rsiH, 0, 1, need, rsiArr);
         if (copied_rsi < need) copied_rsi = CopyBuffer(rsiH, 0, 1, need, rsiArr);
         if (copied_rsi >= need)
         {
            for (int i=0;i<need && i<ArraySize(rsiArr); i++) g_m15_rsiArr[i] = rsiArr[i];
            g_m15_rsi_ok = true;
         }
      }

      // MACD (need+1 を取得)
      int needmacd = need + 1;
      if (g_m15_macd_ok)
      {
         ArrayResize(macdMain, needmacd);
         ArrayResize(macdSig, needmacd);
         for (int i=0;i<needmacd;i++) { macdMain[i] = g_m15_macdMainAll[i]; macdSig[i] = g_m15_macdSigAll[i]; }
         copied_macdMain = needmacd; copied_macdSig = needmacd;
      }
      else
      {
         copied_macdMain = CopyBuffer(macdH, 0, 2, needmacd, macdMain);
         copied_macdSig = CopyBuffer(macdH, 1, 2, needmacd, macdSig);
         if (copied_macdMain < needmacd || copied_macdSig < needmacd)
         {
            // リトライ
            if (copied_macdMain < needmacd) copied_macdMain = CopyBuffer(macdH, 0, 2, needmacd, macdMain);
            if (copied_macdSig < needmacd) copied_macdSig = CopyBuffer(macdH, 1, 2, needmacd, macdSig);
         }
         if (copied_macdMain >= needmacd && copied_macdSig >= needmacd)
         {
            for (int i=0;i<needmacd && i<ArraySize(macdMain) && i<DIVERGENCE_PERIOD; i++)
               g_m15_macdMainAll[i] = macdMain[i];
            for (int i=0;i<needmacd && i<ArraySize(macdSig) && i<DIVERGENCE_PERIOD; i++)
               g_m15_macdSigAll[i] = macdSig[i];
            g_m15_macd_ok = true;
         }
      }

      // 取得失敗判定
      bool fail_rsi = (copied_rsi < need);
      bool fail_macdMain = (copied_macdMain < (need + 1));
      bool fail_macdSig = (copied_macdSig < (need + 1));

      // 1つでも失敗があれば、全体フラグを false にして戻る
      if (fail_rsi || fail_macdMain || fail_macdSig)
      {
         g_m15AllOk = false;
         PrintFormat("15分足指標取得失敗：取得結果 (RSI=%d MACD_Main=%d MACD_Sig=%d)", 
                  copied_rsi, copied_macdMain, copied_macdSig);
         return(false);
      }

      // すべて取得成功 → 全体フラグ true
      g_m15AllOk = true;

      ArraySetAsSeries(rsiArr, true);
      ArraySetAsSeries(macdMain, true);
      ArraySetAsSeries(macdSig, true);

        double macdHist[3];
        for (int i = 0; i < need; i++) macdHist[i] = macdMain[i] - macdSig[i];

        PrintFormat("15分足更新： RSI=%.3f, MACD_Hist=%.6f", rsiArr[0], macdHist[0]);

        // Overheat/divergence selection
        if (h1Type == TREND_RANGE || h1Type == TREND_UNKNOWN)
        {
            m_value = rsiArr[0];
            if (rsiArr[0] > rsiOverbought) m_overheat = OVERHEAT_OVERBOUGHT;
            else if (rsiArr[0] < rsiOversold) m_overheat = OVERHEAT_OVERSOLD;
            else m_overheat = OVERHEAT_NONE;

            double arrD[DIVERGENCE_PERIOD];
            ArrayInitialize(arrD, 0.0);
            if (CopyBuffer(rsiH, 0, 0, DIVERGENCE_PERIOD, arrD) > 0) m_div = CheckDivergenceFull(_Symbol, PERIOD_M15, arrD, DIVERGENCE_PERIOD);
            else m_div = DIVERGENCE_NONE;
        }
        else
        {
            m_value = macdHist[0];
            if (macdHist[0] > 0) m_overheat = OVERHEAT_OVERBOUGHT;
            else if (macdHist[0] < 0) m_overheat = OVERHEAT_OVERSOLD;
            else m_overheat = OVERHEAT_NONE;

            double mainAll[], sigAll[], histAll[];
            ArrayResize(histAll, DIVERGENCE_PERIOD);
            if (CopyBuffer(macdH, 0, 0, DIVERGENCE_PERIOD, mainAll) > 0 && CopyBuffer(macdH, 1, 0, DIVERGENCE_PERIOD, sigAll) > 0)
            {
                for (int i = 0; i < DIVERGENCE_PERIOD; i++) histAll[i] = mainAll[i] - sigAll[i];
                m_div = CheckDivergenceFull(_Symbol, PERIOD_M15, histAll, DIVERGENCE_PERIOD);
            }
            else m_div = DIVERGENCE_NONE;
        }

        // MACD クロス判定（直近のバーでクロスが発生したか）
        m_macdCross = false;
        m_macdCrossDir = 0;
        // We need at least 3 points (series): index 0 latest completed, 1 prev, 2 prev2
        // Golden: prev2 <= prev1 and prev1 > prev0 (macdMain - macdSig cross upward between prev2->prev1)
        if (ArraySize(macdMain) >= 3 && ArraySize(macdSig) >= 3)
        {
            // cross up: macdMain[2] <= macdSig[2] && macdMain[1] > macdSig[1]
            if (macdMain[2] <= macdSig[2] && macdMain[1] > macdSig[1]) { m_macdCross = true; m_macdCrossDir = 1; }
            else if (macdMain[2] >= macdSig[2] && macdMain[1] < macdSig[1]) { m_macdCross = true; m_macdCrossDir = -1; }
        }
        else
        {
            // Fallback simpler cross detection using index 1 and 2 if available
            if (ArraySize(macdMain) >= 2 && ArraySize(macdSig) >= 2)
            {
                if (macdMain[1] > macdSig[1] && macdMain[2] <= macdSig[2]) { m_macdCross = true; m_macdCrossDir = 1; }
                else if (macdMain[1] < macdSig[1] && macdMain[2] >= macdSig[2]) { m_macdCross = true; m_macdCrossDir = -1; }
            }
        }

      // state heuristics
      if (m_value > 0) m_state = TREND_ACCELERATE;
      else if (m_value < 0) m_state = TREND_DECELERATE;
      else m_state = TREND_MAINTAIN;

      // Apply signal effects to globals so OnTimer need not duplicate logic
      g_DivergenceM15 = m_div;
      g_OverheatM15 = m_overheat;

      bool hasDiv = (m_div != DIVERGENCE_NONE);
      bool hasCross = m_macdCross;

      if (hasDiv || hasCross)
      {
         g_M15Signal.barTime = barTime;
         g_M15Signal.hasDiv = hasDiv;
         g_M15Signal.divType = m_div;
         g_M15Signal.hasMACDCross = hasCross;
         g_M15Signal.macdCrossDir = m_macdCrossDir;
         g_M15Signal.pendingNextM1 = true;
         g_M15Signal.usedForEntry = false;
         g_M15Signal.usedForClose = false;
         PrintFormat("15分足更新： 時刻=%s ダイバージェンス：%s MACDクロス：%s -> 次の1分足で有効", TimeToString(barTime, TIME_DATE | TIME_SECONDS), DivergenceTypeToString(g_DivergenceM15), MACDCrossDirToString(m_macdCrossDir));
      }
      else
      {
         g_M15Signal.pendingNextM1 = false;
         PrintFormat("15分足更新： 時刻=%s ダイバージェンス：なし MACDクロス：なし", TimeToString(barTime, TIME_DATE | TIME_SECONDS));
      }

      return(true);
    }
    TrendState getState() const { return (m_state); }
    OverheatType getOverheat() const { return (m_overheat); }
    DivergenceType getDivergence() const { return (m_div); }
    double getValue() const { return (m_value); }
    bool   getMACDCross() const { return (m_macdCross); }
    int    getMACDCrossDir() const { return (m_macdCrossDir); }
};

// ===================================================================
// M1 用クラス
// ボリンジャーバンド、ストキャスティクス、ATR、スーパートレンドを使って取引タイミングを計る
// ===================================================================
class CTrend1M
{
private:
    int h_bb;        // ボリンジャーバンド指標ハンドル
    int h_stoch;     // ストキャスティクス指標ハンドル
    int h_atr;       // ATR指標ハンドル
    int h_std;       // 標準偏差指標ハンドル
public:
    CTrend1M() { h_bb = h_stoch = h_atr = h_std = INVALID_HANDLE; }
    void Init(int _h_bb, int _h_stoch, int _h_atr, int _h_std) { h_bb = _h_bb; h_stoch = _h_stoch; h_atr = _h_atr; h_std = _h_std; }
    // Calculate: 更新があったタイミングの OnTimer から呼ぶ。グローバル配列 g_bb*, g_stoch*, g_atr*, g_superTrend* を更新する。
    bool Calculate()
    {
        // 1分足の最終更新時間を取得
        datetime lastM1BarTime = iTime(_Symbol, PERIOD_M1, 0);
        datetime nowTime = TimeCurrent();
        int timeDiffSeconds = (int)(nowTime - lastM1BarTime);
        const int SKIP_THRESHOLD_SECONDS = 60;  // 1分
        
      // 前回の取得が全て成功していれば、新しい足を待つ
      if (g_m1AllOk && timeDiffSeconds >= SKIP_THRESHOLD_SECONDS)
      {
         PrintFormat("1分足更新スキップ: 最終更新 %s 現在 %s 次回足更新まで待機", TimeToString(lastM1BarTime), TimeToString(nowTime));
         // 指標値は0にする
         ArrayInitialize(g_bbUpper, 0.0);
         ArrayInitialize(g_bbMiddle, 0.0);
         ArrayInitialize(g_bbLower, 0.0);
         ArrayInitialize(g_stochK, 0.0);
         ArrayInitialize(g_stochD, 0.0);
         ArrayInitialize(g_atr, 0.0);
         ArrayInitialize(g_superTrend, 0.0);
         return(true);
      }

      const int need = CACHE_BARS;
      // Bollinger Bands中値
      double mid[];
      // 標準偏差
      double stdArr[];
      // Stochastic %K線
      double kArr[];
      // Stochastic %D線
      double dArr[];
      // Average True Range（真の平均値幅）
      double atrArr[];

      int copied_mid = 0, copied_std = 0, copied_k = 0, copied_d = 0, copied_atr = 0;

      if (g_m1_bb_ok)
      {
         ArrayResize(mid, need); for (int i=0;i<need;i++) mid[i] = g_m1_midArr[i]; copied_mid = need;
      }
      else
      {
         copied_mid = CopyBuffer(h_bb, 0, 1, need, mid);
         if (copied_mid < need) copied_mid = CopyBuffer(h_bb, 0, 1, need, mid);
         if (copied_mid >= need) { for (int i=0;i<need && i<ArraySize(mid); i++) g_m1_midArr[i] = mid[i]; g_m1_bb_ok = true; }
      }

      if (g_m1_std_ok)
      {
         ArrayResize(stdArr, need); for (int i=0;i<need;i++) stdArr[i] = g_m1_stdArr[i]; copied_std = need;
      }
      else
      {
         copied_std = CopyBuffer(h_std, 0, 1, need, stdArr);
         if (copied_std < need) copied_std = CopyBuffer(h_std, 0, 1, need, stdArr);
         if (copied_std >= need) { for (int i=0;i<need && i<ArraySize(stdArr); i++) g_m1_stdArr[i] = stdArr[i]; g_m1_std_ok = true; }
      }

      if (g_m1_stoch_ok)
      {
         ArrayResize(kArr, need); ArrayResize(dArr, need);
         for (int i=0;i<need;i++) { kArr[i] = g_m1_kArr[i]; dArr[i] = g_m1_dArr[i]; }
         copied_k = need; copied_d = need;
      }
      else
      {
         copied_k = CopyBuffer(h_stoch, 0, 1, need, kArr);
         copied_d = CopyBuffer(h_stoch, 1, 1, need, dArr);
         if (copied_k < need) copied_k = CopyBuffer(h_stoch, 0, 1, need, kArr);
         if (copied_d < need) copied_d = CopyBuffer(h_stoch, 1, 1, need, dArr);
         if (copied_k >= need && copied_d >= need) { for (int i=0;i<need && i<ArraySize(kArr); i++) { g_m1_kArr[i]=kArr[i]; g_m1_dArr[i]=dArr[i]; } g_m1_stoch_ok = true; }
      }

      if (g_m1_atr_ok)
      {
         ArrayResize(atrArr, need); for (int i=0;i<need;i++) atrArr[i] = g_m1_atrArr[i]; copied_atr = need;
      }
      else
      {
         copied_atr = CopyBuffer(h_atr, 0, 1, need, atrArr);
         if (copied_atr < need) copied_atr = CopyBuffer(h_atr, 0, 1, need, atrArr);
         if (copied_atr >= need) { for (int i=0;i<need && i<ArraySize(atrArr); i++) g_m1_atrArr[i] = atrArr[i]; g_m1_atr_ok = true; }
      }

      // 取得失敗判定
      bool fail_mid = (copied_mid < need);
      bool fail_std = (copied_std < need);
      bool fail_k = (copied_k < need);
      bool fail_d = (copied_d < need);
      bool fail_atr = (copied_atr < need);

      // 1つでも失敗があれば、全体フラグを false にして戻る
      if (fail_mid || fail_std || fail_k || fail_d || fail_atr)
      {
         g_m1AllOk = false;
         PrintFormat("1分足指標取得失敗：取得結果 (BB中=%d 標偏=%d K=%d D=%d ATR=%d)", 
                  copied_mid, copied_std, copied_k, copied_d, copied_atr);
         return(false);
      }

      // すべて取得成功 → 全体フラグを true
      g_m1AllOk = true;

      ArraySetAsSeries(mid, true);
      ArraySetAsSeries(stdArr, true);
      ArraySetAsSeries(kArr, true);
      ArraySetAsSeries(dArr, true);
      ArraySetAsSeries(atrArr, true);

        // BB上下帯計算
        for (int i = 0; i < need; i++)
        {
            g_bbMiddle[i] = mid[i];
            g_bbUpper[i] = mid[i] + (stdArr[i] * bbDeviation);
            g_bbLower[i] = mid[i] - (stdArr[i] * bbDeviation);
        }
        g_stochK[0] = kArr[0];
        g_stochD[0] = dArr[0];
        g_atr[0] = atrArr[0];

        // スーパートレンド計算：中値 ± ATR×倍率
        // 上昇トレンド時：hl2 + ATR×倍率  下降トレンド時：hl2 - ATR×倍率
        double hl2 = g_bbMiddle[0];
        double superTrendBull = hl2 + atrMultiplierSL * g_atr[0];
        double superTrendBear = hl2 - atrMultiplierSL * g_atr[0];
        
        double lastPrice = iClose(_Symbol, PERIOD_M1, 0);
        
        // トレンド方向判定：直近3足の終値の比較またはLastSuperTrendで判定
        if (g_superTrendDir[1] > 0)
        {
            // 前回は上トレンド
            g_superTrend[0] = superTrendBull;
            g_superTrendDir[0] = (lastPrice > superTrendBull) ? 1 : -1;
        }
        else if (g_superTrendDir[1] < 0)
        {
            // 前回は下トレンド
            g_superTrend[0] = superTrendBear;
            g_superTrendDir[0] = (lastPrice > superTrendBear) ? 1 : -1;
        }
        else
        {
            // 初期値：現在の価格がどちらのトレンドかで判定
            if (lastPrice > superTrendBull)
            {
               g_superTrend[0] = superTrendBull;
               g_superTrendDir[0] = 1;  // 上昇トレンド
            }
            else if (lastPrice < superTrendBear)
            {
               g_superTrend[0] = superTrendBear;
               g_superTrendDir[0] = -1;  // 下降トレンド
            }
            else
            {
               g_superTrend[0] = hl2;
               g_superTrendDir[0] = 0;  // ニュートラル
            }
        }

        // ログ
        PrintFormat("1分足更新： BB中=%.5f BB上=%.5f BB下=%.5f Stoch_K=%.3f Stoch_D=%.3f ATR=%.5f",
                    mid[0], g_bbUpper[0], g_bbLower[0], kArr[0], dArr[0], atrArr[0]);
        PrintFormat("CTrend1M: グローバル保存済み BB上=%.5f BB中=%.5f BB下=%.5f StochK=%.3f StochD=%.3f ATR=%.5f",
                    g_bbUpper[0], g_bbMiddle[0], g_bbLower[0], g_stochK[0], g_stochD[0], g_atr[0]);
        PrintFormat("CTrend1M: SuperTrend=%.5f Dir=%d Bull=%.5f Bear=%.5f", 
                    g_superTrend[0], g_superTrendDir[0], superTrendBull, superTrendBear);

        return(true);
    }

   // Compute entry/exit prices and apply M15 signal effects; called from OnTimer when M1 updates
   void ComputeEntryExit(TrendType h1Type)
   {
      // initialize all price/flag variables
      g_closePriceBuy = 0.0;
      g_closePriceSell = 0.0;
      g_entryPriceBuy = 0.0;
      g_entryPriceSell = 0.0;
      g_canEntryBuy = false;
      g_canEntrySell = false;
      g_canCloseBuy = false;
      g_canCloseSell = false;
      g_entryThresholdCrossedBuy = false;
      g_entryThresholdCrossedSell = false;
      g_closeThresholdCrossedBuy = false;
      g_closeThresholdCrossedSell = false;
      g_M15LotMultiplier = 1.0;

      // exit/entry price based on trend (range=>BB, trend=>SuperTrend with BB fallback)
      if (h1Type == TREND_RANGE || h1Type == TREND_UNKNOWN)
      {
         // レンジ相場：BB ベース
         g_closePriceBuy = g_bbLower[0];      // BUY決済はBB下限で
         g_closePriceSell = g_bbUpper[0];    // SELL決済はBB上限で
         g_entryPriceBuy = g_bbUpper[0];     // BUYエントリはBB上限で
         g_entryPriceSell = g_bbLower[0];    // SELLエントリはBB下限で
      }
      else
      {
         // トレンド相場：SuperTrend ベース
         if (g_superTrendDir[0] > 0)
         {
            // 上昇トレンド
            g_entryPriceBuy = g_superTrend[0];
            g_closePriceSell = g_superTrend[0];
         }
         else if (g_superTrendDir[0] < 0)
         {
            // 下降トレンド
            g_entryPriceSell = g_superTrend[0];
            g_closePriceBuy = g_superTrend[0];
         }
         else
         {
            // SuperTrend がニュートラル（0）のときは BB にフォールバック
            g_closePriceBuy = g_bbLower[0];
            g_closePriceSell = g_bbUpper[0];
            g_entryPriceBuy = g_bbUpper[0];
            g_entryPriceSell = g_bbLower[0];
         }
      }

      // exit price via stochastic cross (optional override for exit)
      if (g_stochK[1] > g_stochD[1] && g_stochK[0] < g_stochD[0] && g_stochK[0] > stochOverbought)
      {
         g_closePriceBuy = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         PrintFormat("OnTimer: BUY 決済価格を設定（Stoch） %.5f", g_closePriceBuy);
      }
      if (g_stochK[1] < g_stochD[1] && g_stochK[0] > g_stochD[0] && g_stochK[0] < stochOversold)
      {
         g_closePriceSell = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         PrintFormat("OnTimer: SELL 決済価格を設定（Stoch） %.5f", g_closePriceSell);
      }

      // 価格設定時に、実行可否フラグを同時に設定
      if (g_entryPriceBuy > 0)
         g_canEntryBuy = true;
      if (g_entryPriceSell > 0)
         g_canEntrySell = true;
      if (g_closePriceBuy > 0)
         g_canCloseBuy = true;
      if (g_closePriceSell > 0)
         g_canCloseSell = true;

      // M15 シグナルによるロット倍率決定（Compute内で判定）
      if (g_M15Signal.pendingNextM1 && !g_M15Signal.usedForEntry)
      {
         if (g_M15Signal.hasDiv)
         {
            if (g_M15Signal.divType == DIVERGENCE_BULLISH && g_entryPriceBuy > 0)
               g_M15LotMultiplier = 1.2;
            else if (g_M15Signal.divType == DIVERGENCE_BEARISH && g_entryPriceSell > 0)
               g_M15LotMultiplier = 1.2;
         }
         if (g_M15Signal.hasMACDCross)
         {
            if (g_M15Signal.macdCrossDir == 1 && g_entryPriceBuy > 0)
               g_M15LotMultiplier = MathMax(g_M15LotMultiplier, 1.15);
            else if (g_M15Signal.macdCrossDir == -1 && g_entryPriceSell > 0)
               g_M15LotMultiplier = MathMax(g_M15LotMultiplier, 1.15);
         }
         if (g_M15LotMultiplier != 1.0)
            PrintFormat("OnTimer: M15 シグナル適用倍率 = %.2f", g_M15LotMultiplier);
         // pendingNextM1 はここではクリアしない。OnTick が使用済みフラグを設定する
      }

      // エントリー価格と決済価格が矛盾するときは発注なし
      if (g_entryPriceBuy > 0 && g_closePriceBuy > 0 && g_entryPriceBuy >= g_closePriceBuy)
      {
         PrintFormat("OnTimer: BUY entry %.5f >= close %.5f -> entry中止", g_entryPriceBuy, g_closePriceBuy);
         g_entryPriceBuy = 0.0;
         g_canEntryBuy = false;
         g_entryThresholdCrossedBuy = false;
      }
      if (g_entryPriceSell > 0 && g_closePriceSell > 0 && g_entryPriceSell <= g_closePriceSell)
      {
         PrintFormat("OnTimer: SELL entry %.5f <= close %.5f -> entry中止", g_entryPriceSell, g_closePriceSell);
         g_entryPriceSell = 0.0;
         g_canEntrySell = false;
         g_entryThresholdCrossedSell = false;
      }

      // トレンド時はポジションに対してSLトレール更新
      if (h1Type != TREND_RANGE && h1Type != TREND_UNKNOWN)
      {
         for (int i = PositionsTotal() - 1; i >= 0; i--)
         {
            ulong ticket = PositionGetTicket(i);
            if (!PositionSelectByTicket(ticket)) continue;
            if (PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
            if (PositionGetInteger(POSITION_MAGIC) != (long)MagicNumber) continue;

            long ptype = PositionGetInteger(POSITION_TYPE);
            double currSL = PositionGetDouble(POSITION_SL);
            double newSL = currSL;
            if (ptype == POSITION_TYPE_BUY && g_superTrendDir[0] > 0)
            {
               newSL = g_superTrend[0];
               if (newSL > currSL)
                  ModifyPositionSLTP(ticket, newSL, PositionGetDouble(POSITION_TP));
            }
            else if (ptype == POSITION_TYPE_SELL && g_superTrendDir[0] < 0)
            {
               newSL = g_superTrend[0];
               if (newSL < currSL)
                  ModifyPositionSLTP(ticket, newSL, PositionGetDouble(POSITION_TP));
            }
         }
      }

      // ログにエントリー／決済価格を出力
      PrintFormat("OnTimer: M1 ENTRY BUY=%.5f SELL=%.5f  EXIT BUY=%.5f SELL=%.5f",
               g_entryPriceBuy, g_entryPriceSell, g_closePriceBuy, g_closePriceSell);
      PrintFormat("CTrend1M: 判定変数 g_entryThresholdCrossedBuy=%d g_entryThresholdCrossedSell=%d g_M15LotMultiplier=%.2f",
               g_entryThresholdCrossedBuy ? 1 : 0, g_entryThresholdCrossedSell ? 1 : 0, g_M15LotMultiplier);
   }
};

// ===================================================================
// 取引関連の補助関数
// ===================================================================
bool SendMarketOrder(ENUM_ORDER_TYPE type, double volume, double sl, double tp, bool urgent = false)
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ask - bid) / _Point;
   if (spreadPts > MaxAllowedSpread)
   {
      PrintFormat("発注中止：スプレッドが大きすぎます (%.1f)", spreadPts);
      return (false);
   }
   if (!CanReq(urgent))
   {
      Print("発注中止：リクエスト制限により送信不可です。");
      return (false);
   }

   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.symbol = _Symbol;
   req.volume = volume;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.sl = sl;
   req.tp = tp;
   req.type = type;
   if (!OrderSend(req, res))
   {
      PrintFormat("OrderSend 失敗 err=%d retcode=%d comment=%s", GetLastError(), res.retcode, res.comment);
      return (false);
   }
   RegReq();
   PrintFormat("OrderSend 成功 type=%s ticket=%I64u order=%I64u deal=%I64u lot=%.2f price=%.5f retcode=%d comment=%s",
               type == ORDER_TYPE_BUY ? "BUY" : "SELL",
               res.order, res.order, res.deal, volume, res.price, res.retcode, res.comment);
   return (true);
}

// ===================================================================
// ポジションの決済と逆指値更新の補助関数
// ===================================================================
bool ClosePositionByTicket(ulong ticket)
{
   if (!PositionSelectByTicket(ticket))
      return (false);
   long ptype = PositionGetInteger(POSITION_TYPE);
   double vol = PositionGetDouble(POSITION_VOLUME);
   if (!CanReq(false))
   {
      Print("決済中止：リクエスト制限により送信不可です。");
      return (false);
   }

   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.position = ticket;
   req.symbol = _Symbol;
   req.volume = vol;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.type = (ptype == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
   if (!OrderSend(req, res))
   {
      PrintFormat("決済失敗 err=%d ret=%d", GetLastError(), res.retcode);
      return (false);
   }
   RegReq();
   PrintFormat("決済成功 ticket=%I64u deal=%I64u", ticket, res.order);
   return (true);
}

// ===================================================================
// ポジションの逆指値更新の補助関数
// ===================================================================
bool ModifyPositionSLTP(ulong ticket, double newSL, double newTP)
{
   if (!trade.PositionModify(ticket, newSL, newTP))
   {
      PrintFormat("逆指値更新失敗 err=%d", GetLastError());
      return (false);
   }
   RegReq();
   PrintFormat("逆指値更新 成功 ticket=%I64u", ticket);
   return (true);
}

