bool WriteAnalysisEvent(SAnalysisRecord &detailedRecord, bool writeDetailed,
                        bool &detailedWritten, SLightAnalysisRecord &lightRecord,
                        bool writeLight, bool &lightAttempted, bool &lightWritten)
{
