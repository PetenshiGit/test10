string AnalysisNumber(double value, int digits)
{
   if (!MathIsValidNumber(value) || value == EMPTY_VALUE)
      return "";
   return DoubleToString(value, digits);
}

string AnalysisDateTime(datetime value)
{
   if (value <= 0)
      return "";
