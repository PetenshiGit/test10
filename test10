void PushReq(ulong t)
{
   if (ReqCount < REQ_CAP)
      ReqTimes[ReqCount++] = t;
   else
   {
      for (int i = 1; i < ReqCount; i++)
         ReqTimes[i - 1] = ReqTimes[i];
      ReqTimes[ReqCount - 1] = t;
   }
}
int CountReqSince(ulong window_ms)
{
   if (ReqCount == 0)
      return 0;
   ulong now = NowMs();
   int cnt = 0;
   for (int i = ReqCount - 1; i >= 0; i--)
   {
      if (now - ReqTimes[i] <= window_ms)
         cnt++;
      else
         break;
   }
   return (cnt);
}
bool CanReq(bool urgent = false)
{
   int window = RequestWindowMS();
   if (urgent)
      window = MathMax(200, RequestWindowMS() / 2);
   return (CountReqSince(window) < RequestLimitCount());
}
void RegReq()
{
   PushReq(NowMs());
}

int RequestLimitCount()
{
   return 20;
}

int RequestWindowMS()
{
   return 2000;
}

void AddTradeHistoryTimestamp(datetime t)
{
   if (TradeHistorySize < MAX_HISTORY)
   {
      for (int i = TradeHistorySize; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
      TradeHistorySize++;
   }
   else
   {
      for (int i = MAX_HISTORY - 1; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
   }
}

// ===================================================================
// ダイバージェンス補助（14本・時系列・3点比較）
// ===================================================================
void CollectPeakIndices(const double &values[], int count, bool higherIsPeak, int maxPeaks, int &outIdx[])
{
   ArrayInitialize(outIdx, -1);
   int temp[32];
   int found = 0;
   ArrayInitialize(temp, -1);

   for (int i = 0; i < count && found < maxPeaks; i++)
   {
      bool isPeak = false;
      if (count == 1)
         isPeak = true;
      else if (i == 0)
         isPeak = (higherIsPeak ? values[i] >= values[i + 1] : values[i] <= values[i + 1]);
      else if (i == count - 1)
         isPeak = (higherIsPeak ? values[i] >= values[i - 1] : values[i] <= values[i - 1]);
      else
      {
         bool left = (higherIsPeak ? values[i] >= values[i - 1] : values[i] <= values[i - 1]);
         bool right = (higherIsPeak ? values[i] >= values[i + 1] : values[i] <= values[i + 1]);
         isPeak = left && right;
      }
      if (!isPeak)
         continue;

      if (found > 0 && i - temp[found - 1] <= 1)
      {
         temp[found - 1] = i;
      }
      else
      {
         temp[found++] = i;
      }
   }

   for (int i = 0; i < found && i < maxPeaks; i++)
      outIdx[i] = temp[i];
}

int GetDirectionFromPoints(const double values[], int points)
{
   if (points < 3)
      return 0;

   double a = values[0];
   double b = values[1];
   double c = values[2];
   if (a < b && b < c)
      return 1;
   if (a > b && b > c)
      return -1;
   return 0;
}

DivergenceType CheckDivergenceSeries(const double &price[], const double &indicator[], int count, bool useHighs)
{
   if (count < 3)
      return DIVERGENCE_NONE;

   int priceIdx[3];
   int indiIdx[3];
   ArrayInitialize(priceIdx, -1);
   ArrayInitialize(indiIdx, -1);
   CollectPeakIndices(price, count, useHighs, 3, priceIdx);
   CollectPeakIndices(indicator, count, useHighs, 3, indiIdx);

   int priceCount = 0;
   int indiCount = 0;
   for (int i = 0; i < 3; i++)
   {
      if (priceIdx[i] >= 0)
         priceCount++;
      if (indiIdx[i] >= 0)
         indiCount++;
   }
   if (priceCount < 3 || indiCount < 3)
      return DIVERGENCE_NONE;

   double priceValues[3];
   double indiValues[3];
   ArrayInitialize(priceValues, 0.0);
   ArrayInitialize(indiValues, 0.0);

   for (int i = 0; i < priceCount; i++)
   {
      if (priceIdx[i] < 0 || !IsDivergenceValueValid(price[priceIdx[i]]))
         return DIVERGENCE_NONE;
      priceValues[i] = price[priceIdx[i]];
   }
   for (int i = 0; i < indiCount; i++)
   {
      if (indiIdx[i] < 0 || !IsDivergenceValueValid(indicator[indiIdx[i]]))
         return DIVERGENCE_NONE;
      indiValues[i] = indicator[indiIdx[i]];
   }

   int priceDir = GetDirectionFromPoints(priceValues, priceCount);
   int indiDir = GetDirectionFromPoints(indiValues, indiCount);

   if (priceDir < 0 && indiDir > 0)
      return DIVERGENCE_BULLISH;
   if (priceDir > 0 && indiDir < 0)
      return DIVERGENCE_BEARISH;
   return DIVERGENCE_NONE;
}

// ===================================================================
// H1 用クラス
// ADX、DI、EMA を使ってトレンド/レンジ種別や方向性を判定する
// ===================================================================
class CTrend1H
{
private:
   TrendType m_type;
   TrendState m_state;
   double m_value;
   int h_adx;
   int h_emaS;
   int h_emaL;
public:
   CTrend1H() { m_type = TREND_UNKNOWN; m_state = STATE_UNKNOWN; m_value = 0.0; h_adx = h_emaS = h_emaL = INVALID_HANDLE; }
   void Init(int _h_adx, int _h_emaS, int _h_emaL) { h_adx = _h_adx; h_emaS = _h_emaS; h_emaL = _h_emaL; }
   bool Calculate()
   {
      datetime lastBar = iTime(_Symbol, PERIOD_H1, 0);
      if (lastBar <= 0)
         return(false);

      const int need = 3;
      double adxH1[3], diPlusH1[3], diMinusH1[3], emaShortH1[3], emaLongH1[3];
      ArrayInitialize(adxH1, EMPTY_VALUE);
      ArrayInitialize(diPlusH1, EMPTY_VALUE);
      ArrayInitialize(diMinusH1, EMPTY_VALUE);
      ArrayInitialize(emaShortH1, EMPTY_VALUE);
      ArrayInitialize(emaLongH1, EMPTY_VALUE);

      ArraySetAsSeries(adxH1, true);
      ArraySetAsSeries(diPlusH1, true);
      ArraySetAsSeries(diMinusH1, true);
      ArraySetAsSeries(emaShortH1, true);
      ArraySetAsSeries(emaLongH1, true);

      int copied_adx = CopyBuffer(h_adx, 0, 1, need, adxH1);
      int copied_dip = CopyBuffer(h_adx, 1, 1, need, diPlusH1);
      int copied_dim = CopyBuffer(h_adx, 2, 1, need, diMinusH1);
      int copied_emaS = CopyBuffer(h_emaS, 0, 1, need, emaShortH1);
      int copied_emaL = CopyBuffer(h_emaL, 0, 1, need, emaLongH1);

      if (copied_adx < need || copied_dip < need || copied_dim < need || copied_emaS < need || copied_emaL < need)
      {
         g_h1AllOk = false;
         g_h1_adx_ok = g_h1_dip_ok = g_h1_dim_ok = g_h1_emaS_ok = g_h1_emaL_ok = false;
         PrintFormat("1時間足指標取得失敗：ADX=%d DI+=%d DI-=%d EMA短=%d EMA長=%d", copied_adx, copied_dip, copied_dim, copied_emaS, copied_emaL);
         return(false);
      }

      double adxNew = adxH1[0];
      double adxMid = adxH1[1];
      double adxOld = adxH1[2];
      double dipNew = diPlusH1[0];
      double dimNew = diMinusH1[0];
      double emaSNew = emaShortH1[0];
      double emaLNew = emaLongH1[0];

      if (!IsIndicatorValueValid(adxNew) || !IsIndicatorValueValid(adxMid) || !IsIndicatorValueValid(adxOld) || !IsIndicatorValueValid(dipNew) || !IsIndicatorValueValid(dimNew) || !IsIndicatorValueValid(emaSNew) || !IsIndicatorValueValid(emaLNew))
      {
         g_h1AllOk = false;
         g_h1_adx_ok = g_h1_dip_ok = g_h1_dim_ok = g_h1_emaS_ok = g_h1_emaL_ok = false;
         return(false);
      }

      g_h1AllOk = true;
      g_h1_adx_ok = g_h1_dip_ok = g_h1_dim_ok = g_h1_emaS_ok = g_h1_emaL_ok = true;
      g_lastValidH1BarTime = iTime(_Symbol, PERIOD_H1, 1);
      double diDiff = MathAbs(dipNew - dimNew);

      int diDir = 0;
      if (dipNew > dimNew && diDiff >= diThreshold)
         diDir = 1;
      else if (dimNew > dipNew && diDiff >= diThreshold)
         diDir = -1;

      int emaDir = 0;
      if (emaSNew > emaLNew)
         emaDir = 1;
      else if (emaSNew < emaLNew)
         emaDir = -1;

      if (adxNew < adxRangeThreshold)
         m_type = TREND_RANGE;
      else if (adxNew >= adxStrongThreshold)
      {
         if (diDir == 1)
            m_type = TREND_STRONG_UP;
         else if (diDir == -1)
            m_type = TREND_STRONG_DOWN;
         else
            m_type = TREND_UNKNOWN;
      }
      else if (adxNew >= adxThreshold)
      {
         if (diDir == 1)
            m_type = TREND_WEAK_UP;
         else if (diDir == -1)
            m_type = TREND_WEAK_DOWN;
         else
            m_type = TREND_UNKNOWN;
      }
      else
         m_type = TREND_UNKNOWN;

      if (adxOld >= 25 && adxMid >= 25 && adxNew >= 25)
      {
         if (adxOld < adxMid && adxMid < adxNew)
            m_state = TREND_ACCELERATE;
         else if (adxOld > adxMid && adxMid > adxNew)
            m_state = TREND_DECELERATE;
         else
            m_state = TREND_MAINTAIN;
      }
      else if (adxOld < 25 && adxMid < 25 && adxNew >= 25)
         m_state = RANGE_TO_TREND;
      else if (adxOld >= 18 && adxMid >= 18 && adxNew < 18)
         m_state = TREND_TO_RANGE;
      else if (adxOld < 18 && adxMid < 18 && adxNew < 18)
         m_state = RANGE_MAINTAIN;
      else
         m_state = STATE_UNKNOWN;

      m_value = adxNew;
      
      // H1 DI方向と EMA方向をグローバル変数に保存（追撃判定で使用）
      g_H1DiDir = diDir;
      g_H1EmaDir = emaDir;
      
      PrintFormat("H1判定 ADX[1]=%.3f ADX[2]=%.3f ADX[3]=%.3f DI+=%.3f DI-=%.3f DI差=%.3f EMA短=%.5f EMA長=%.5f DiDir=%d EmaDir=%d Type=%s State=%s",
                  adxNew, adxMid, adxOld, dipNew, dimNew, diDiff, emaSNew, emaLNew, diDir, emaDir, TrendTypeToString(m_type), TrendStateToString(m_state));
      return(true);
   }
   TrendType getType() const { return(m_type); }
   TrendState getState() const { return(m_state); }
   double getValue() const { return(m_value); }
};

// ===================================================================
// M15 用クラス
// RSI と MACD を常時取得・判定し、ダイバージェンスを別々に保持する
// ===================================================================
class CTrend15
{
private:
   TrendState m_state;
   OverheatType m_overheat;
   DivergenceType m_rsiDiv;
   DivergenceType m_macdDiv;
   double m_value;
   bool m_macdCross;
   int m_macdCrossDir;
   double m_rsiValue;
   double m_macdMain;
   double m_macdSignal;
   double m_macdHist;
   int rsiH, macdH;
public:
   CTrend15() { m_state = STATE_UNKNOWN; m_overheat = OVERHEAT_NONE; m_rsiDiv = DIVERGENCE_NONE; m_macdDiv = DIVERGENCE_NONE; m_value = 0.0; m_macdCross = false; m_macdCrossDir = 0; m_rsiValue = 0.0; m_macdMain = m_macdSignal = m_macdHist = 0.0; rsiH = macdH = INVALID_HANDLE; }
   void Init(int _rsiH, int _macdH) { rsiH = _rsiH; macdH = _macdH; }
   bool Calculate(TrendType h1Type, datetime barTime)
   {
      datetime lastBar = iTime(_Symbol, PERIOD_M15, 0);
      if (lastBar <= 0)
         return(false);

      const int need = 3;
      double rsiBuffer[3], mainBuffer[3], sigBuffer[3];
      ArrayInitialize(rsiBuffer, EMPTY_VALUE);
      ArrayInitialize(mainBuffer, EMPTY_VALUE);
      ArrayInitialize(sigBuffer, EMPTY_VALUE);
      ArraySetAsSeries(rsiBuffer, true);
      ArraySetAsSeries(mainBuffer, true);
      ArraySetAsSeries(sigBuffer, true);

      int copied_rsi = CopyBuffer(rsiH, 0, 1, need, rsiBuffer);
      int copied_main = CopyBuffer(macdH, 0, 1, need, mainBuffer);
      int copied_sig = CopyBuffer(macdH, 1, 1, need, sigBuffer);
      if (copied_rsi < need || copied_main < need || copied_sig < need)
      {
         g_m15AllOk = false;
         g_m15_rsi_ok = g_m15_macd_ok = false;
         PrintFormat("15分足指標取得失敗：RSI=%d MACD_Main=%d MACD_Sig=%d", copied_rsi, copied_main, copied_sig);
         return(false);
      }

      double latestRsi = rsiBuffer[0];
      double latestMacdMain = mainBuffer[0];
      double latestMacdSig = sigBuffer[0];
      double latestMacdHist = latestMacdMain - latestMacdSig;
      double prevMacdMain = mainBuffer[1];
      double prevMacdSig = sigBuffer[1];

      if (!IsIndicatorValueValid(latestRsi) || !IsIndicatorValueValid(latestMacdMain) || !IsIndicatorValueValid(latestMacdSig) || !IsIndicatorValueValid(prevMacdMain) || !IsIndicatorValueValid(prevMacdSig))
      {
         g_m15AllOk = false; g_m15_rsi_ok = g_m15_macd_ok = false; return(false);
      }

      g_m15AllOk = true;
      g_m15_rsi_ok = g_m15_macd_ok = true;
      g_lastValidM15BarTime = iTime(_Symbol, PERIOD_M15, 1);

      m_rsiValue = latestRsi;
      m_macdMain = latestMacdMain;
      m_macdSignal = latestMacdSig;
      m_macdHist = latestMacdHist;
      m_overheat = OVERHEAT_NONE;
      if (latestRsi >= 70.0)
         m_overheat = OVERHEAT_OVERBOUGHT;
      else if (latestRsi <= 30.0)
         m_overheat = OVERHEAT_OVERSOLD;

      m_macdCross = false;
      m_macdCrossDir = 0;
      if (prevMacdMain <= prevMacdSig && latestMacdMain > latestMacdSig)
      {
         m_macdCross = true;
         m_macdCrossDir = 1;
      }
      else if (prevMacdMain >= prevMacdSig && latestMacdMain < latestMacdSig)
      {
         m_macdCross = true;
         m_macdCrossDir = -1;
      }

      double priceHigh[], priceLow[];
      double rsiSeries[];
      ArrayResize(priceHigh, DIVERGENCE_PERIOD);
      ArrayResize(priceLow, DIVERGENCE_PERIOD);
      ArrayResize(rsiSeries, DIVERGENCE_PERIOD);
      ArrayInitialize(priceHigh, 0.0);
      ArrayInitialize(priceLow, 0.0);
      ArrayInitialize(rsiSeries, 0.0);

      // M15 ダイバージェンス対象は bar[1] ～ bar[14] の直近14本の確定足を使用する。
      bool priceOk = CopyHigh(_Symbol, PERIOD_M15, 1, DIVERGENCE_PERIOD, priceHigh) == DIVERGENCE_PERIOD && CopyLow(_Symbol, PERIOD_M15, 1, DIVERGENCE_PERIOD, priceLow) == DIVERGENCE_PERIOD;
      bool rsiOk = CopyBuffer(rsiH, 0, 1, DIVERGENCE_PERIOD, rsiSeries) == DIVERGENCE_PERIOD;
      if (priceOk && rsiOk)
      {
         ArraySetAsSeries(priceHigh, true);
         ArraySetAsSeries(priceLow, true);
         ArraySetAsSeries(rsiSeries, true);
         double rsiChrono[DIVERGENCE_PERIOD];
         double highChrono[DIVERGENCE_PERIOD];
         double lowChrono[DIVERGENCE_PERIOD];
         for (int i = 0; i < DIVERGENCE_PERIOD; i++)
         {
            rsiChrono[i] = rsiSeries[DIVERGENCE_PERIOD - 1 - i];
            highChrono[i] = priceHigh[DIVERGENCE_PERIOD - 1 - i];
            lowChrono[i] = priceLow[DIVERGENCE_PERIOD - 1 - i];
         }

         DivergenceType rsiHigh = CheckDivergenceSeries(highChrono, rsiChrono, DIVERGENCE_PERIOD, true);
         DivergenceType rsiLow = CheckDivergenceSeries(lowChrono, rsiChrono, DIVERGENCE_PERIOD, false);
         if ((rsiHigh == DIVERGENCE_BEARISH && rsiLow == DIVERGENCE_BULLISH) || (rsiHigh == DIVERGENCE_BULLISH && rsiLow == DIVERGENCE_BEARISH))
            m_rsiDiv = DIVERGENCE_CONFLICT;
         else if (rsiHigh != DIVERGENCE_NONE)
            m_rsiDiv = rsiHigh;
         else if (rsiLow != DIVERGENCE_NONE)
            m_rsiDiv = rsiLow;
         else
            m_rsiDiv = DIVERGENCE_NONE;
      }
      else
      {
         m_rsiDiv = DIVERGENCE_NONE;
      }

      double macdMainAll[], macdSigAll[];
      ArrayResize(macdMainAll, DIVERGENCE_PERIOD);
      ArrayResize(macdSigAll, DIVERGENCE_PERIOD);
      ArrayInitialize(macdMainAll, 0.0);
      ArrayInitialize(macdSigAll, 0.0);
      bool macdOk = CopyBuffer(macdH, 0, 1, DIVERGENCE_PERIOD, macdMainAll) == DIVERGENCE_PERIOD && CopyBuffer(macdH, 1, 1, DIVERGENCE_PERIOD, macdSigAll) == DIVERGENCE_PERIOD;
      if (priceOk && macdOk)
      {
         ArraySetAsSeries(macdMainAll, true);
         ArraySetAsSeries(macdSigAll, true);
         double histChrono[DIVERGENCE_PERIOD];
         double highChrono[DIVERGENCE_PERIOD];
         double lowChrono[DIVERGENCE_PERIOD];
         for (int i = 0; i < DIVERGENCE_PERIOD; i++)
         {
            histChrono[i] = macdMainAll[DIVERGENCE_PERIOD - 1 - i] - macdSigAll[DIVERGENCE_PERIOD - 1 - i];
            highChrono[i] = priceHigh[DIVERGENCE_PERIOD - 1 - i];
            lowChrono[i] = priceLow[DIVERGENCE_PERIOD - 1 - i];
         }

         DivergenceType macdHigh = CheckDivergenceSeries(highChrono, histChrono, DIVERGENCE_PERIOD, true);
         DivergenceType macdLow = CheckDivergenceSeries(lowChrono, histChrono, DIVERGENCE_PERIOD, false);
         if ((macdHigh == DIVERGENCE_BEARISH && macdLow == DIVERGENCE_BULLISH) || (macdHigh == DIVERGENCE_BULLISH && macdLow == DIVERGENCE_BEARISH))
            m_macdDiv = DIVERGENCE_CONFLICT;
         else if (macdHigh != DIVERGENCE_NONE)
            m_macdDiv = macdHigh;
         else if (macdLow != DIVERGENCE_NONE)
            m_macdDiv = macdLow;
         else
            m_macdDiv = DIVERGENCE_NONE;
      }
      else
      {
         m_macdDiv = DIVERGENCE_NONE;
      }

      if (latestMacdHist > 0)
         m_state = TREND_ACCELERATE;
      else if (latestMacdHist < 0)
         m_state = TREND_DECELERATE;
      else
         m_state = TREND_MAINTAIN;

      m_value = latestRsi;
      g_M15RsiDivergence = m_rsiDiv;
      g_M15MacdDivergence = m_macdDiv;
      g_OverheatM15 = m_overheat;

      bool hasActualDivergence = HasActualDivergence(m_rsiDiv) || HasActualDivergence(m_macdDiv);
      bool hasSignal = (hasActualDivergence || m_macdCross);
      if (hasSignal)
      {
         g_M15Signal.barTime = barTime;
         g_M15Signal.expireM1BarTime = iTime(_Symbol, PERIOD_M1, 0) + PeriodSeconds(PERIOD_M1);
         g_M15Signal.hasDiv = hasActualDivergence;
         if (HasActualDivergence(m_rsiDiv))
            g_M15Signal.divType = m_rsiDiv;
         else if (HasActualDivergence(m_macdDiv))
            g_M15Signal.divType = m_macdDiv;
         else
            g_M15Signal.divType = DIVERGENCE_NONE;
         g_M15Signal.hasMACDCross = m_macdCross;
         g_M15Signal.macdCrossDir = m_macdCrossDir;
         g_M15Signal.pendingNextM1 = true;
         g_M15Signal.usedForEntry = false;
         g_M15Signal.usedForClose = false;
      }
      else
      {
         g_M15Signal.pendingNextM1 = false;
      }

      PrintFormat("M15更新 RSI=%.3f MACD Main=%.5f Signal=%.5f Hist=%.5f Cross=%s RSI Div=%s MACD Div=%s Overheat=%s",
                  latestRsi, latestMacdMain, latestMacdSig, latestMacdHist, m_macdCross ? "YES" : "NO", DivergenceTypeToString(m_rsiDiv), DivergenceTypeToString(m_macdDiv), OverheatTypeToString(m_overheat));
      return(true);
   }
   TrendState getState() const { return (m_state); }
   OverheatType getOverheat() const { return (m_overheat); }
   DivergenceType getRsiDivergence() const { return (m_rsiDiv); }
   DivergenceType getMacdDivergence() const { return (m_macdDiv); }
   double getValue() const { return (m_value); }
   bool   getMACDCross() const { return (m_macdCross); }
   int    getMACDCrossDir() const { return (m_macdCrossDir); }
};

// ===================================================================
// M1 用クラス
// ボリンジャーバンド、ストキャスティクス、ATR、スーパートレンドを使って取引タイミングを計る
// ===================================================================
class CTrend1M
{
private:
   int h_bb;
   int h_stoch;
   int h_atr;
   int h_std;
public:
   CTrend1M() { h_bb = h_stoch = h_atr = h_std = INVALID_HANDLE; }
   void Init(int _h_bb, int _h_stoch, int _h_atr, int _h_std) { h_bb = _h_bb; h_stoch = _h_stoch; h_atr = _h_atr; h_std = _h_std; }
   bool Calculate()
   {
      datetime lastBar = iTime(_Symbol, PERIOD_M1, 0);
      if (lastBar <= 0)
         return(false);

      const int need = CACHE_BARS;
      double midBuffer[CACHE_BARS], upperBuffer[CACHE_BARS], lowerBuffer[CACHE_BARS], kBuffer[CACHE_BARS], dBuffer[CACHE_BARS], atrBuffer[CACHE_BARS];
      ArrayInitialize(midBuffer, EMPTY_VALUE);
      ArrayInitialize(upperBuffer, EMPTY_VALUE);
      ArrayInitialize(lowerBuffer, EMPTY_VALUE);
      ArrayInitialize(kBuffer, EMPTY_VALUE);
      ArrayInitialize(dBuffer, EMPTY_VALUE);
      ArrayInitialize(atrBuffer, EMPTY_VALUE);
      ArraySetAsSeries(midBuffer, true);
      ArraySetAsSeries(upperBuffer, true);
      ArraySetAsSeries(lowerBuffer, true);
      ArraySetAsSeries(kBuffer, true);
      ArraySetAsSeries(dBuffer, true);
      ArraySetAsSeries(atrBuffer, true);

      int copied_mid = CopyBuffer(h_bb, 0, 1, need, midBuffer);
      int copied_upper = CopyBuffer(h_bb, 1, 1, need, upperBuffer);
      int copied_lower = CopyBuffer(h_bb, 2, 1, need, lowerBuffer);
      int copied_k = CopyBuffer(h_stoch, 0, 1, need, kBuffer);
      int copied_d = CopyBuffer(h_stoch, 1, 1, need, dBuffer);
      int copied_atr = CopyBuffer(h_atr, 0, 1, need, atrBuffer);

      if (copied_mid < need || copied_upper < need || copied_lower < need || copied_k < need || copied_d < need || copied_atr < need)
      {
         g_m1AllOk = false;
         g_m1_bb_ok = g_m1_std_ok = g_m1_stoch_ok = g_m1_atr_ok = false;
         PrintFormat("1分足指標取得失敗：BB中=%d BB上=%d BB下=%d K=%d D=%d ATR=%d", copied_mid, copied_upper, copied_lower, copied_k, copied_d, copied_atr);
         return(false);
      }

      if (!IsIndicatorValueValid(midBuffer[0]) || !IsIndicatorValueValid(upperBuffer[0]) || !IsIndicatorValueValid(lowerBuffer[0]) || !IsIndicatorValueValid(kBuffer[0]) || !IsIndicatorValueValid(dBuffer[0]) || !IsIndicatorValueValid(atrBuffer[0]))
      {
         g_m1AllOk = false; g_m1_bb_ok = g_m1_std_ok = g_m1_stoch_ok = g_m1_atr_ok = false; return(false);
      }

      g_m1AllOk = true;
      g_m1_bb_ok = g_m1_std_ok = g_m1_stoch_ok = g_m1_atr_ok = true;
      g_lastValidM1BarTime = iTime(_Symbol, PERIOD_M1, 1);

      for (int i = 0; i < need; i++)
      {
         g_bbMiddle[i] = midBuffer[i];
         g_bbUpper[i] = upperBuffer[i];
         g_bbLower[i] = lowerBuffer[i];
      }
      g_stochK[0] = kBuffer[0];
      g_stochD[0] = dBuffer[0];
      g_atr[0] = atrBuffer[0];

      double prevClose = iClose(_Symbol, PERIOD_M1, 1);
      double currClose = iClose(_Symbol, PERIOD_M1, 1);
      double hl2 = (iHigh(_Symbol, PERIOD_M1, 1) + iLow(_Symbol, PERIOD_M1, 1)) / 2.0;
      double upperBand = hl2 + atrMultiplierSL * atrBuffer[0];
      double lowerBand = hl2 - atrMultiplierSL * atrBuffer[0];
      for (int i = need - 1; i > 0; i--)
      {
         g_superTrend[i] = g_superTrend[i - 1];
         g_superTrendDir[i] = g_superTrendDir[i - 1];
      }

      double trendValue = g_superTrend[1];
      int prevDir = (g_superTrendDir[1] > 0) ? 1 : ((g_superTrendDir[1] < 0) ? -1 : 0);
      if (prevDir > 0)
      {
         g_superTrend[0] = MathMin(trendValue, upperBand);
         g_superTrendDir[0] = (currClose > g_superTrend[0]) ? 1 : -1;
      }
      else if (prevDir < 0)
      {
         g_superTrend[0] = MathMax(trendValue, lowerBand);
         g_superTrendDir[0] = (currClose < g_superTrend[0]) ? -1 : 1;
      }
      else
      {
         if (currClose > upperBand)
         {
            g_superTrend[0] = upperBand;
            g_superTrendDir[0] = 1;
         }
         else if (currClose < lowerBand)
         {
            g_superTrend[0] = lowerBand;
            g_superTrendDir[0] = -1;
         }
         else
         {
            g_superTrend[0] = hl2;
            g_superTrendDir[0] = 0;
         }
      }

      PrintFormat("M1更新 BB上=%.5f BB中=%.5f BB下=%.5f StochK=%.3f StochD=%.3f SuperTrend=%.5f Dir=%d", g_bbUpper[0], g_bbMiddle[0], g_bbLower[0], g_stochK[0], g_stochD[0], g_superTrend[0], g_superTrendDir[0]);
      return(true);
   }

   void ComputeEntryExit(TrendType h1Type)
   {
      g_closePriceBuy = 0.0;
      g_closePriceSell = 0.0;
      g_entryPriceBuy = 0.0;
      g_entryPriceSell = 0.0;
      g_canEntryBuy = false;
      g_canEntrySell = false;
      g_canCloseBuy = false;
      g_canCloseSell = false;
      g_entryThresholdCrossedBuy = false;
      g_entryThresholdCrossedSell = false;
      g_closeThresholdCrossedBuy = false;
      g_closeThresholdCrossedSell = false;
      g_M15LotMultiplier = 1.0;

      if (h1Type == TREND_RANGE)
      {
         g_entryPriceBuy = g_bbLower[0];
         g_entryPriceSell = g_bbUpper[0];
         g_closePriceBuy = g_bbUpper[0];
         g_closePriceSell = g_bbLower[0];
         g_entryBuyOnOrBelow = true;
         g_entrySellOnOrAbove = true;
         g_closeBuyOnOrAbove = false;
         g_closeSellOnOrBelow = false;
      }
      else if (h1Type == TREND_UNKNOWN)
      {
         g_entryPriceBuy = 0.0;
         g_entryPriceSell = 0.0;
         g_closePriceBuy = 0.0;
         g_closePriceSell = 0.0;
         g_canEntryBuy = false;
         g_canEntrySell = false;
         g_canCloseBuy = false;
         g_canCloseSell = false;
      }
      else
      {
         g_entryPriceBuy = g_superTrend[0];
         g_entryPriceSell = g_superTrend[0];
         g_closePriceBuy = g_superTrend[0];
         g_closePriceSell = g_superTrend[0];
         g_entryBuyOnOrBelow = false;
         g_entrySellOnOrAbove = false;
         g_closeBuyOnOrAbove = false;
         g_closeSellOnOrBelow = false;
      }

      if (g_stochK[0] > g_stochD[0] && g_stochK[0] > stochOverbought)
         g_closePriceBuy = g_bbUpper[0];
      if (g_stochK[0] < g_stochD[0] && g_stochK[0] < stochOversold)
         g_closePriceSell = g_bbLower[0];

      if (h1Type == TREND_RANGE)
      {
         g_closeBuyOnOrAbove = true;
         g_closeSellOnOrBelow = true;
      }
      else
      {
         g_closeBuyOnOrAbove = false;
         g_closeSellOnOrBelow = false;
      }

      if (g_entryPriceBuy > 0.0)
         g_canEntryBuy = true;
      if (g_entryPriceSell > 0.0)
         g_canEntrySell = true;
      if (g_closePriceBuy > 0.0)
         g_canCloseBuy = true;
      if (g_closePriceSell > 0.0)
         g_canCloseSell = true;

      if (g_M15Signal.pendingNextM1)
      {
         g_M15LotMultiplier = 1.0;
      }
      if (!g_h1AllOk || !g_m15AllOk || !g_m1AllOk)
      {
         g_canEntryBuy = false; g_canEntrySell = false; g_canCloseBuy = false; g_canCloseSell = false;
      }

      if (g_entryPriceBuy > 0.0 && g_closePriceBuy > 0.0 && g_entryPriceBuy > g_closePriceBuy)
      {
         g_entryPriceBuy = 0.0;
         g_canEntryBuy = false;
      }
      if (g_entryPriceSell > 0.0 && g_closePriceSell > 0.0 && g_entryPriceSell < g_closePriceSell)
      {
         g_entryPriceSell = 0.0;
         g_canEntrySell = false;
      }

      if (h1Type != TREND_RANGE && h1Type != TREND_UNKNOWN)
      {
         for (int i = PositionsTotal() - 1; i >= 0; i--)
         {
            ulong ticket = PositionGetTicket(i);
            if (!PositionSelectByTicket(ticket))
               continue;
            if (PositionGetString(POSITION_SYMBOL) != _Symbol)
               continue;
            if ((long)PositionGetInteger(POSITION_MAGIC) != (long)MagicNumber)
               continue;
            long ptype = PositionGetInteger(POSITION_TYPE);
            double currSL = PositionGetDouble(POSITION_SL);
            double newSL = currSL;
            if (ptype == POSITION_TYPE_BUY && g_superTrendDir[0] > 0)
            {
               newSL = g_superTrend[0];
               if (newSL > currSL)
                  ModifyPositionSLTP(ticket, newSL, PositionGetDouble(POSITION_TP));
            }
            else if (ptype == POSITION_TYPE_SELL && g_superTrendDir[0] < 0)
            {
               newSL = g_superTrend[0];
               if (newSL < currSL)
                  ModifyPositionSLTP(ticket, newSL, PositionGetDouble(POSITION_TP));
            }
         }
      }

      PrintFormat("OnTimer: M1 ENTRY BUY=%.5f SELL=%.5f EXIT BUY=%.5f SELL=%.5f", g_entryPriceBuy, g_entryPriceSell, g_closePriceBuy, g_closePriceSell);
   }
};

// ===================================================================
// 取引関連の補助関数
// ===================================================================
bool SendMarketOrder(ENUM_ORDER_TYPE type, double volume, double sl, double tp, bool urgent = false)
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ask - bid) / _Point;
   if (spreadPts > MaxAllowedSpread)
   {
      PrintFormat("発注中止：スプレッドが大きすぎます (%.1f)", spreadPts);
      return (false);
   }
   if (!CanReq(urgent))
   {
      Print("発注中止：リクエスト制限により送信不可です。");
      return (false);
   }

   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.symbol = _Symbol;
   req.volume = volume;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.sl = sl;
   req.tp = tp;
   req.type = type;
   if (!OrderSend(req, res) || (res.retcode != TRADE_RETCODE_DONE && res.retcode != TRADE_RETCODE_DONE_PARTIAL))
   {
      PrintFormat("OrderSend 失敗 err=%d retcode=%d comment=%s", GetLastError(), res.retcode, res.comment);
      return (false);
   }
   RegReq();
   PrintFormat("OrderSend 成功 type=%s ticket=%I64u order=%I64u deal=%I64u lot=%.2f price=%.5f retcode=%d comment=%s",
               type == ORDER_TYPE_BUY ? "BUY" : "SELL",
               res.order, res.order, res.deal, volume, res.price, res.retcode, res.comment);
   return (true);
}

// ===================================================================
// ポジションの決済と逆指値更新の補助関数
// ===================================================================
bool ClosePositionByTicket(ulong ticket)
{
   if (!PositionSelectByTicket(ticket))
      return (false);
   long ptype = PositionGetInteger(POSITION_TYPE);
   double vol = PositionGetDouble(POSITION_VOLUME);
   if (!CanReq(false))
   {
      Print("決済中止：リクエスト制限により送信不可です。");
      return (false);
   }

   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.position = ticket;
   req.symbol = _Symbol;
   req.volume = vol;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.type = (ptype == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
   if (!OrderSend(req, res) || (res.retcode != TRADE_RETCODE_DONE && res.retcode != TRADE_RETCODE_DONE_PARTIAL))
   {
      PrintFormat("決済失敗 err=%d ret=%d", GetLastError(), res.retcode);
      return (false);
   }
   RegReq();
   PrintFormat("決済成功 ticket=%I64u deal=%I64u", ticket, res.order);
   return (true);
}

// ===================================================================
// ポジションの逆指値更新の補助関数
// ===================================================================
bool ModifyPositionSLTP(ulong ticket, double newSL, double newTP)
{
   if (!trade.PositionModify(ticket, newSL, newTP))
   {
      PrintFormat("逆指値更新失敗 err=%d", GetLastError());
      return (false);
   }
   RegReq();
   PrintFormat("逆指値更新 成功 ticket=%I64u", ticket);
   return (true);
}

