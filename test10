//+------------------------------------------------------------------+
//| Expert deinitialization function                                 |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   ProcessPendingTradeEvents();
   CloseLightAnalysisCsv();
   FlushPendingAtr2Records();
   if (EnableAnalysisCsv && ArraySize(g_pendingTradeEvents) > 0)
      PrintFormat("未処理の取引Dealイベントが終了時に残っています。件数=%d", ArraySize(g_pendingTradeEvents));
   if (EnableAnalysisCsv && ArraySize(g_pendingAtr2Records) > 0)
      Print("未書き込みのATR2レコードが終了時に残っています。");
   if (EnableAnalysisCsv)
   {
      SAnalysisRecord endAnalysis;
      ResetAnalysisRecord(endAnalysis, "OTHER_ANALYSIS");
      SetAnalysisContext(endAnalysis, TimeCurrent(), AnalysisCurrentTimeMsc());
      endAnalysis.values[AC_REASON] = "EA deinitialized";
      endAnalysis.values[AC_REASON_DETAIL] =
         "ReasonCode=" + IntegerToString(reason) +
         ";PendingDeals=" + IntegerToString(ArraySize(g_pendingTradeEvents)) +
         ";PendingATR2=" + (ArraySize(g_pendingAtr2Records) > 0 ? "true" : "false");
      WriteAnalysisRecord(endAnalysis);
   }

   if (h_adx != INVALID_HANDLE) IndicatorRelease(h_adx);
   if (h_emaS != INVALID_HANDLE) IndicatorRelease(h_emaS);
   if (h_emaL != INVALID_HANDLE) IndicatorRelease(h_emaL);
   if (h_rsi != INVALID_HANDLE) IndicatorRelease(h_rsi);
   if (h_macd != INVALID_HANDLE) IndicatorRelease(h_macd);
   if (h_bb != INVALID_HANDLE) IndicatorRelease(h_bb);
   if (h_stoch != INVALID_HANDLE) IndicatorRelease(h_stoch);
   if (h_atr != INVALID_HANDLE) IndicatorRelease(h_atr);

   EventKillTimer();
   Comment("");
   if (EnableAnalysisCsv)
   {
      SAnalysisRecord positionAnalysis;
      ResetAnalysisRecord(positionAnalysis, "POSITION_SUMMARY");
      SetAnalysisContext(positionAnalysis, TimeCurrent(), AnalysisCurrentTimeMsc());
      positionAnalysis.values[AC_REASON] = "Positions at deinitialization";
      positionAnalysis.values[AC_SAME_DIRECTION_COUNT] = IntegerToString(PositionsTotal());
      WriteAnalysisRecord(positionAnalysis);
      FlushTradeTickHistoryToCsv();
   }
   if (g_analysisFile != INVALID_HANDLE)
   {
      FileFlush(g_analysisFile);
      FileClose(g_analysisFile);
      g_analysisFile = INVALID_HANDLE;
      g_currentAnalysisCsvFileName = "";
   }
   if (g_requestCsvFile != INVALID_HANDLE)
   {
      FileFlush(g_requestCsvFile);
      FileClose(g_requestCsvFile);
      g_requestCsvFile = INVALID_HANDLE;
   }
   if (EnableAnalysisCsv)
      PrintFormat("解析CSV書き込み件数：成功=%I64d 失敗=%I64d 未処理Deal=%d ATR2保留=%s",
                  g_analysisWriteSuccessCount, g_analysisWriteFailureCount,
                  ArraySize(g_pendingTradeEvents),
                  ArraySize(g_pendingAtr2Records) > 0 ? "true" : "false");
}

