bool ModifyPositionSLTP(ulong ticket, double newSL, double newTP)
{
   if (!PositionSelectByTicket(ticket))
      return(false);
   long ptype = PositionGetInteger(POSITION_TYPE);
   double currentSL = PositionGetDouble(POSITION_SL);
   double currentPrice = ptype == POSITION_TYPE_BUY ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   datetime requestTime = GetRequestServerTime();
   if (!CanSendSLTPRequest(requestTime))
      return false;
   bool sent = trade.PositionModify(ticket, newSL, newTP);
   uint retcode = trade.ResultRetcode();
   RequestEvaluation evaluation = !sent ? REQUEST_SEND_FAILED :
      (retcode == TRADE_RETCODE_DONE ? REQUEST_EXECUTION_SUCCEEDED : REQUEST_EXECUTION_FAILED);
   RecordRequest("ポジションSL/TP変更", evaluation, retcode, requestTime);
   if (!sent)
   {
      PrintFormat("SL更新失敗 ticket=%I64u type=%s currentSL=%.5f newSL=%.5f price=%.5f retcode=%d comment=%s err=%d", ticket, ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", currentSL, newSL, currentPrice, retcode, trade.ResultComment(), GetLastError());
      return (false);
   }
   if (retcode != TRADE_RETCODE_DONE)
   {
      PrintFormat("SL更新実行失敗 ticket=%I64u type=%s currentSL=%.5f newSL=%.5f price=%.5f retcode=%d comment=%s err=%d", ticket, ptype == POSITION_TYPE_BUY ? "BUY" : "SELL", currentSL, newSL, currentPrice, retcode, trade.ResultComment(), GetLastError());
      return false;
   }
   if (EnableAnalysisCsv)
   {
      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "SL_UPDATE");
      SetAnalysisContext(analysis, requestTime, (long)requestTime * 1000L);
      analysis.values[AC_TICKET] = AnalysisLong((long)ticket);
      analysis.values[AC_POSITION] = AnalysisLong((long)ticket);
      analysis.values[AC_DIRECTION] = ptype == POSITION_TYPE_BUY ? "BUY" : "SELL";
      analysis.values[AC_PRICE] = AnalysisNumber(currentPrice, _Digits);
      analysis.values[AC_SL] = AnalysisNumber(newSL, _Digits);
      analysis.values[AC_REASON] = "Trailing Stop";
      analysis.values[AC_MAGIC_NUMBER] = AnalysisLong(MagicNumber);
      analysis.values[AC_RETCODE] = IntegerToString((int)retcode);
      analysis.values[AC_COMMENT] = trade.ResultComment();
      WriteAnalysisRecord(analysis);
   }
   return (true);
}

bool HasRangeMinProfitStop(ulong ticket)
{
   for (int i = 0; i < ArraySize(g_rangeMinProfitStopTickets); i++)
   {
      if (g_rangeMinProfitStopTickets[i] == ticket)
         return true;
   }
   return false;
}

void RegisterRangeMinProfitStop(ulong ticket)
{
   if (HasRangeMinProfitStop(ticket))
      return;
   int size = ArraySize(g_rangeMinProfitStopTickets);
   ArrayResize(g_rangeMinProfitStopTickets, size + 1);
   g_rangeMinProfitStopTickets[size] = ticket;
}

void UpdateRangeMinimumProfitStops()
{
   if (!g_h1AllOk || !g_m1AllOk)
      return;
   if (g_TrendTypeH != TREND_RANGE)
      return;

   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if (bid <= 0.0 || ask <= 0.0)
      return;

   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket) || PositionGetString(POSITION_SYMBOL) != _Symbol || (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      long ptype = PositionGetInteger(POSITION_TYPE);
      double entryPrice = PositionGetDouble(POSITION_PRICE_OPEN);
      double currentSL = PositionGetDouble(POSITION_SL);
      if (entryPrice <= 0.0)
         continue;
      if (HasRangeMinProfitStop(ticket))
         continue;

      double stopsLevelDistance = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
      if (ptype == POSITION_TYPE_BUY)
      {
         double targetSL = entryPrice + RangeMinProfitPoints * _Point;
         bool eligible = bid > targetSL && (bid - targetSL) >= stopsLevelDistance && currentSL < targetSL;
         if (!eligible)
            continue;
         double candidateSL = NormalizeDouble(targetSL, _Digits);
         if (candidateSL > currentSL && ModifyPositionSLTP(ticket, candidateSL, PositionGetDouble(POSITION_TP)))
            RegisterRangeMinProfitStop(ticket);
      }
      else if (ptype == POSITION_TYPE_SELL)
      {
         double targetSL = entryPrice - RangeMinProfitPoints * _Point;
         bool eligible = ask < targetSL && (targetSL - ask) >= stopsLevelDistance && currentSL > targetSL;
         if (!eligible)
            continue;
         double candidateSL = NormalizeDouble(targetSL, _Digits);
         if (candidateSL < currentSL && ModifyPositionSLTP(ticket, candidateSL, PositionGetDouble(POSITION_TP)))
            RegisterRangeMinProfitStop(ticket);
      }
   }
}

void UpdateTrailingStops()
{
   if (!g_h1AllOk || !g_m1AllOk ||
       (g_TrendTypeH != TREND_STRONG_UP && g_TrendTypeH != TREND_WEAK_UP &&
        g_TrendTypeH != TREND_STRONG_DOWN && g_TrendTypeH != TREND_WEAK_DOWN) ||
       !IsIndicatorValueValid(g_atr[1]) || g_atr[1] <= 0.0)
      return;

   double stopsLevelDistance = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   double slDistance = MathMax(MathMax(g_atr[1] * atrMultiplierTrail, SL_Points * _Point), stopsLevelDistance);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if (bid <= 0.0 || ask <= 0.0)
      return;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket) || PositionGetString(POSITION_SYMBOL) != _Symbol || (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      long ptype = PositionGetInteger(POSITION_TYPE);
      double currentSL = PositionGetDouble(POSITION_SL);
      if (ptype == POSITION_TYPE_BUY)
      {
         double candidateSL = NormalizeDouble(bid - slDistance, _Digits);
         if (candidateSL > currentSL && candidateSL - currentSL >= MinSLUpdatePoints * _Point)
            ModifyPositionSLTP(ticket, candidateSL, PositionGetDouble(POSITION_TP));
      }
      else if (ptype == POSITION_TYPE_SELL)
      {
         double candidateSL = NormalizeDouble(ask + slDistance, _Digits);
         if (candidateSL < currentSL && currentSL - candidateSL >= MinSLUpdatePoints * _Point)
            ModifyPositionSLTP(ticket, candidateSL, PositionGetDouble(POSITION_TP));
      }
   }
}

datetime ServerDayStart(datetime value)
{
   MqlDateTime parts;
   TimeToStruct(value, parts);
   parts.hour = 0;
   parts.min = 0;
   parts.sec = 0;
   return StructToTime(parts);
}

int SessionSeconds(datetime value)
{
   int seconds = (int)((long)value % 86400);
   if (seconds < 0)
      seconds += 86400;
   return seconds;
}

bool FindWeekendSession(datetime now, datetime &sessionEnd, datetime &nextSessionStart, long &gapSeconds)
{
   datetime today = ServerDayStart(now);
   datetime currentEnd = 0;
   datetime previousSessionEnd = 0;
   datetime candidateNextStart = 0;
   bool hasCurrentSession = false;

   for (int dayOffset = -1; dayOffset <= 8; dayOffset++)
   {
      datetime dayStart = today + dayOffset * 86400;
      MqlDateTime dayParts;
      TimeToStruct(dayStart, dayParts);
      for (uint sessionIndex = 0; ; sessionIndex++)
      {
         datetime from = 0;
         datetime to = 0;
         if (!SymbolInfoSessionTrade(_Symbol, (ENUM_DAY_OF_WEEK)dayParts.day_of_week, sessionIndex, from, to))
            break;

         int fromSeconds = SessionSeconds(from);
         int toSeconds = SessionSeconds(to);
         datetime start = dayStart + fromSeconds;
         datetime end = 0;
         if (fromSeconds == 0 && toSeconds == 0)
            end = start + 86400;
         else
         {
            end = dayStart + toSeconds;
            if (end <= start)
               end += 86400;
         }

         if (end <= now && end > previousSessionEnd)
            previousSessionEnd = end;

         if (now >= start && now < end && (!hasCurrentSession || end < currentEnd))
         {
            currentEnd = end;
            hasCurrentSession = true;
         }
      }
   }

   if (!hasCurrentSession)
      currentEnd = previousSessionEnd;
   if (currentEnd == 0)
      return false;

   for (int dayOffset = -1; dayOffset <= 8; dayOffset++)
   {
      datetime dayStart = today + dayOffset * 86400;
      MqlDateTime dayParts;
      TimeToStruct(dayStart, dayParts);
      for (uint sessionIndex = 0; ; sessionIndex++)
      {
         datetime from = 0;
         datetime to = 0;
         if (!SymbolInfoSessionTrade(_Symbol, (ENUM_DAY_OF_WEEK)dayParts.day_of_week, sessionIndex, from, to))
            break;

         datetime start = dayStart + SessionSeconds(from);
         if (start > currentEnd && (candidateNextStart == 0 || start < candidateNextStart))
            candidateNextStart = start;
      }
   }

   if (candidateNextStart == 0)
      return false;
   sessionEnd = currentEnd;
   nextSessionStart = candidateNextStart;
   gapSeconds = (long)(candidateNextStart - currentEnd);
   return true;
}

void UpdateWeekendSessionSchedule(datetime now)
{
   if (g_weekendTargetValid && now < g_weekendNextSessionStart)
      return;

   datetime sessionEnd = 0;
   datetime nextSessionStart = 0;
   long gapSeconds = 0;
   if (!FindWeekendSession(now, sessionEnd, nextSessionStart, gapSeconds))
      return;

   g_weekendScheduleInitialized = true;

   bool isWeekendTarget = gapSeconds >= 24 * 60 * 60;
   if (!isWeekendTarget)
   {
      g_weekendTargetValid = false;
      return;
   }

   datetime stopTime = sessionEnd - NewEntryStopBeforeClose;
   datetime forceTime = sessionEnd - ForceCloseBeforeClose;
   bool changed = !g_weekendTargetValid || g_weekendSessionEnd != sessionEnd || g_weekendNextSessionStart != nextSessionStart;
   g_weekendTargetValid = true;
   g_weekendSessionEnd = sessionEnd;
   g_weekendNextSessionStart = nextSessionStart;
   g_weekendEntryStopTime = stopTime;
   g_weekendForceCloseTime = forceTime;
   if (changed && EnableAnalysisCsv)
   {
      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "WEEKEND");
      SetAnalysisContext(analysis, now, AnalysisCurrentTimeMsc());
      analysis.values[AC_REASON] = "Weekend session scheduled";
      analysis.values[AC_REASON_DETAIL] = "SessionEnd=" + AnalysisDateTime(sessionEnd) +
         ";NextSessionStart=" + AnalysisDateTime(nextSessionStart) +
         ";GapSeconds=" + AnalysisLong(gapSeconds) +
         ";EntryStopTime=" + AnalysisDateTime(stopTime) +
         ";ForceCloseTime=" + AnalysisDateTime(forceTime);
      WriteAnalysisRecord(analysis);
   }
}

void ProcessWeekendSession(datetime now, bool refreshSchedule)
{
   if (g_weekendTargetValid && now >= g_weekendNextSessionStart)
   {
      g_weekendTargetValid = false;
      bool wasForceCloseActive = g_weekendForceCloseActive;
      g_weekendForceCloseActive = false;
      LogAnalysisFlagTransitionAt("g_weekendForceCloseActive", wasForceCloseActive, false,
                                  "Weekend stop released.", now, (long)now * 1000L);
      g_weekendForceCloseLastAttempt = 0;
      g_weekendScheduleInitialized = false;
      g_weekendSessionEnd = 0;
      g_weekendNextSessionStart = 0;
      g_weekendEntryStopTime = 0;
      g_weekendForceCloseTime = 0;
      if (EnableAnalysisCsv)
      {
         SAnalysisRecord analysis;
         ResetAnalysisRecord(analysis, "WEEKEND");
         SetAnalysisContext(analysis, now, AnalysisCurrentTimeMsc());
         analysis.values[AC_REASON] = "Weekend stop released";
         analysis.values[AC_REASON_DETAIL] = "NextSessionStart=" + AnalysisDateTime(now);
         WriteAnalysisRecord(analysis);
      }
      UpdateWeekendSessionSchedule(now);
   }

   if (refreshSchedule || !g_weekendScheduleInitialized)
      UpdateWeekendSessionSchedule(now);
   if (!g_weekendTargetValid)
      return;

   if (now >= g_weekendEntryStopTime && !g_weekendForceCloseActive)
   {
      bool wasForceCloseActive = g_weekendForceCloseActive;
      g_weekendForceCloseActive = true;
      LogAnalysisFlagTransitionAt("g_weekendForceCloseActive", wasForceCloseActive, true,
                                  "Weekend entry stop time reached.", now, (long)now * 1000L);
      if (EnableAnalysisCsv)
      {
         SAnalysisRecord analysis;
         ResetAnalysisRecord(analysis, "WEEKEND");
         SetAnalysisContext(analysis, now, AnalysisCurrentTimeMsc());
         analysis.values[AC_REASON] = "New entries stopped";
         WriteAnalysisRecord(analysis);
      }
   }

   if (!g_weekendForceCloseActive || now < g_weekendForceCloseTime)
      return;
   if (g_weekendForceCloseLastAttempt > 0 &&
       (long)(now - g_weekendForceCloseLastAttempt) < WeekendForceCloseRetrySeconds)
      return;

   if (g_weekendForceCloseLastAttempt == 0 && EnableAnalysisCsv)
   {
      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "WEEKEND");
      SetAnalysisContext(analysis, now, AnalysisCurrentTimeMsc());
      analysis.values[AC_REASON] = "Force close started";
      WriteAnalysisRecord(analysis);
   }

   ulong targetTickets[];
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol ||
          (long)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      int count = ArraySize(targetTickets);
      ArrayResize(targetTickets, count + 1);
      targetTickets[count] = ticket;
   }

   g_weekendForceCloseLastAttempt = now;
   for (int i = 0; i < ArraySize(targetTickets); i++)
   {
      ulong ticket = targetTickets[i];
      if (PositionSelectByTicket(ticket) && EnableAnalysisCsv)
      {
         MqlTick tick;
         ZeroMemory(tick);
         SymbolInfoTick(_Symbol, tick);
         double spreadPts = (tick.ask - tick.bid) / _Point;
         SAnalysisRecord closeAnalysis;
         ResetAnalysisRecord(closeAnalysis, "WEEKEND");
         SetAnalysisContext(closeAnalysis, now, tick.time_msc);
         closeAnalysis.values[AC_REASON] = "Force close position";
         closeAnalysis.values[AC_DIRECTION] = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? "BUY" : "SELL";
         closeAnalysis.values[AC_TICKET] = AnalysisLong((long)ticket);
         closeAnalysis.values[AC_POSITION] = AnalysisLong(PositionGetInteger(POSITION_IDENTIFIER));
         closeAnalysis.values[AC_BID] = AnalysisNumber(tick.bid, _Digits);
         closeAnalysis.values[AC_ASK] = AnalysisNumber(tick.ask, _Digits);
         closeAnalysis.values[AC_SPREAD_POINTS] = AnalysisNumber(spreadPts, 1);
         WriteAnalysisRecord(closeAnalysis);
      }
      ClosePositionByTicket(ticket, "週末休場前の強制決済", true);
   }
}

