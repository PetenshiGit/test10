int requestLogThreshold = 20;      // 直近60秒のログ表示閾値

int RequestLimitCount()
{
   return requestLogThreshold;
}

void PruneRequestRecords()
{
   datetime now = TimeCurrent();
   int firstValid = 0;
   int total = ArraySize(g_requestRecords);
   while (firstValid < total && now - g_requestRecords[firstValid].requestTime > 60)
      firstValid++;
   if (firstValid > 0)
   {
      for (int i = firstValid; i < total; i++)
         g_requestRecords[i - firstValid] = g_requestRecords[i];
      ArrayResize(g_requestRecords, total - firstValid);
   }
}

int RequestEvaluationCount(RequestEvaluation evaluation)
{
   int count = 0;
   for (int i = 0; i < ArraySize(g_requestRecords); i++)
      if (g_requestRecords[i].evaluation == evaluation)
         count++;
   return count;
}

void RecordRequest(RequestEvaluation evaluation, uint retcode)
{
   PruneRequestRecords();
   int index = ArraySize(g_requestRecords);
   ArrayResize(g_requestRecords, index + 1);
   g_requestRecords[index].requestTime = TimeCurrent();
   g_requestRecords[index].evaluation = evaluation;
   g_requestRecords[index].retcode = retcode;
   int count = ArraySize(g_requestRecords);
   if (count > RequestLimitCount())
      PrintFormat("取引リクエスト監視：送信失敗：%d件 / 実行失敗：%d件 / 実行成功：%d件 / リクエスト数：%d件", RequestEvaluationCount(REQUEST_SEND_FAILED), RequestEvaluationCount(REQUEST_EXECUTION_FAILED), RequestEvaluationCount(REQUEST_EXECUTION_SUCCEEDED), count);
}

void AddTradeHistoryTimestamp(datetime t)
{
   if (TradeHistorySize < MAX_HISTORY)
   {
      for (int i = TradeHistorySize; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
      TradeHistorySize++;
   }
   else
   {
      for (int i = MAX_HISTORY - 1; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
   }
}

// ===================================================================
// ダイバージェンス補助（14本・時系列・3点比較）
// ===================================================================
double DivergenceValue(const double &values[], int logicalIndex, int count, bool series)
{
   return values[series ? count - 1 - logicalIndex : logicalIndex];
}

void CollectPeakIndices(const double &values[], int count, bool higherIsPeak, int maxPeaks, int &outIdx[], bool series)
{
   ArrayInitialize(outIdx, -1);
   bool candidates[32];
   ArrayInitialize(candidates, false);

   for (int i = 0; i < count && i < 32; i++)
   {
      bool isPeak = false;
      if (count == 1)
         isPeak = true;
      else if (i == 0)
         isPeak = (higherIsPeak ? DivergenceValue(values, i, count, series) >= DivergenceValue(values, i + 1, count, series) : DivergenceValue(values, i, count, series) <= DivergenceValue(values, i + 1, count, series));
      else if (i == count - 1)
         isPeak = (higherIsPeak ? DivergenceValue(values, i, count, series) >= DivergenceValue(values, i - 1, count, series) : DivergenceValue(values, i, count, series) <= DivergenceValue(values, i - 1, count, series));
      else
      {
         bool left = (higherIsPeak ? DivergenceValue(values, i, count, series) >= DivergenceValue(values, i - 1, count, series) : DivergenceValue(values, i, count, series) <= DivergenceValue(values, i - 1, count, series));
         bool right = (higherIsPeak ? DivergenceValue(values, i, count, series) >= DivergenceValue(values, i + 1, count, series) : DivergenceValue(values, i, count, series) <= DivergenceValue(values, i + 1, count, series));
         isPeak = left && right;
      }
      if (!isPeak)
         continue;
      candidates[i] = true;
   }

   // 隣接候補は直近側を残す。
   for (int i = 0; i + 1 < count && i + 1 < 32; i++)
      if (candidates[i] && candidates[i + 1])
         candidates[i] = false;

   int selected = 0;
   while (selected < maxPeaks)
   {
      int best = -1;
      for (int i = 0; i < count && i < 32; i++)
      {
         if (!candidates[i])
            continue;
          if (best < 0 || (higherIsPeak && DivergenceValue(values, i, count, series) > DivergenceValue(values, best, count, series)) || (!higherIsPeak && DivergenceValue(values, i, count, series) < DivergenceValue(values, best, count, series)) ||
             (DivergenceValue(values, i, count, series) == DivergenceValue(values, best, count, series) && i > best))
            best = i;
      }
      if (best < 0)
         break;
      outIdx[selected++] = best;
      candidates[best] = false;
   }

   for (int i = 0; i < selected - 1; i++)
      for (int j = i + 1; j < selected; j++)
         if (outIdx[i] > outIdx[j])
         {
            int temp = outIdx[i];
            outIdx[i] = outIdx[j];
            outIdx[j] = temp;
         }
}

int GetDirectionFromPoints(const double &values[], int points)
{
   if (points < 3)
      return 0;

   double a = values[0];
   double b = values[1];
   double c = values[2];
   if (a < b && b < c)
      return 1;
   if (a > b && b > c)
      return -1;
   return 0;
}

DivergenceType CheckDivergenceSeries(const double &price[], const double &indicator[], int count, bool useHighs, bool series)
{
   if (count < 3)
      return DIVERGENCE_NONE;

   int priceIdx[3];
   int indiIdx[3];
   ArrayInitialize(priceIdx, -1);
   ArrayInitialize(indiIdx, -1);
   CollectPeakIndices(price, count, useHighs, 3, priceIdx, series);
   CollectPeakIndices(indicator, count, useHighs, 3, indiIdx, series);

   int priceCount = 0;
   int indiCount = 0;
   for (int i = 0; i < 3; i++)
   {
      if (priceIdx[i] >= 0)
         priceCount++;
      if (indiIdx[i] >= 0)
         indiCount++;
   }
   if (priceCount < 3 || indiCount < 3)
      return DIVERGENCE_NONE;

   double priceValues[3];
   double indiValues[3];
   ArrayInitialize(priceValues, 0.0);
   ArrayInitialize(indiValues, 0.0);

   for (int i = 0; i < priceCount; i++)
   {
      if (priceIdx[i] < 0 || !IsDivergenceValueValid(DivergenceValue(price, priceIdx[i], count, series)))
         return DIVERGENCE_NONE;
      priceValues[i] = DivergenceValue(price, priceIdx[i], count, series);
   }
   for (int i = 0; i < indiCount; i++)
   {
      if (indiIdx[i] < 0 || !IsDivergenceValueValid(DivergenceValue(indicator, indiIdx[i], count, series)))
         return DIVERGENCE_NONE;
      indiValues[i] = DivergenceValue(indicator, indiIdx[i], count, series);
   }

   int priceDir = GetDirectionFromPoints(priceValues, priceCount);
   int indiDir = GetDirectionFromPoints(indiValues, indiCount);

   if (priceDir < 0 && indiDir > 0)
      return DIVERGENCE_BULLISH;
   if (priceDir > 0 && indiDir < 0)
      return DIVERGENCE_BEARISH;
   return DIVERGENCE_NONE;
}

// Divergenceは通常のM15計算から分離して保持する。現バージョンでは呼び出さない。
DivergenceType CalculateRsiDivergence(int rsiHandle)
{
   double priceHigh[], priceLow[], rsiSeries[];
   ArrayResize(priceHigh, DIVERGENCE_PERIOD);
   ArrayResize(priceLow, DIVERGENCE_PERIOD);
   ArrayResize(rsiSeries, DIVERGENCE_PERIOD);
   ArraySetAsSeries(priceHigh, true);
   ArraySetAsSeries(priceLow, true);
   ArraySetAsSeries(rsiSeries, true);
      if (CopyHigh(_Symbol, PERIOD_M15, 0, DIVERGENCE_PERIOD, priceHigh) != DIVERGENCE_PERIOD ||
         CopyLow(_Symbol, PERIOD_M15, 0, DIVERGENCE_PERIOD, priceLow) != DIVERGENCE_PERIOD ||
         CopyBuffer(rsiHandle, 0, 0, DIVERGENCE_PERIOD, rsiSeries) != DIVERGENCE_PERIOD)
      return DIVERGENCE_NONE;

   DivergenceType highResult = CheckDivergenceSeries(priceHigh, rsiSeries, DIVERGENCE_PERIOD, true, true);
   DivergenceType lowResult = CheckDivergenceSeries(priceLow, rsiSeries, DIVERGENCE_PERIOD, false, true);
   if ((highResult == DIVERGENCE_BEARISH && lowResult == DIVERGENCE_BULLISH) ||
       (highResult == DIVERGENCE_BULLISH && lowResult == DIVERGENCE_BEARISH))
      return DIVERGENCE_CONFLICT;
   if (highResult != DIVERGENCE_NONE)
      return highResult;
   return lowResult;
}

DivergenceType CalculateMacdDivergence(int macdHandle)
{
   double priceHigh[], priceLow[], macdMain[], macdSignalBuffer[];
   ArrayResize(priceHigh, DIVERGENCE_PERIOD);
   ArrayResize(priceLow, DIVERGENCE_PERIOD);
   ArrayResize(macdMain, DIVERGENCE_PERIOD);
   ArrayResize(macdSignalBuffer, DIVERGENCE_PERIOD);
   ArraySetAsSeries(priceHigh, true);
   ArraySetAsSeries(priceLow, true);
   ArraySetAsSeries(macdMain, true);
   ArraySetAsSeries(macdSignalBuffer, true);
      if (CopyHigh(_Symbol, PERIOD_M15, 0, DIVERGENCE_PERIOD, priceHigh) != DIVERGENCE_PERIOD ||
         CopyLow(_Symbol, PERIOD_M15, 0, DIVERGENCE_PERIOD, priceLow) != DIVERGENCE_PERIOD ||
         CopyBuffer(macdHandle, 0, 0, DIVERGENCE_PERIOD, macdMain) != DIVERGENCE_PERIOD ||
         CopyBuffer(macdHandle, 1, 0, DIVERGENCE_PERIOD, macdSignalBuffer) != DIVERGENCE_PERIOD)
      return DIVERGENCE_NONE;

   double histogram[DIVERGENCE_PERIOD];
   for (int i = 0; i < DIVERGENCE_PERIOD; i++)
      histogram[i] = macdMain[i] - macdSignalBuffer[i];
   DivergenceType highResult = CheckDivergenceSeries(priceHigh, histogram, DIVERGENCE_PERIOD, true, true);
   DivergenceType lowResult = CheckDivergenceSeries(priceLow, histogram, DIVERGENCE_PERIOD, false, true);
   if ((highResult == DIVERGENCE_BEARISH && lowResult == DIVERGENCE_BULLISH) ||
       (highResult == DIVERGENCE_BULLISH && lowResult == DIVERGENCE_BEARISH))
      return DIVERGENCE_CONFLICT;
   if (highResult != DIVERGENCE_NONE)
      return highResult;
   return lowResult;
}

// ===================================================================
// H1 用クラス
// ADX、DI、EMA を使ってトレンド/レンジ種別や方向性を判定する
// ===================================================================
class CTrend1H
{
private:
   TrendType m_type;
   TrendState m_state;
   double m_value;
   int h_adx;
   int h_emaS;
   int h_emaL;
public:
   CTrend1H() { m_type = TREND_UNKNOWN; m_state = STATE_UNKNOWN; m_value = 0.0; h_adx = h_emaS = h_emaL = INVALID_HANDLE; }
   void Init(int _h_adx, int _h_emaS, int _h_emaL) { h_adx = _h_adx; h_emaS = _h_emaS; h_emaL = _h_emaL; }
   bool Calculate()
   {
      datetime lastBar = iTime(_Symbol, PERIOD_H1, 0);
      if (lastBar <= 0)
         return(false);

      double adxH1[], diPlusH1[], diMinusH1[], emaShortH1[], emaLongH1[];
      if (!g_h1_adx_ok)
      {
         g_h1_adx_ok = CopyBufferWithRetry(h_adx, 0, adxH1, "H1 ADX", PERIOD_H1);
         if (g_h1_adx_ok) { g_h1_adx_ok = (ArrayCopy(g_h1_adxArr, adxH1) == INDICATOR_BARS); ArraySetAsSeries(g_h1_adxArr, true); if (g_h1_adx_ok) LogArrayCopyVerification("H1 ADX", adxH1, g_h1_adxArr); }
      }
      if (!g_h1_dip_ok)
      {
         g_h1_dip_ok = CopyBufferWithRetry(h_adx, 1, diPlusH1, "H1 DI+", PERIOD_H1);
         if (g_h1_dip_ok) { g_h1_dip_ok = (ArrayCopy(g_h1_dipArr, diPlusH1) == INDICATOR_BARS); ArraySetAsSeries(g_h1_dipArr, true); if (g_h1_dip_ok) LogArrayCopyVerification("H1 DI+", diPlusH1, g_h1_dipArr); }
      }
      if (!g_h1_dim_ok)
      {
         g_h1_dim_ok = CopyBufferWithRetry(h_adx, 2, diMinusH1, "H1 DI-", PERIOD_H1);
         if (g_h1_dim_ok) { g_h1_dim_ok = (ArrayCopy(g_h1_dimArr, diMinusH1) == INDICATOR_BARS); ArraySetAsSeries(g_h1_dimArr, true); if (g_h1_dim_ok) LogArrayCopyVerification("H1 DI-", diMinusH1, g_h1_dimArr); }
      }
      if (!g_h1_emaS_ok)
      {
         g_h1_emaS_ok = CopyBufferWithRetry(h_emaS, 0, emaShortH1, "H1 EMA Short", PERIOD_H1);
         if (g_h1_emaS_ok) { g_h1_emaS_ok = (ArrayCopy(g_h1_emaSArr, emaShortH1) == INDICATOR_BARS); ArraySetAsSeries(g_h1_emaSArr, true); if (g_h1_emaS_ok) LogArrayCopyVerification("H1 EMA短", emaShortH1, g_h1_emaSArr); }
      }
      if (!g_h1_emaL_ok)
      {
         g_h1_emaL_ok = CopyBufferWithRetry(h_emaL, 0, emaLongH1, "H1 EMA Long", PERIOD_H1);
         if (g_h1_emaL_ok) { g_h1_emaL_ok = (ArrayCopy(g_h1_emaLArr, emaLongH1) == INDICATOR_BARS); ArraySetAsSeries(g_h1_emaLArr, true); if (g_h1_emaL_ok) LogArrayCopyVerification("H1 EMA長", emaLongH1, g_h1_emaLArr); }
      }
      g_h1AllOk = g_h1_adx_ok && g_h1_dip_ok && g_h1_dim_ok && g_h1_emaS_ok && g_h1_emaL_ok;
      if (!g_h1AllOk)
      {
         PrintFormat("1時間足指標取得失敗：ADX=%s DI+=%s DI-=%s EMA短=%s EMA長=%s", g_h1_adx_ok ? "OK" : "NG", g_h1_dip_ok ? "OK" : "NG", g_h1_dim_ok ? "OK" : "NG", g_h1_emaS_ok ? "OK" : "NG", g_h1_emaL_ok ? "OK" : "NG");
         return(false);
      }

      double diDiff = MathAbs(g_h1_dipArr[1] - g_h1_dimArr[1]);

      int diDir = 0;
      if (g_h1_dipArr[1] > g_h1_dimArr[1] && diDiff >= diThreshold)
         diDir = 1;
      else if (g_h1_dimArr[1] > g_h1_dipArr[1] && diDiff >= diThreshold)
         diDir = -1;

      int emaDir = 0;
      if (g_h1_emaSArr[1] > g_h1_emaLArr[1])
         emaDir = 1;
      else if (g_h1_emaSArr[1] < g_h1_emaLArr[1])
         emaDir = -1;

      if (g_h1_adxArr[1] < adxRangeThreshold)
         m_type = TREND_RANGE;
      else if (g_h1_adxArr[1] >= adxStrongThreshold && diDir == 1)
      {
         m_type = TREND_STRONG_UP;
      }
      else if (g_h1_adxArr[1] >= adxStrongThreshold && diDir == -1)
      {
         m_type = TREND_STRONG_DOWN;
      }
      else if (g_h1_adxArr[1] >= adxThreshold)
      {
         if (diDir == 1)
            m_type = TREND_WEAK_UP;
         else if (diDir == -1)
            m_type = TREND_WEAK_DOWN;
         else
            m_type = TREND_UNKNOWN;
      }
      else
         m_type = TREND_UNKNOWN;

      if (g_h1_adxArr[3] >= adxThreshold && g_h1_adxArr[2] >= adxThreshold && g_h1_adxArr[1] >= adxThreshold)
      {
         if (g_h1_adxArr[3] < g_h1_adxArr[2] && g_h1_adxArr[2] < g_h1_adxArr[1])
            m_state = TREND_ACCELERATE;
         else if (g_h1_adxArr[3] > g_h1_adxArr[2] && g_h1_adxArr[2] > g_h1_adxArr[1])
            m_state = TREND_DECELERATE;
         else if (g_h1_adxArr[3] > g_h1_adxArr[2] && g_h1_adxArr[2] < g_h1_adxArr[1] && g_h1_adxArr[3] < g_h1_adxArr[1])
            m_state = TREND_REACCELERATE;
         else if (g_h1_adxArr[3] > g_h1_adxArr[2] && g_h1_adxArr[2] < g_h1_adxArr[1] && g_h1_adxArr[3] >= g_h1_adxArr[1])
            m_state = TREND_RECOVERY_MAINTAIN;
         else if (g_h1_adxArr[3] < g_h1_adxArr[2] && g_h1_adxArr[2] > g_h1_adxArr[1])
            m_state = TREND_STALL_MAINTAIN;
         else
            m_state = TREND_MAINTAIN;
      }
      else if (g_h1_adxArr[3] < adxThreshold && g_h1_adxArr[2] < adxThreshold && g_h1_adxArr[1] >= adxThreshold)
         m_state = RANGE_TO_TREND;
      else if (g_h1_adxArr[3] >= 18 && g_h1_adxArr[2] >= 18 && g_h1_adxArr[1] < 18)
         m_state = TREND_TO_RANGE;
      else if (g_h1_adxArr[3] < 18 && g_h1_adxArr[2] < 18 && g_h1_adxArr[1] < 18)
         m_state = RANGE_MAINTAIN;
      else
         m_state = STATE_UNKNOWN;

      m_value = g_h1_adxArr[1];

      // H1 DI方向と EMA方向をグローバル変数に保存（追撃判定で使用）
      g_H1DiDir = diDir;
      g_H1EmaDir = emaDir;

      // PrintFormat("H1判定 ADX[1]=%.3f ADX[2]=%.3f ADX[3]=%.3f DI+=%.3f DI-=%.3f DI差=%.3f EMA短=%.5f EMA長=%.5f DI：%s EMA：%s Type=%s State=%s",
      //    g_h1_adxArr[1], g_h1_adxArr[2], g_h1_adxArr[3], g_h1_dipArr[1], g_h1_dimArr[1], diDiff, g_h1_emaSArr[1], g_h1_emaLArr[1], diDir > 0 ? "上方向" : diDir < 0 ? "下方向" : "方向性なし", emaDir > 0 ? "上方向" : emaDir < 0 ? "下方向" : "方向性なし", TrendTypeToString(m_type), TrendStateToString(m_state));
      return(true);
   }
   TrendType getType() const { return(m_type); }
   TrendState getState() const { return(m_state); }
   double getValue() const { return(m_value); }
};

// ===================================================================
// M15 用クラス
// RSI と MACD を常時取得・判定し、ダイバージェンスを別々に保持する
// ===================================================================
class CTrend15
{
private:
   TrendState m_state;
   double m_value;
   bool m_macdCross;
   int m_macdCrossDir;
   double m_rsiValue;
   double m_macdMain;
   double m_macdSignal;
   double m_macdHist;
   int rsiH, macdH;
public:
   CTrend15() { m_state = STATE_UNKNOWN; m_value = 0.0; m_macdCross = false; m_macdCrossDir = 0; m_rsiValue = 0.0; m_macdMain = m_macdSignal = m_macdHist = 0.0; rsiH = macdH = INVALID_HANDLE; }
   void Init(int _rsiH, int _macdH) { rsiH = _rsiH; macdH = _macdH; }
   bool Calculate(datetime barTime)
   {
      datetime lastBar = iTime(_Symbol, PERIOD_M15, 0);
      if (lastBar <= 0)
         return(false);

      double rsiBuffer[], mainBuffer[], sigBuffer[];
      if (!g_m15_rsi_ok)
      {
         g_m15_rsi_ok = CopyBufferWithRetry(rsiH, 0, rsiBuffer, "M15 RSI", PERIOD_M15);
         if (g_m15_rsi_ok) { g_m15_rsi_ok = (ArrayCopy(g_m15_rsiArr, rsiBuffer) == INDICATOR_BARS); ArraySetAsSeries(g_m15_rsiArr, true); if (g_m15_rsi_ok) LogArrayCopyVerification("M15 RSI", rsiBuffer, g_m15_rsiArr); }
      }
      if (!g_m15_macd_ok)
      {
         bool mainOk = CopyBufferWithRetry(macdH, 0, mainBuffer, "M15 MACD Main", PERIOD_M15);
         bool sigOk = CopyBufferWithRetry(macdH, 1, sigBuffer, "M15 MACD Signal", PERIOD_M15);
         g_m15_macd_ok = mainOk && sigOk;
         if (g_m15_macd_ok)
         {
            g_m15_macd_ok = (ArrayCopy(g_m15_macdMainAll, mainBuffer) == INDICATOR_BARS && ArrayCopy(g_m15_macdSigAll, sigBuffer) == INDICATOR_BARS);
            ArraySetAsSeries(g_m15_macdMainAll, true); ArraySetAsSeries(g_m15_macdSigAll, true);
            if (g_m15_macd_ok)
            {
               LogArrayCopyVerification("M15 MACD Main", mainBuffer, g_m15_macdMainAll);
               LogArrayCopyVerification("M15 MACD Signal", sigBuffer, g_m15_macdSigAll);
            }
         }
      }
      g_m15AllOk = g_m15_rsi_ok && g_m15_macd_ok;
      if (!g_m15AllOk)
      {
         PrintFormat("15分足指標取得失敗：RSI=%s MACD=%s", g_m15_rsi_ok ? "OK" : "NG", g_m15_macd_ok ? "OK" : "NG");
         return(false);
      }

      double latestRsi = g_m15_rsiArr[1];
      double latestMacdMain = g_m15_macdMainAll[1];
      double latestMacdSig = g_m15_macdSigAll[1];
      double latestMacdHist = latestMacdMain - latestMacdSig;
      double prevMacdMain = g_m15_macdMainAll[2];
      double prevMacdSig = g_m15_macdSigAll[2];
      m_rsiValue = latestRsi;
      m_macdMain = latestMacdMain;
      m_macdSignal = latestMacdSig;
      m_macdHist = latestMacdHist;
      m_macdCross = false;
      m_macdCrossDir = 0;
      if (prevMacdMain <= prevMacdSig && latestMacdMain > latestMacdSig)
      {
         m_macdCross = true;
         m_macdCrossDir = 1;
      }
      else if (prevMacdMain >= prevMacdSig && latestMacdMain < latestMacdSig)
      {
         m_macdCross = true;
         m_macdCrossDir = -1;
      }

      if (latestMacdHist > 0)
         m_state = TREND_ACCELERATE;
      else if (latestMacdHist < 0)
         m_state = TREND_DECELERATE;
      else
         m_state = TREND_MAINTAIN;

      m_value = latestRsi;

      g_M15Signal.barTime = barTime;
      g_M15Signal.expireM1BarTime = iTime(_Symbol, PERIOD_M1, 0) + PeriodSeconds(PERIOD_M1);
      g_M15Signal.suppressBuyPyramid = latestRsi < 70.0;
      g_M15Signal.suppressSellPyramid = latestRsi > 30.0;
      g_M15Signal.hasMACDCross = m_macdCross;
      g_M15Signal.macdCrossDir = m_macdCrossDir;
      g_M15Signal.pendingNextM1 = true;

      PrintFormat("M15更新 RSI=%.3f MACD Main=%.5f Signal=%.5f Hist=%.5f Cross=%s",
            latestRsi, latestMacdMain, latestMacdSig, latestMacdHist, m_macdCross ? "YES" : "NO");
      return(true);
   }
   TrendState getState() const { return (m_state); }
   double getValue() const { return (m_value); }
   bool   getMACDCross() const { return (m_macdCross); }
   int    getMACDCrossDir() const { return (m_macdCrossDir); }
};

// ===================================================================
// M1 用クラス
// ボリンジャーバンド、ストキャスティクス、ATR、スーパートレンドを使って取引タイミングを計る
// ===================================================================
class CTrend1M
{
private:
   int h_bb;
   int h_stoch;
   int h_atr;
public:
   CTrend1M() { h_bb = h_stoch = h_atr = INVALID_HANDLE; }
   void Init(int _h_bb, int _h_stoch, int _h_atr) { h_bb = _h_bb; h_stoch = _h_stoch; h_atr = _h_atr; }
   bool Calculate()
   {
      datetime lastBar = iTime(_Symbol, PERIOD_M1, 0);
      if (lastBar <= 0)
         return(false);

      double midBuffer[], upperBuffer[], lowerBuffer[], kBuffer[], dBuffer[], atrBuffer[];
      if (!g_m1_bb_ok)
      {
         bool midOk = CopyBufferWithRetry(h_bb, 0, midBuffer, "M1 BB Middle", PERIOD_M1);
         bool upperOk = CopyBufferWithRetry(h_bb, 1, upperBuffer, "M1 BB Upper", PERIOD_M1);
         bool lowerOk = CopyBufferWithRetry(h_bb, 2, lowerBuffer, "M1 BB Lower", PERIOD_M1);
         g_m1_bb_ok = midOk && upperOk && lowerOk;
         if (g_m1_bb_ok)
         {
            g_m1_bb_ok = (ArrayCopy(g_bbMiddle, midBuffer) == INDICATOR_BARS &&
                          ArrayCopy(g_bbUpper, upperBuffer) == INDICATOR_BARS &&
                          ArrayCopy(g_bbLower, lowerBuffer) == INDICATOR_BARS);
            ArraySetAsSeries(g_bbMiddle, true); ArraySetAsSeries(g_bbUpper, true); ArraySetAsSeries(g_bbLower, true);
            if (g_m1_bb_ok)
            {
               LogArrayCopyVerification("M1 BB中", midBuffer, g_bbMiddle);
               LogArrayCopyVerification("M1 BB上", upperBuffer, g_bbUpper);
               LogArrayCopyVerification("M1 BB下", lowerBuffer, g_bbLower);
            }
         }
      }
      if (!g_m1_stoch_ok)
      {
         bool kOk = CopyBufferWithRetry(h_stoch, 0, kBuffer, "M1 Stochastic K", PERIOD_M1);
         bool dOk = CopyBufferWithRetry(h_stoch, 1, dBuffer, "M1 Stochastic D", PERIOD_M1);
         g_m1_stoch_ok = kOk && dOk;
         if (g_m1_stoch_ok)
         {
            g_m1_stoch_ok = (ArrayCopy(g_stochK, kBuffer) == INDICATOR_BARS &&
                             ArrayCopy(g_stochD, dBuffer) == INDICATOR_BARS);
            ArraySetAsSeries(g_stochK, true); ArraySetAsSeries(g_stochD, true);
            if (g_m1_stoch_ok)
            {
               LogArrayCopyVerification("M1 Stoch K", kBuffer, g_stochK);
               LogArrayCopyVerification("M1 Stoch D", dBuffer, g_stochD);
            }
         }
      }
      if (!g_m1_atr_ok)
      {
         g_m1_atr_ok = CopyBufferWithRetry(h_atr, 0, atrBuffer, "M1 ATR", PERIOD_M1);
         if (g_m1_atr_ok) { g_m1_atr_ok = (ArrayCopy(g_atr, atrBuffer) == INDICATOR_BARS); ArraySetAsSeries(g_atr, true); if (g_m1_atr_ok) LogArrayCopyVerification("M1 ATR", atrBuffer, g_atr); }
      }
      double m1High[], m1Low[], m1Close[];
      ArraySetAsSeries(m1High, true); ArraySetAsSeries(m1Low, true); ArraySetAsSeries(m1Close, true);
      ResetLastError();
      int highCopied = CopyHigh(_Symbol, PERIOD_M1, 0, INDICATOR_BARS, m1High);
      int highError = GetLastError();
      ResetLastError();
      int lowCopied = CopyLow(_Symbol, PERIOD_M1, 0, INDICATOR_BARS, m1Low);
      int lowError = GetLastError();
      ResetLastError();
      int closeCopied = CopyClose(_Symbol, PERIOD_M1, 0, INDICATOR_BARS, m1Close);
      int closeError = GetLastError();
      bool pricesOk = highCopied == INDICATOR_BARS && lowCopied == INDICATOR_BARS && closeCopied == INDICATOR_BARS &&
                ArePriceValuesValid(m1High) && ArePriceValuesValid(m1Low) && ArePriceValuesValid(m1Close);
      if (pricesOk)
      {
         pricesOk = (ArrayCopy(g_m1High, m1High) == INDICATOR_BARS &&
                     ArrayCopy(g_m1Low, m1Low) == INDICATOR_BARS &&
                     ArrayCopy(g_m1Close, m1Close) == INDICATOR_BARS);
         ArraySetAsSeries(g_m1High, true); ArraySetAsSeries(g_m1Low, true); ArraySetAsSeries(g_m1Close, true);
         // LogPriceValues("M1 High", m1High);
         // LogPriceValues("M1 Low", m1Low);
         // LogPriceValues("M1 Close", m1Close);
      }
      else
      {
         PrintFormat("M1価格取得失敗 High=%d/%d err=%d Low=%d/%d err=%d Close=%d/%d err=%d", highCopied, INDICATOR_BARS, highError, lowCopied, INDICATOR_BARS, lowError, closeCopied, INDICATOR_BARS, closeError);
         LogPriceValues("M1 High", m1High);
         LogPriceValues("M1 Low", m1Low);
         LogPriceValues("M1 Close", m1Close);
         LogInvalidArrayValues("M1 High", m1High);
         LogInvalidArrayValues("M1 Low", m1Low);
         LogInvalidArrayValues("M1 Close", m1Close);
      }
      g_m1AllOk = g_m1_bb_ok && g_m1_stoch_ok && g_m1_atr_ok && pricesOk;
      if (!g_m1AllOk)
      {
         PrintFormat("1分足指標取得失敗：BB=%s Stoch=%s ATR=%s 価格=%s", g_m1_bb_ok ? "OK" : "NG", g_m1_stoch_ok ? "OK" : "NG", g_m1_atr_ok ? "OK" : "NG", pricesOk ? "OK" : "NG");
         return(false);
      }

      bool initializedNow = false;
      if (!g_superTrendInitialized)
      {
         if (!InitializeSuperTrend())
         {
            g_m1AllOk = false;
            g_m1_bb_ok = g_m1_stoch_ok = g_m1_atr_ok = false;
            return false;
         }
         initializedNow = true;
      }
      if (g_superTrendInitialized && !initializedNow && !UpdateSuperTrend(g_atr[1], g_m1High, g_m1Low, g_m1Close))
      {
         g_m1AllOk = false;
         g_m1_bb_ok = g_m1_stoch_ok = g_m1_atr_ok = false;
         return false;
      }

      // 新M1足のPullback/Reacceleration状態はここでリセットする。
      // Tick間の前回ASK/BIDはOnTick側で継続管理するため、ここではクリアしない。
      g_superTrendPullbackBuy = false;
      g_superTrendPullbackSell = false;

      PrintFormat("M1確定値 ATR=%.5f BB上=%.5f BB中=%.5f BB下=%.5f StochK=%.3f StochD=%.3f", g_atr[1], g_bbUpper[1], g_bbMiddle[1], g_bbLower[1], g_stochK[1], g_stochD[1]);
      PrintFormat("M1 SuperTrend更新値=%.5f 方向=%s", g_superTrend[1], g_superTrendDir[1] > 0 ? "上" : "下");
      return(true);
   }

   bool InitializeSuperTrend()
   {
      double stValues[], atrValues[], finalUpperValues[], finalLowerValues[];
      double highValues[], lowValues[], closeValues[];
      int directions[];
      ArrayResize(stValues, SUPERTREND_INIT_BARS);
      ArrayResize(atrValues, SUPERTREND_INIT_BARS);
      ArrayResize(finalUpperValues, SUPERTREND_INIT_BARS);
      ArrayResize(finalLowerValues, SUPERTREND_INIT_BARS);
      ArrayResize(directions, SUPERTREND_INIT_BARS);
      ArrayResize(highValues, SUPERTREND_INIT_BARS);
      ArrayResize(lowValues, SUPERTREND_INIT_BARS);
      ArrayResize(closeValues, SUPERTREND_INIT_BARS);
      ArraySetAsSeries(stValues, true);
      ArraySetAsSeries(atrValues, true);
      ArraySetAsSeries(finalUpperValues, true);
      ArraySetAsSeries(finalLowerValues, true);
      ArraySetAsSeries(directions, true);
         ArraySetAsSeries(atrValues, true);
         ArraySetAsSeries(highValues, true);
         ArraySetAsSeries(lowValues, true);
         ArraySetAsSeries(closeValues, true);

         if (CopyBuffer(h_atr, 0, 1, SUPERTREND_INIT_BARS, atrValues) != SUPERTREND_INIT_BARS ||
           CopyHigh(_Symbol, PERIOD_M1, 1, SUPERTREND_INIT_BARS, highValues) != SUPERTREND_INIT_BARS ||
           CopyLow(_Symbol, PERIOD_M1, 1, SUPERTREND_INIT_BARS, lowValues) != SUPERTREND_INIT_BARS ||
           CopyClose(_Symbol, PERIOD_M1, 1, SUPERTREND_INIT_BARS, closeValues) != SUPERTREND_INIT_BARS)
         return false;

      for (int shift = SUPERTREND_INIT_BARS; shift >= 1; shift--)
      {
         int index = SUPERTREND_INIT_BARS - shift;
          int seriesIndex = shift - 1;
          double atrValue = atrValues[seriesIndex];
          if (!IsIndicatorValueValid(atrValue) || !IsIndicatorValueValid(closeValues[seriesIndex]) ||
             !IsIndicatorValueValid(highValues[seriesIndex]) || !IsIndicatorValueValid(lowValues[seriesIndex]))
            return false;

          double high = highValues[seriesIndex];
          double low = lowValues[seriesIndex];
          double close = closeValues[seriesIndex];
         double median = (high + low) / 2.0;
         double atrFactorValue = atrValue * superTrendAtrFactor;
         double basicUpper = median + atrFactorValue;
         double basicLower = median - atrFactorValue;
         double prevClose = (index > 0) ? closeValues[seriesIndex + 1] : close;
         double prevFinalUpper = (index > 0) ? finalUpperValues[index - 1] : basicUpper;
         double prevFinalLower = (index > 0) ? finalLowerValues[index - 1] : basicLower;

         if (index == 0)
         {
            finalUpperValues[index] = basicUpper;
            finalLowerValues[index] = basicLower;
            if (close > finalLowerValues[index])
               directions[index] = 1;
            else if (close < finalUpperValues[index])
               directions[index] = -1;
            else
               if (close > finalLowerValues[index])
               directions[index] = 1;
            else if (close < finalUpperValues[index])
               directions[index] = -1;
            else
               directions[index] = (close >= median) ? 1 : -1;
            stValues[index] = (directions[index] > 0) ? finalLowerValues[index] : finalUpperValues[index];
            continue;
         }

         finalUpperValues[index] = (basicUpper < prevFinalUpper || prevClose > prevFinalUpper) ? basicUpper : prevFinalUpper;
         finalLowerValues[index] = (basicLower > prevFinalLower || prevClose < prevFinalLower) ? basicLower : prevFinalLower;
         if (close > finalLowerValues[index])
         {
            directions[index] = 1;
            stValues[index] = finalLowerValues[index];
         }
         else if (close < finalUpperValues[index])
         {
            directions[index] = -1;
            stValues[index] = finalUpperValues[index];
         }
         else
         {
            directions[index] = directions[index - 1];
            stValues[index] = (directions[index] > 0) ? finalLowerValues[index] : finalUpperValues[index];
         }
      }

      int lastIndex = SUPERTREND_INIT_BARS - 1;
      g_superTrendLast = stValues[lastIndex];
      g_superTrendLastDir = directions[lastIndex];
      g_superTrendFinalUpper = finalUpperValues[lastIndex];
      g_superTrendFinalLower = finalLowerValues[lastIndex];
      g_superTrend[1] = g_superTrendLast;
      g_superTrendDir[1] = g_superTrendLastDir;
      g_superTrend[2] = stValues[lastIndex - 1];
      g_superTrendDir[2] = directions[lastIndex - 1];
      g_superTrendInitialized = true;
      return true;
   }

   bool UpdateSuperTrend(double atrValue, const double &highValues[], const double &lowValues[], const double &closeValues[])
   {
      double prevClose = closeValues[2];
      double close = closeValues[1];
      double high = highValues[1];
      double low = lowValues[1];
      if (!IsIndicatorValueValid(prevClose) || !IsIndicatorValueValid(close) || !IsIndicatorValueValid(high) || !IsIndicatorValueValid(low) || !IsIndicatorValueValid(atrValue) || !IsIndicatorValueValid(g_superTrendLast) || !IsIndicatorValueValid(g_superTrendFinalUpper) || !IsIndicatorValueValid(g_superTrendFinalLower))
         return false;

      int previousDir = g_superTrendLastDir;
      double previousValue = g_superTrendLast;
      double basicUpper = (high + low) / 2.0 + atrValue * superTrendAtrFactor;
      double basicLower = (high + low) / 2.0 - atrValue * superTrendAtrFactor;
      double finalUpper = (basicUpper < g_superTrendFinalUpper || prevClose > g_superTrendFinalUpper) ? basicUpper : g_superTrendFinalUpper;
      double finalLower = (basicLower > g_superTrendFinalLower || prevClose < g_superTrendFinalLower) ? basicLower : g_superTrendFinalLower;
      int newDir = previousDir;
      double newValue = previousValue;
      if (previousDir > 0)
      {
         if (close < finalLower)
         {
            newDir = -1;
            newValue = finalUpper;
         }
         else
         {
            newDir = 1;
            newValue = finalLower;
         }
      }
      else if (previousDir < 0)
      {
         if (close > finalUpper)
         {
            newDir = 1;
            newValue = finalLower;
         }
         else
         {
            newDir = -1;
            newValue = finalUpper;
         }
      }
      else
      {
         newDir = (close > finalLower) ? 1 : -1;
         newValue = (newDir > 0) ? finalLower : finalUpper;
      }

      g_superTrendFinalUpper = finalUpper;
      g_superTrendFinalLower = finalLower;
      g_superTrend[2] = previousValue;
      g_superTrendDir[2] = previousDir;
      g_superTrend[1] = newValue;
      g_superTrendDir[1] = newDir;
      g_superTrendLast = g_superTrend[1];
      g_superTrendLastDir = g_superTrendDir[1];
      g_superTrendFlipBuy = previousDir < 0 && g_superTrendDir[1] > 0;
      g_superTrendFlipSell = previousDir > 0 && g_superTrendDir[1] < 0;
      return true;
   }

   void ComputeCloseDecision(TrendType h1Type)
   {
      g_closePriceBuy = 0.0;
      g_closePriceSell = 0.0;
      g_rangeClosePriceBuy = 0.0;
      g_rangeClosePriceSell = 0.0;
      g_trendSuperTrendClosePriceBuy = 0.0;
      g_trendSuperTrendClosePriceSell = 0.0;
      g_trendBBMiddleClosePriceBuy = 0.0;
      g_trendBBMiddleClosePriceSell = 0.0;
      g_stochasticCloseBuy = false;
      g_stochasticCloseSell = false;
      g_rangeBBCloseBuy = false;
      g_rangeBBCloseSell = false;
      g_trendSuperTrendCloseBuy = false;
      g_trendSuperTrendCloseSell = false;
      g_trendBBMiddleCloseBuy = false;
      g_trendBBMiddleCloseSell = false;
      g_closeBuyOnOrAbove = false;
      g_closeSellOnOrBelow = false;

      bool stochCrossDown = g_stochK[2] >= stochOverbought && g_stochK[1] < stochOverbought &&
                            g_stochK[2] >= g_stochD[2] && g_stochK[1] < g_stochD[1];
      bool stochCrossUp = g_stochK[2] <= stochOversold && g_stochK[1] > stochOversold &&
                          g_stochK[2] <= g_stochD[2] && g_stochK[1] > g_stochD[1];
      bool buyOverheatReversal = g_stochK[2] >= stochOverbought && g_stochK[1] < stochOverbought;
      bool sellOverheatReversal = g_stochK[2] <= stochOversold && g_stochK[1] > stochOversold;
      g_stochasticCloseBuy = stochCrossDown || buyOverheatReversal;
      g_stochasticCloseSell = stochCrossUp || sellOverheatReversal;

      if (h1Type == TREND_RANGE)
      {
         g_rangeClosePriceBuy = g_bbUpper[1];
         g_rangeClosePriceSell = g_bbLower[1];
         g_closePriceBuy = g_rangeClosePriceBuy;
         g_closePriceSell = g_rangeClosePriceSell;
         g_closeBuyOnOrAbove = true;
         g_closeSellOnOrBelow = true;
         g_rangeBBCloseBuy = true;
         g_rangeBBCloseSell = true;
      }
      else if (h1Type != TREND_UNKNOWN)
      {
         g_trendSuperTrendClosePriceBuy = g_superTrend[1];
         g_trendSuperTrendClosePriceSell = g_superTrend[1];
         g_closePriceBuy = g_trendSuperTrendClosePriceBuy;
         g_closePriceSell = g_trendSuperTrendClosePriceSell;
         g_closeBuyOnOrAbove = false;
         g_closeSellOnOrBelow = false;
         g_trendSuperTrendCloseBuy = true;
         g_trendSuperTrendCloseSell = true;
         g_trendBBMiddleClosePriceBuy = g_bbMiddle[1];
         g_trendBBMiddleClosePriceSell = g_bbMiddle[1];
         double close1 = iClose(_Symbol, PERIOD_M1, 1);
         double close2 = iClose(_Symbol, PERIOD_M1, 2);
         g_trendBBMiddleCloseBuy = close2 < g_bbMiddle[2] && close1 >= g_bbMiddle[1];
         g_trendBBMiddleCloseSell = close2 > g_bbMiddle[2] && close1 <= g_bbMiddle[1];
      }
   }

   void ComputeEntryExit(TrendType h1Type)
   {
      g_entryPriceBuy = 0.0;
      g_entryPriceSell = 0.0;
      g_canEntryBuy = false;
      g_canEntrySell = false;
      g_canCloseBuy = false;
      g_canCloseSell = false;
      g_pullbackThresholdBuy = 0.0;
      g_pullbackThresholdSell = 0.0;
      g_reaccelThresholdBuy = 0.0;
      g_reaccelThresholdSell = 0.0;

      ComputeCloseDecision(h1Type);

      if (h1Type != TREND_RANGE && h1Type != TREND_UNKNOWN && g_m1AllOk)
      {
         double atrValue = (g_atr[1] > 0.0) ? g_atr[1] : 0.0;
         g_pullbackThresholdBuy = g_superTrend[1] + atrValue * pullbackAtrFactor;
         g_pullbackThresholdSell = g_superTrend[1] - atrValue * pullbackAtrFactor;
         g_reaccelThresholdBuy = g_superTrend[1] + atrValue * reaccelAtrFactor;
         g_reaccelThresholdSell = g_superTrend[1] - atrValue * reaccelAtrFactor;
      }

      if (h1Type == TREND_RANGE)
      {
         g_entryPriceBuy = g_bbLower[1];
         g_entryPriceSell = g_bbUpper[1];
         g_entryBuyOnOrBelow = true;
         g_entrySellOnOrAbove = true;
         if (iClose(_Symbol, PERIOD_M1, 1) <= g_bbLower[1])
            g_entryThresholdCrossedBuy = true;
         if (iClose(_Symbol, PERIOD_M1, 1) >= g_bbUpper[1])
            g_entryThresholdCrossedSell = true;
         g_entryBuyOnOrBelow = false;
         g_entrySellOnOrAbove = false;
      }
      else if (h1Type == TREND_UNKNOWN)
      {
         g_entryPriceBuy = 0.0;
         g_entryPriceSell = 0.0;
         g_canEntryBuy = false;
         g_canEntrySell = false;
         g_canCloseBuy = false;
         g_canCloseSell = false;
      }
      else
      {
         g_entryThresholdCrossedBuy = false;
         g_entryThresholdCrossedSell = false;
         g_entryPriceBuy = g_superTrend[1];
         g_entryPriceSell = g_superTrend[1];
         g_entryBuyOnOrBelow = false;
         g_entrySellOnOrAbove = false;
         g_closeBuyOnOrAbove = false;
         g_closeSellOnOrBelow = false;
         g_canEntryBuy = g_superTrendFlipBuy || g_superTrendReaccelBuy || g_TrendStateH == RANGE_TO_TREND;
         g_canEntrySell = g_superTrendFlipSell || g_superTrendReaccelSell || g_TrendStateH == RANGE_TO_TREND;
      }

      if (g_entryPriceBuy <= 0.0)
         g_canEntryBuy = false;
      if (g_entryPriceSell <= 0.0)
         g_canEntrySell = false;
      if (h1Type == TREND_RANGE)
      {
         g_canEntryBuy = g_entryPriceBuy > 0.0;
         g_canEntrySell = g_entryPriceSell > 0.0;
      }
      if (g_closePriceBuy > 0.0)
         g_canCloseBuy = true;
      if (g_closePriceSell > 0.0)
         g_canCloseSell = true;

      if (!g_h1AllOk || !g_m15AllOk || !g_m1AllOk)
      {
         g_canEntryBuy = false; g_canEntrySell = false; g_canCloseBuy = false; g_canCloseSell = false;
      }

      if (g_entryPriceBuy > 0.0 && g_closePriceBuy > 0.0 && g_entryPriceBuy > g_closePriceBuy)
      {
         g_entryPriceBuy = 0.0;
         g_canEntryBuy = false;
      }
      if (g_entryPriceSell > 0.0 && g_closePriceSell > 0.0 && g_entryPriceSell < g_closePriceSell)
      {
         g_entryPriceSell = 0.0;
         g_canEntrySell = false;
      }

      PrintFormat("OnTimer: M1 ENTRY BUY=%.5f SELL=%.5f EXIT BUY=%.5f SELL=%.5f", g_entryPriceBuy, g_entryPriceSell, g_closePriceBuy, g_closePriceSell);
   }

   void UpdatePullback(double ask, double bid)
   {
      g_superTrendReaccelBuy = false;
      g_superTrendReaccelSell = false;

      bool hasPreviousPrice = g_previousAsk > 0.0 && g_previousBid > 0.0;
      if (hasPreviousPrice && g_m1AllOk && g_superTrendInitialized && g_TrendTypeH != TREND_RANGE && g_TrendTypeH != TREND_UNKNOWN)
      {
         if (g_superTrendDir[1] > 0)
         {
            if (g_previousAsk > g_pullbackThresholdBuy && ask <= g_pullbackThresholdBuy)
               g_superTrendPullbackBuy = true;
            if (g_superTrendPullbackBuy && g_previousAsk < g_reaccelThresholdBuy && ask >= g_reaccelThresholdBuy)
               g_superTrendReaccelBuy = true;
            g_superTrendPullbackSell = false;
         }
         else if (g_superTrendDir[1] < 0)
         {
            if (g_previousBid < g_pullbackThresholdSell && bid >= g_pullbackThresholdSell)
               g_superTrendPullbackSell = true;
            if (g_superTrendPullbackSell && g_previousBid > g_reaccelThresholdSell && bid <= g_reaccelThresholdSell)
               g_superTrendReaccelSell = true;
            g_superTrendPullbackBuy = false;
         }
      }

      g_previousAsk = ask;
      g_previousBid = bid;

      if (g_TrendTypeH != TREND_RANGE && g_TrendTypeH != TREND_UNKNOWN)
      {
         g_canEntryBuy = g_superTrendFlipBuy || g_superTrendReaccelBuy || g_TrendStateH == RANGE_TO_TREND;
         g_canEntrySell = g_superTrendFlipSell || g_superTrendReaccelSell || g_TrendStateH == RANGE_TO_TREND;
      }
   }
};

CTrend1H TrendH1;
CTrend15 TrendM15;
CTrend1M TrendM1;

// ===================================================================
// 取引関連の補助関数
// ===================================================================
bool SendMarketOrder(ENUM_ORDER_TYPE type, double volume, double sl, double tp)
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ask - bid) / _Point;
   double requestedPrice = type == ORDER_TYPE_BUY ? ask : bid;
   if (spreadPts > MaxAllowedSpread)
   {
      PrintFormat("発注中止：スプレッドが大きすぎます (%.1f)", spreadPts);
      return (false);
   }
   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.symbol = _Symbol;
   req.volume = volume;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.price = requestedPrice;
   req.sl = sl;
   req.tp = tp;
   req.type = type;
   bool sent = OrderSend(req, res);
   if (!sent)
   {
      RecordRequest(REQUEST_SEND_FAILED, res.retcode);
      PrintFormat("発注失敗 type=%s price=%.5f lot=%.2f SL=%.5f TP=%.5f spread=%.1f magic=%I64d retcode=%d comment=%s err=%d", type == ORDER_TYPE_BUY ? "BUY" : "SELL", requestedPrice, volume, sl, tp, spreadPts, MagicNumber, res.retcode, res.comment, GetLastError());
      return (false);
   }
   if (res.retcode != TRADE_RETCODE_DONE && res.retcode != TRADE_RETCODE_DONE_PARTIAL)
   {
      RecordRequest(REQUEST_EXECUTION_FAILED, res.retcode);
      PrintFormat("発注実行失敗 type=%s price=%.5f lot=%.2f SL=%.5f TP=%.5f spread=%.1f magic=%I64d retcode=%d comment=%s err=%d", type == ORDER_TYPE_BUY ? "BUY" : "SELL", requestedPrice, volume, sl, tp, spreadPts, MagicNumber, res.retcode, res.comment, GetLastError());
      return false;
   }
   RecordRequest(REQUEST_EXECUTION_SUCCEEDED, res.retcode);
   PrintFormat("発注成功 type=%s price=%.5f lot=%.2f SL=%.5f TP=%.5f spread=%.1f magic=%I64d order=%I64u deal=%I64u retcode=%d comment=%s",
               type == ORDER_TYPE_BUY ? "BUY" : "SELL",
               requestedPrice, volume, sl, tp, spreadPts, MagicNumber, res.order, res.deal, res.retcode, res.comment);
   return (true);
}

