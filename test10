bool GetAnalysisBarEventTime(datetime barTime, const MqlTick &tick,
                            datetime &eventTime, long &eventTimeMsc)
{
   if (barTime <= 0 || tick.time_msc <= 0 || tick.time <= 0 ||
       tick.time_msc != g_currentAnalysisEventTimeMsc || tick.time < barTime)
      return false;

   eventTime = (datetime)tick.time;
   eventTimeMsc = tick.time_msc;
   return true;
}

string AnalysisDirection(int direction)
{
   if (direction > 0)
      return "UP";
   if (direction < 0)
      return "DOWN";
   return "NONE";
}

string AnalysisArrayValue(const double &values[], int index, int digits)
{
   if (index < 0 || index >= ArraySize(values))
      return "";
   return AnalysisNumber(values[index], digits);
}

string EscapeAnalysisCsvField(const string value)
{
   string escaped = value;
   StringReplace(escaped, "\"", "\"\"");
   if (StringFind(escaped, ",") >= 0 || StringFind(escaped, "\"") >= 0 ||
       StringFind(escaped, "\r") >= 0 || StringFind(escaped, "\n") >= 0)
      return "\"" + escaped + "\"";
   return escaped;
}

string BuildAnalysisCsvLine(const string &values[])
{
   string line = "";
   for (int i = 0; i < ArraySize(values); i++)
   {
      if (i > 0)
         line += ",";
      line += EscapeAnalysisCsvField(values[i]);
   }
   return line + "\r\n";
}

