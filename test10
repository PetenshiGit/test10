               LogArrayValue(g_bbUpper, 1), LogArrayValue(g_bbMiddle, 1), LogArrayValue(g_bbLower, 1), LogArrayValue(g_superTrend, 1), LogSuperTrendDirection(1));
}

void ClosePositions(bool canClose, ENUM_POSITION_TYPE posType, double closePrice, double currentPrice)
{
   if (!canClose || closePrice <= 0)
      return;

   bool isBuy = (posType == POSITION_TYPE_BUY);
   bool rangeBBCondition = false;
   bool trendSuperTrendCondition = false;
   bool stochasticCondition = false;
   bool trendBBMiddleCondition = false;
   EvaluateCloseConditions(isBuy, currentPrice, stochasticCondition, rangeBBCondition, trendSuperTrendCondition, trendBBMiddleCondition);
   bool condition = rangeBBCondition || trendSuperTrendCondition || stochasticCondition || trendBBMiddleCondition;
   if (!condition)
   {
      if (isBuy)
         g_closeAnalysisMaskBuy = -1;
      else
         g_closeAnalysisMaskSell = -1;
      return;
   }

   PrintFormat("決済条件状態 type=%s Stochastic=%s RangeBB=%s TrendSuperTrend=%s TrendBB中央線=%s", isBuy ? "BUY" : "SELL", stochasticCondition ? "true" : "false", rangeBBCondition ? "true" : "false", trendSuperTrendCondition ? "true" : "false", trendBBMiddleCondition ? "true" : "false");
   string reason = BuildCloseReason(stochasticCondition, rangeBBCondition, trendSuperTrendCondition, trendBBMiddleCondition);
   int conditionMask = (stochasticCondition ? 1 : 0) | (rangeBBCondition ? 2 : 0) | (trendSuperTrendCondition ? 4 : 0) | (trendBBMiddleCondition ? 8 : 0);
   if ((isBuy && conditionMask != g_closeAnalysisMaskBuy) || (!isBuy && conditionMask != g_closeAnalysisMaskSell))
   {
      LogCloseConditionAnalysis(isBuy, currentPrice, stochasticCondition, rangeBBCondition, trendSuperTrendCondition, trendBBMiddleCondition);
      if (isBuy)
         g_closeAnalysisMaskBuy = conditionMask;
      else
         g_closeAnalysisMaskSell = conditionMask;
   }

   int count = isBuy ? BuyCount : SellCount;
   if (count <= 0)
      return;

   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      if (PositionGetInteger(POSITION_TYPE) != posType)
         continue;

      if (ClosePositionByTicket(ticket, reason))
      {
         if (isBuy)
            g_lastBuyCloseBarTime = LastM1;
         else
            g_lastSellCloseBarTime = LastM1;
      }
   }
}

// ===================================================================
// ヘルパー関数: エントリー処理
// グローバル変数 g_canEntryBuy/Sell, g_entryThresholdCrossedBuy/Sell を使用
// ===================================================================
void EnterPosition(bool canEntry, ENUM_POSITION_TYPE posType, double entryPrice, double currentPrice, double ask, double bid)
{
   if (g_weekendEntryStopped)
      return;
   if (!canEntry || entryPrice <= 0 || g_TrendTypeH == TREND_UNKNOWN || !g_h1AllOk || !g_m15AllOk || !g_m1AllOk)
      return;
   if (!IsIndicatorValueValid(entryPrice) || !IsIndicatorValueValid(ask) || !IsIndicatorValueValid(bid))
      return;

   bool isBuy = (posType == POSITION_TYPE_BUY);
   int sameDirCount = isBuy ? BuyCount : SellCount;
   if (g_TrendTypeH != TREND_RANGE && ((isBuy && g_H1DiDir != 1) || (!isBuy && g_H1DiDir != -1)))
      return;
   if ((isBuy && g_lastBuyCloseBarTime == LastM1) || (!isBuy && g_lastSellCloseBarTime == LastM1))
      return;
   bool allowPyramid = false;
   if (g_TrendTypeH == TREND_STRONG_UP && isBuy && g_H1DiDir == 1 && g_H1EmaDir == 1 && g_superTrendReaccelBuy && sameDirCount > 0)
      allowPyramid = true;
   if (g_TrendTypeH == TREND_STRONG_DOWN && !isBuy && g_H1DiDir == -1 && g_H1EmaDir == -1 && g_superTrendReaccelSell && sameDirCount > 0)
      allowPyramid = true;

   if (allowPyramid && !IsPyramidAllowedByM15(isBuy))
      return;

   if (!allowPyramid && sameDirCount >= maxPositionsNormal)
      return;
   if (allowPyramid && sameDirCount >= maxPositionsPyramid)
      return;

   if (isBuy && g_lastBuyEntryBarTime > 0 && LastM1 <= g_lastBuyEntryBarTime + PeriodSeconds(PERIOD_M1))
      return;
   if (!isBuy && g_lastSellEntryBarTime > 0 && LastM1 <= g_lastSellEntryBarTime + PeriodSeconds(PERIOD_M1))
      return;

   if (g_TrendTypeH == TREND_RANGE)
   {
      double bbWidth = g_bbUpper[1] - g_bbLower[1];
      bool bbWidthOk = bbWidth >= SL_Points * 1.5 * _Point;
      bool rangeBuyOk = bbWidthOk && g_m15_rsi_ok && g_m1_bb_ok && g_m15_rsiArr[1] <= rsiOversold && g_entryThresholdCrossedBuy && ask >= entryPrice;
      bool rangeSellOk = bbWidthOk && g_m15_rsi_ok && g_m1_bb_ok && g_m15_rsiArr[1] >= rsiOverbought && g_entryThresholdCrossedSell && bid <= entryPrice;
      if (isBuy && !rangeBuyOk) return;
      if (!isBuy && !rangeSellOk) return;
   }

   bool condition = false;
   if (isBuy)
      condition = g_entryBuyOnOrBelow ? (ask <= entryPrice) : (ask >= entryPrice);
   else
      condition = g_entrySellOnOrAbove ? (bid >= entryPrice) : (bid <= entryPrice);
   if (!condition)
      return;

   double price = currentPrice;
   double sl = EnableStopLoss ? (isBuy ? (price - SL_Points * _Point) : (price + SL_Points * _Point)) : 0.0;
   double tp = 0.0;
   if (g_TrendTypeH == TREND_RANGE && EnableRangeTP)
      tp = isBuy ? (price + SL_Points * RiskRewardRatio * _Point) : (price - SL_Points * RiskRewardRatio * _Point);

   double lot = BaseLot;
   if (g_TrendTypeH == TREND_RANGE)
      lot *= lot_range;
   else if (allowPyramid)
      lot = BaseLot * lot_strong_pyramid;
   else
      lot *= lot_initial_trend;

   double vol_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double vol_min = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   if (vol_step <= 0)
      vol_step = 0.01;
   if (vol_min <= 0)
      vol_min = vol_step;
   double steps = MathRound(lot / vol_step);
   lot = MathMax(vol_min, steps * vol_step);

   if (lot > 0)
   {
      ENUM_ORDER_TYPE orderType = isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
      if (SendMarketOrder(orderType, lot, sl, tp))
      {
         if (isBuy)
         {
            g_lastBuyEntryBarTime = LastM1;
            g_entryThresholdCrossedBuy = false;
            if (allowPyramid)
               g_superTrendPullbackBuy = false;
         }
         else
         {
            g_lastSellEntryBarTime = LastM1;
            g_entryThresholdCrossedSell = false;
            if (allowPyramid)
               g_superTrendPullbackSell = false;
         }
         PrintFormat("OnTick: 条件達成により %s を発注しました。Lot=%.2f SL=%.5f TP=%.5f", isBuy ? "BUY" : "SELL", lot, sl, tp);
      }
   }
}

//+------------------------------------------------------------------+
//| Expert tick function                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   double ASK = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double BID = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ASK - BID) / _Point;

   if (ASK <= 0 || BID <= 0)
   {
      PrintFormat("価格データが無効のため処理を中断します。ASK=%.5f BID=%.5f スプレッド=%.1fポイント",
                  ASK, BID, spreadPts);
      return;
   }

   if (g_weekendForceCloseActive)
      return;

   // BuyCount/SellCount の判定をg_closePrice 判定より前に移動
   NowPositions = 0;
   BuyCount = 0;
   SellCount = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      NowPositions++;
      if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
         BuyCount++;
      else if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL)
         SellCount++;
   }

   // 決済処理
   TrendM1.UpdatePullback(ASK, BID);
   if (g_TrendTypeH == TREND_RANGE)
   {
      if (BID <= g_bbLower[1])
         g_entryThresholdCrossedBuy = true;
      if (ASK >= g_bbUpper[1])
         g_entryThresholdCrossedSell = true;
   }
   ClosePositions(g_canCloseBuy, POSITION_TYPE_BUY, g_closePriceBuy, BID);
   ClosePositions(g_canCloseSell, POSITION_TYPE_SELL, g_closePriceSell, ASK);

   bool buyCloseSignal = false;
   bool sellCloseSignal = false;
   if (g_canCloseBuy && g_closePriceBuy > 0)
   {
      bool stochasticCondition = false;
      bool rangeBBCondition = false;
      bool trendSuperTrendCondition = false;
      bool trendBBMiddleCondition = false;
      EvaluateCloseConditions(true, BID, stochasticCondition, rangeBBCondition, trendSuperTrendCondition, trendBBMiddleCondition);
      buyCloseSignal = rangeBBCondition || trendSuperTrendCondition || stochasticCondition || trendBBMiddleCondition;
   }
   if (g_canCloseSell && g_closePriceSell > 0)
   {
      bool stochasticCondition = false;
      bool rangeBBCondition = false;
      bool trendSuperTrendCondition = false;
      bool trendBBMiddleCondition = false;
      EvaluateCloseConditions(false, ASK, stochasticCondition, rangeBBCondition, trendSuperTrendCondition, trendBBMiddleCondition);
      sellCloseSignal = rangeBBCondition || trendSuperTrendCondition || stochasticCondition || trendBBMiddleCondition;
   }

   UpdateTrailingStops();

   // 決済後にスプレッド閾値チェック（スプレッドが大きければエントリを中止）
   if (spreadPts >= MaxAllowedSpread)
   {
      // PrintFormat("スプレッドが閾値を超えたため処理を中断します。ASK=%.5f BID=%.5f スプレッド=%.1fポイント 閾値=%dポイント",
      //             ASK, BID, spreadPts, MaxAllowedSpread);
      return;
   }

   // エントリ判定は OnTimer で算出した価格・フラグを使用
   static datetime lastBuySuppressionLogBar = 0;
   static datetime lastSellSuppressionLogBar = 0;
   if (g_canEntryBuy && !EnableEntryOnCloseSignal && buyCloseSignal)
   {
      if (lastBuySuppressionLogBar != LastM1)
      {
         PrintFormat("新規BUY発注抑制：BUY決済シグナル成立");
         lastBuySuppressionLogBar = LastM1;
      }
   }
   else
   {
      EnterPosition(g_canEntryBuy, POSITION_TYPE_BUY, g_entryPriceBuy, ASK, ASK, BID);
   }
   if (g_canEntrySell && !EnableEntryOnCloseSignal && sellCloseSignal)
   {
      if (lastSellSuppressionLogBar != LastM1)
      {
         PrintFormat("新規SELL発注抑制：SELL決済シグナル成立");
         lastSellSuppressionLogBar = LastM1;
      }
   }
   else
   {
      EnterPosition(g_canEntrySell, POSITION_TYPE_SELL, g_entryPriceSell, BID, ASK, BID);
   }
}

