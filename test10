void ReleaseLightSnapshotsForCompletedOrder(ulong orderId, int currentEventIndex)
{
   if (orderId == 0 || !HistoryOrderSelect(orderId))
      return;
   long state = HistoryOrderGetInteger(orderId, ORDER_STATE);
   if (state != ORDER_STATE_FILLED && state != ORDER_STATE_CANCELED &&
       state != ORDER_STATE_REJECTED && state != ORDER_STATE_EXPIRED)
      return;
   for (int i = 0; i < ArraySize(g_pendingTradeEvents); i++)
   {
      if (i != currentEventIndex && g_pendingTradeEvents[i].order == orderId)
         return;
   }
   RemoveLightEntrySnapshotByOrder(orderId);
   RemoveLightExitSnapshotByOrder(orderId);
}

void BuildLightEntryRecordFromDeal(SLightAnalysisRecord &rec, ulong dealId, ulong orderId, ulong positionId, datetime dealTime,
                               long dealTimeMsc, double price, double volume, const string direction,
                               double requestedPrice, double orderVolume, const string dealReason)
{
   SLightEntrySnapshot snap;
   bool found = false;
   if (orderId > 0)
   found = FindLightEntrySnapshotByOrder(orderId, snap);
   if (!found && dealId > 0)
   found = FindLightEntrySnapshotByDeal(dealId, snap);

   ResetLightAnalysisRecord(rec, "ENTRY");
   rec.values[LAF_DATE_TIME] = AnalysisDateTime(dealTime);
   rec.values[LAF_TIME_MSC] = AnalysisLong(dealTimeMsc);
   rec.values[LAF_SYMBOL] = _Symbol;
   rec.values[LAF_DIRECTION] = direction;
   rec.values[LAF_POSITION] = AnalysisLong((long)positionId);
   rec.values[LAF_ORDER] = AnalysisLong((long)orderId);
   rec.values[LAF_DEAL] = AnalysisLong((long)dealId);
   double recordedOrderVolume = found ? snap.orderVolume : orderVolume;
   double recordedRequestedPrice = found ? snap.requestedPrice : requestedPrice;
   if (recordedOrderVolume > 0.0)
      rec.values[LAF_ORDER_VOLUME] = AnalysisNumber(recordedOrderVolume, 2);
   rec.values[LAF_DEAL_VOLUME] = AnalysisNumber(volume, 2);
   if (recordedRequestedPrice > 0.0)
      rec.values[LAF_REQUESTED_PRICE] = AnalysisNumber(recordedRequestedPrice, _Digits);
   rec.values[LAF_EXECUTION_PRICE] = AnalysisNumber(price, _Digits);
   if (found)
   {
   rec.values[LAF_SPREAD_POINTS] = AnalysisNumber(snap.spreadPoints, 1);
   rec.values[LAF_SL] = AnalysisNumber(snap.sl, _Digits);
   rec.values[LAF_TP] = AnalysisNumber(snap.tp, _Digits);
   rec.values[LAF_ENTRY_SIGNAL] = snap.entrySignal;
   }
   rec.values[LAF_REASON] = dealReason;
}

void BuildLightExitRecordFromDeal(SLightAnalysisRecord &rec, ulong dealId, ulong orderId, ulong positionId, datetime dealTime,
                              long dealTimeMsc, double price, double volume, const string direction,
                              long dealReason, double dealProfit, double dealCommission,
                              double dealSwap, double dealFee, const string exitSignalReason,
                              double requestedPrice, double orderVolume,
                              datetime entryTime, long entryTimeMsc)
{
   SLightExitSnapshot snap;
   bool found = false;
   if (orderId > 0)
   found = FindLightExitSnapshotByOrder(orderId, snap);
   if (!found && dealId > 0)
   found = FindLightExitSnapshotByDeal(dealId, snap);

   ResetLightAnalysisRecord(rec, "EXIT");
   rec.values[LAF_DATE_TIME] = AnalysisDateTime(dealTime);
   rec.values[LAF_TIME_MSC] = AnalysisLong(dealTimeMsc);
   rec.values[LAF_SYMBOL] = _Symbol;
   rec.values[LAF_DIRECTION] = direction;
   rec.values[LAF_POSITION] = AnalysisLong((long)positionId);
   rec.values[LAF_ORDER] = AnalysisLong((long)orderId);
   rec.values[LAF_DEAL] = AnalysisLong((long)dealId);
   double recordedOrderVolume = found ? snap.orderVolume : orderVolume;
   if (recordedOrderVolume > 0.0)
      rec.values[LAF_ORDER_VOLUME] = AnalysisNumber(recordedOrderVolume, 2);
   rec.values[LAF_DEAL_VOLUME] = AnalysisNumber(volume, 2);
   double recordedRequestedPrice = found ? snap.requestedPrice : requestedPrice;
   if (recordedRequestedPrice > 0.0 &&
       dealReason != DEAL_REASON_SL && dealReason != DEAL_REASON_TP)
      rec.values[LAF_REQUESTED_PRICE] = AnalysisNumber(recordedRequestedPrice, _Digits);
   rec.values[LAF_EXECUTION_PRICE] = AnalysisNumber(price, _Digits);
   rec.values[LAF_DEAL_REASON] = EnumToString((ENUM_DEAL_REASON)dealReason);
   rec.values[LAF_DEAL_PROFIT] = AnalysisNumber(dealProfit, 2);
   rec.values[LAF_DEAL_COMMISSION] = AnalysisNumber(dealCommission, 2);
   rec.values[LAF_DEAL_SWAP] = AnalysisNumber(dealSwap, 2);
   rec.values[LAF_DEAL_FEE] = AnalysisNumber(dealFee, 2);
   if (entryTime > 0 && entryTimeMsc > 0)
   rec.values[LAF_ELAPSED_SECONDS] = AnalysisNumber((dealTimeMsc - entryTimeMsc) / 1000.0, 1);
   if (found)
   {
   rec.values[LAF_EXIT_SIGNAL_REASON] = snap.exitSignalReason;
   }
   rec.values[LAF_REASON] = exitSignalReason;
}

