   return StringFormat("EA_Analysis_LIGHT_%s_SERVER%04d%02d%02d_%02d%02d%02d.csv",
                    g_analysisRunId, dateTime.year, dateTime.mon, dateTime.day,
                    dateTime.hour, dateTime.min, dateTime.sec);
}

bool IsLightAnalysisCsvInitialized(const string fileName)
{
   for (int i = 0; i < ArraySize(g_lightInitializedAnalysisFiles); i++)
   if (g_lightInitializedAnalysisFiles[i] == fileName)
      return true;
   return false;
}

bool OpenLightAnalysisCsv(datetime recordTime)
{
   if (!EnableAnalysisCsv)
   return true;

   datetime weekStart = GetAnalysisWeekStart(recordTime);
   if (weekStart <= 0)
   return false;
   string csvFileName = GenerateLightAnalysisCsvFileName(weekStart);
   if (csvFileName == "")
   return false;
   if (g_lightAnalysisFile != INVALID_HANDLE && g_lightAnalysisFileName == csvFileName)
   return true;
   if (g_lightAnalysisFile != INVALID_HANDLE)
   {
   FileFlush(g_lightAnalysisFile);
   FileClose(g_lightAnalysisFile);
   g_lightAnalysisFile = INVALID_HANDLE;
   g_lightAnalysisFileName = "";
   }

   bool initializedThisRun = IsLightAnalysisCsvInitialized(csvFileName);
   if (initializedThisRun)
   g_lightAnalysisFile = FileOpen(csvFileName, FILE_READ | FILE_WRITE | FILE_TXT | FILE_ANSI, '\t', CP_UTF8);
   else
   {
   if (FileIsExist(csvFileName) && !FileDelete(csvFileName))
      return false;
   g_lightAnalysisFile = FileOpen(csvFileName, FILE_WRITE | FILE_TXT | FILE_ANSI, '\t', CP_UTF8);
   }
   if (g_lightAnalysisFile == INVALID_HANDLE)
   return false;
   if (initializedThisRun)
   {
   if (!FileSeek(g_lightAnalysisFile, 0, SEEK_END))
   {
      FileClose(g_lightAnalysisFile);
      g_lightAnalysisFile = INVALID_HANDLE;
      return false;
   }
   }
   else
   {
   static string lightHeaders[LIGHT_ANALYSIS_FIELD_COUNT];
   lightHeaders[0] = "RecordType";
   lightHeaders[1] = "DateTime";
   lightHeaders[2] = "TimeMsc";
   lightHeaders[3] = "Symbol";
   lightHeaders[4] = "Direction";
   lightHeaders[5] = "Position";
   lightHeaders[6] = "Order";
   lightHeaders[7] = "Deal";
   lightHeaders[8] = "OrderVolume";
   lightHeaders[9] = "DealVolume";
   lightHeaders[10] = "RequestedPrice";
   lightHeaders[11] = "ExecutionPrice";
   lightHeaders[12] = "SpreadPoints";
   lightHeaders[13] = "SL";
   lightHeaders[14] = "TP";
   lightHeaders[15] = "EntrySignal";
   lightHeaders[16] = "DealReason";
   lightHeaders[17] = "ExitSignalReason";
   lightHeaders[18] = "ElapsedSeconds";
   lightHeaders[19] = "DealProfit";
   lightHeaders[20] = "DealCommission";
   lightHeaders[21] = "DealSwap";
   lightHeaders[22] = "DealFee";
   lightHeaders[23] = "Reason";
   if (FileWriteString(g_lightAnalysisFile, BuildLightAnalysisCsvLine(lightHeaders)) == 0)
   {
      FileClose(g_lightAnalysisFile);
      g_lightAnalysisFile = INVALID_HANDLE;
      return false;
   }
   int initializedCount = ArraySize(g_lightInitializedAnalysisFiles);
   if (ArrayResize(g_lightInitializedAnalysisFiles, initializedCount + 1) != initializedCount + 1)
   {
      FileClose(g_lightAnalysisFile);
      g_lightAnalysisFile = INVALID_HANDLE;
      return false;
   }
   g_lightInitializedAnalysisFiles[initializedCount] = csvFileName;
   }
   g_lightAnalysisFileName = csvFileName;
   return true;
}

bool WriteLightAnalysisRecord(SLightAnalysisRecord &record)
{
   if (!EnableAnalysisCsv)
   return true;

   if (record.values[LAF_DATE_TIME] == "")
   return false;
   datetime recordTime = StringToTime(record.values[LAF_DATE_TIME]);
   if (recordTime <= 0)
   return false;
   if (!OpenLightAnalysisCsv(recordTime))
   {
   g_lightAnalysisWriteFailureCount++;
   return false;
   }
   if (FileWriteString(g_lightAnalysisFile, BuildLightAnalysisCsvLine(record.values)) == 0)
   {
   g_lightAnalysisWriteFailureCount++;
   return false;
   }
   g_lightAnalysisWriteSuccessCount++;
   return true;
}

void CloseLightAnalysisCsv()
{
   if (g_lightAnalysisFile != INVALID_HANDLE)
   {
   FileFlush(g_lightAnalysisFile);
   FileClose(g_lightAnalysisFile);
   g_lightAnalysisFile = INVALID_HANDLE;
   g_lightAnalysisFileName = "";
   }
}

