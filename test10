// ===================================================================
bool SendMarketOrder(ENUM_ORDER_TYPE type, double volume, double sl, double tp, EntrySignalType signal)
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ask - bid) / _Point;
   double requestedPrice = type == ORDER_TYPE_BUY ? ask : bid;
   if (spreadPts > MaxAllowedSpread)
   {
      PrintFormat("発注中止：スプレッドが大きすぎます (%.1f)", spreadPts);
      if (EnableAnalysisCsv)
         LogEntrySuppression(type == ORDER_TYPE_BUY, 0.0, "Order request",
                             ENTRY_SUPPRESS_SPREAD, "Spread limit checked before OrderSend.",
                             ask, bid);
      return (false);
   }
   MqlTradeRequest req;
   MqlTradeResult res;
   ZeroMemory(req);
   ZeroMemory(res);
   req.action = TRADE_ACTION_DEAL;
   req.symbol = _Symbol;
   req.volume = volume;
   req.deviation = 10;
   req.type_filling = ORDER_FILLING_FOK;
   req.magic = MagicNumber;
   req.price = requestedPrice;
   req.sl = sl;
   req.tp = tp;
   req.type = type;
   bool isBuy = type == ORDER_TYPE_BUY;
   MarkAtr2OrderAttempt(isBuy, signal);
   datetime requestTime = GetRequestServerTime();
   bool sent = OrderSend(req, res);
   RequestEvaluation evaluation = !sent ? REQUEST_SEND_FAILED :
      ((res.retcode == TRADE_RETCODE_DONE || res.retcode == TRADE_RETCODE_DONE_PARTIAL)
       ? REQUEST_EXECUTION_SUCCEEDED : REQUEST_EXECUTION_FAILED);
   RecordRequest(type == ORDER_TYPE_BUY ? "新規BUY発注" : "新規SELL発注",
                 evaluation, res.retcode, requestTime);
   if (!sent)
   {
      PrintFormat("発注失敗 type=%s price=%.5f lot=%.2f SL=%.5f TP=%.5f spread=%.1f magic=%I64d retcode=%d comment=%s err=%d", type == ORDER_TYPE_BUY ? "BUY" : "SELL", requestedPrice, volume, sl, tp, spreadPts, MagicNumber, res.retcode, res.comment, GetLastError());
      if (EnableAnalysisCsv)
         LogEntrySuppression(type == ORDER_TYPE_BUY, requestedPrice, "Order request",
                             ENTRY_SUPPRESS_SEND_FAILURE,
                             StringFormat("OrderSend failed;retcode=%d", res.retcode), ask, bid);
      return (false);
   }
   if (res.retcode != TRADE_RETCODE_DONE && res.retcode != TRADE_RETCODE_DONE_PARTIAL)
   {
      PrintFormat("発注実行失敗 type=%s price=%.5f lot=%.2f SL=%.5f TP=%.5f spread=%.1f magic=%I64d retcode=%d comment=%s err=%d", type == ORDER_TYPE_BUY ? "BUY" : "SELL", requestedPrice, volume, sl, tp, spreadPts, MagicNumber, res.retcode, res.comment, GetLastError());
      if (EnableAnalysisCsv)
         LogEntrySuppression(type == ORDER_TYPE_BUY, requestedPrice, "Order request",
                             ENTRY_SUPPRESS_SEND_FAILURE,
                             StringFormat("Order execution rejected;retcode=%d", res.retcode), ask, bid);
      return false;
   }
   if (EnableAnalysisCsv)
   {
      SAnalysisRecord analysis;
      ResetAnalysisRecord(analysis, "ENTRY_REQUEST");
      long positionId = 0;
      double executionPrice = 0.0;
      if (res.deal > 0)
      {
         ResetLastError();
         if (HistoryDealSelect(res.deal))
         {
            positionId = HistoryDealGetInteger(res.deal, DEAL_POSITION_ID);
            executionPrice = HistoryDealGetDouble(res.deal, DEAL_PRICE);
         }
         else
            PrintFormat("Deal情報取得中止：Deal選択失敗 deal=%I64u error=%d", res.deal, GetLastError());
      }
      SetAnalysisContext(analysis, requestTime, (long)requestTime * 1000L);
      analysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
      analysis.values[AC_BID] = AnalysisNumber(bid, _Digits);
      analysis.values[AC_ASK] = AnalysisNumber(ask, _Digits);
      analysis.values[AC_SPREAD_POINTS] = AnalysisNumber(spreadPts, 1);
      analysis.values[AC_LOT] = AnalysisNumber(volume, 2);
      analysis.values[AC_ORDER_VOLUME] = AnalysisNumber(req.volume, 2);
      analysis.values[AC_ORDER] = AnalysisLong((long)res.order);
      analysis.values[AC_DEAL] = AnalysisLong((long)res.deal);
      analysis.values[AC_REQUESTED_PRICE] = AnalysisNumber(requestedPrice, _Digits);
      if (executionPrice > 0.0)
      {
         analysis.values[AC_PRICE] = AnalysisNumber(executionPrice, _Digits);
         analysis.values[AC_EXECUTION_PRICE] = AnalysisNumber(executionPrice, _Digits);
      }
      analysis.values[AC_SL] = AnalysisNumber(sl, _Digits);
      analysis.values[AC_TP] = AnalysisNumber(tp, _Digits);
      analysis.values[AC_MAGIC_NUMBER] = AnalysisLong(MagicNumber);
      analysis.values[AC_RETCODE] = IntegerToString((int)res.retcode);
      analysis.values[AC_COMMENT] = res.comment;
      if (positionId > 0)
         analysis.values[AC_POSITION] = AnalysisLong(positionId);
      WriteAnalysisRecord(analysis);
      CaptureEntryLightSnapshot(res.order, res.deal, req.price, req.volume, spreadPts, sl, tp,
                               EnumToString(signal));
      FlushTradeTickHistoryToCsv();
      g_tradeTickWritePos = 0;
      g_tradeTickCount = 0;
      MarkAtr2EntryExecuted(isBuy, signal);
   }
   return (true);
}

