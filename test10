// ===================================================================
// IsIndicatorValueValid: 指標値の有効性判定
// 0値は必ずしも無効値ではありません（MACD Histogram等では正当な0値が存在）
// したがって、0値チェック（v != 0.0）は除外しています
// ===================================================================
bool IsIndicatorValueValid(double v)
{
   return (MathIsValidNumber(v) && v != EMPTY_VALUE);
}

bool AreIndicatorValuesValid(const double &values[])
{
   for (int i = 0; i < ArraySize(values); i++)
      if (!IsIndicatorValueValid(values[i]))
         return false;
   return ArraySize(values) == INDICATOR_BARS;
}

bool ArePriceValuesValid(const double &values[])
{
   if (ArraySize(values) != INDICATOR_BARS)
      return(false);
   for (int i = 0; i < INDICATOR_BARS; i++)
      if (!IsIndicatorValueValid(values[i]))
         return(false);
   return(true);
}

void LogArrayValues(const string name, const double &values[])
{
   for (int i = 0; i < ArraySize(values); i++)
      PrintFormat("取得成功 %s[%d]=%.10f", name, i, values[i]);
}

void LogInvalidArrayValues(const string name, const double &values[])
{
   for (int i = 0; i < ArraySize(values); i++)
      if (!IsIndicatorValueValid(values[i]))
         PrintFormat("無効値 %s[%d]=%.10f EMPTY=%s NaN=%s", name, i, values[i], values[i] == EMPTY_VALUE ? "YES" : "NO", MathIsValidNumber(values[i]) ? "NO" : "YES");
}

bool CopyBufferWithRetry(int handle, int buffer, double &values[], const string name = "", ENUM_TIMEFRAMES timeframe = PERIOD_CURRENT)
{
   ArraySetAsSeries(values, true);
   int copied = 0;
   for (int attempt = 0; attempt < 3; attempt++)
   {
      ResetLastError();
      copied = CopyBuffer(handle, buffer, 0, INDICATOR_BARS, values);
      if (copied == INDICATOR_BARS &&
          AreIndicatorValuesValid(values))
      {
         if (name != "")
         {
            if (attempt > 0)
               PrintFormat("指標取得リトライ成功 name=%s 成功試行=%d回目", name, attempt + 1);
            // LogArrayValues(name, values);
         }
         return(true);
      }
      if (attempt < 2)
      {
         if (attempt == 0)
            PrintFormat("指標取得失敗：初回取得失敗、リトライ開始 name=%s handle=%d timeframe=%s", name, handle, EnumToString(timeframe));
         PrintFormat("指標取得リトライ：%d回目 name=%s", attempt + 1, name);
         Sleep(100);
      }
   }
   PrintFormat("指標取得失敗 name=%s handle=%d timeframe=%s required=%d copied=%d lastError=%d", name, handle, EnumToString(timeframe), INDICATOR_BARS, copied, GetLastError());
   PrintFormat("指標取得リトライ失敗 name=%s 最終試行=%d回目", name, 3);
   LogArrayValues(name, values);
   LogInvalidArrayValues(name, values);
   return(false);
}

