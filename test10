datetime GetAnalysisWeekStart(datetime recordTime)
{
   MqlDateTime dateTime;
   if (recordTime <= 0 || !TimeToStruct(recordTime, dateTime))
      return 0;

   dateTime.hour = 0;
   dateTime.min = 0;
   dateTime.sec = 0;
   datetime dayStart = StructToTime(dateTime);
   if (dayStart <= 0)
      return 0;
   return dayStart - (datetime)(dateTime.day_of_week * 86400);
}

string GenerateAnalysisCsvFileName(datetime weekStart)
{
   MqlDateTime dateTime;
   if (g_analysisRunId == "" || weekStart <= 0 || !TimeToStruct(weekStart, dateTime))
   {
      PrintFormat("CSVファイル名の生成に失敗しました。runId=%s weekStart=%s error=%d",
                  g_analysisRunId, TimeToString(weekStart, TIME_DATE | TIME_SECONDS), GetLastError());
      return "";
   }

   return StringFormat("EA_Analysis_%s_SERVER%04d%02d%02d_%02d%02d%02d.csv",
                       g_analysisRunId, dateTime.year, dateTime.mon, dateTime.day,
                       dateTime.hour, dateTime.min, dateTime.sec);
}

