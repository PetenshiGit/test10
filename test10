   if (h_adx != INVALID_HANDLE) IndicatorRelease(h_adx);
   if (h_emaS != INVALID_HANDLE) IndicatorRelease(h_emaS);
   if (h_emaL != INVALID_HANDLE) IndicatorRelease(h_emaL);
