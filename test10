string BuildCloseReason(bool stochasticCondition)
{
   string reason = "";
   if (stochasticCondition)
      reason += "Stochastic過熱域クロス/反転";
   return reason == "" ? "不明" : reason;
}

double LogArrayValue(const double &values[], int index)
{
   if (index < 0 || index >= ArraySize(values))
      return EMPTY_VALUE;
   return values[index];
}

string LogSuperTrendDirection(int index)
{
   if (index < 0 || index >= ArraySize(g_superTrendDir))
      return "NONE";
   if (g_superTrendDir[index] > 0)
      return "UP";
   if (g_superTrendDir[index] < 0)
      return "DOWN";
   return "NONE";
}

string EntrySignalToString(EntrySignalType signal)
{
   if (!EnableAnalysisCsv)
      return "";
   return EnumToString(signal);
}

void StoreLastTrendEntrySignal(bool isBuy, EntrySignalType signal)
{
   if (!EnableAnalysisCsv)
      return;
   if (isBuy)
      g_lastTrendEntrySignalBuy = signal;
   else
      g_lastTrendEntrySignalSell = signal;
}

EntrySignalType EvaluateTrendEntrySignal(bool isBuy)
{
   EntrySignalType signal = ENTRY_SIGNAL_NONE;
   if (!g_h1AllOk || !g_m1AllOk || !g_m15AllOk)
      return signal;
   if (g_TrendTypeH == TREND_UNKNOWN || g_TrendTypeH == TREND_RANGE ||
       g_TrendTypeH == TREND_DIRECTION_UNKNOWN)
      return signal;
   if (g_atr[1] <= 0.0 || !IsIndicatorValueValid(g_atr[1]))
      return signal;

   bool trendUp = (g_TrendTypeH == TREND_STRONG_UP || g_TrendTypeH == TREND_WEAK_UP);
   bool trendDown = (g_TrendTypeH == TREND_STRONG_DOWN || g_TrendTypeH == TREND_WEAK_DOWN);
   if (!trendUp && !trendDown)
      return signal;

   double bbWidth = g_bbUpper[1] - g_bbLower[1];
   double atr = g_atr[1];
   long buyAtr2ElapsedMs = (g_atr2BuyEvent.startTimeMsc > 0 && g_atr2BuyEvent.active) ? (AnalysisCurrentTimeMsc() - g_atr2BuyEvent.startTimeMsc) : 0;
   long sellAtr2ElapsedMs = (g_atr2SellEvent.startTimeMsc > 0 && g_atr2SellEvent.active) ? (AnalysisCurrentTimeMsc() - g_atr2SellEvent.startTimeMsc) : 0;
   if (isBuy)
   {
      bool atr2Ok = g_atr2BuyEvent.active && g_atr2BuyEvent.tickIndex >= 3 &&
                    SymbolInfoDouble(_Symbol, SYMBOL_ASK) > g_currentAtr2BoundaryBuy &&
                    (atr2MinExtensionSeconds <= 0.0 || buyAtr2ElapsedMs >= (long)(atr2MinExtensionSeconds * 1000.0));
      if (trendUp && g_superTrendDir[1] > 0 && atr2Ok)
      {
         signal = ENTRY_SIGNAL_ATR2_EXTENSION;
         StoreLastTrendEntrySignal(true, signal);
         return signal;
      }
      if (trendUp && g_superTrendDir[1] > 0 && g_superTrendReaccelBuy)
      {
         signal = ENTRY_SIGNAL_REACCEL;
         StoreLastTrendEntrySignal(true, signal);
         return signal;
      }
      if (trendUp && g_superTrendDir[1] > 0)
      {
         if (g_initialBreakoutPriceReady && bbWidth / atr >= initialBreakoutMinBBATR)
         {
            double currentAsk = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            if (currentAsk > g_initialBreakoutHighestHigh && (currentAsk - g_bbMiddle[1]) <= atr * initialBreakoutMaxExtensionATR)
            {
               signal = ENTRY_SIGNAL_INITIAL_BREAKOUT;
               StoreLastTrendEntrySignal(true, signal);
               return signal;
            }
         }
         if (ArraySize(g_m1Close) >= 4 &&
             bbWidth / atr >= continuationMinBBATR &&
             g_m1Close[1] > g_bbMiddle[1] + atr * continuationMinDistanceATR &&
             g_m1Close[1] > g_m1Close[2] && g_m1Close[2] >= g_m1Close[3])
         {
            int lookback = MathMin(continuationLookback, MathMax(0, ArraySize(g_m1High) - 2));
            if (lookback > 0)
            {
               double highestHigh = g_m1High[2];
               for (int i = 3; i <= lookback + 1 && i < ArraySize(g_m1High); i++)
                  if (g_m1High[i] > highestHigh)
                     highestHigh = g_m1High[i];
               if (highestHigh - g_m1Close[1] <= atr * continuationMinDistanceATR &&
                   g_m1Close[1] - g_bbMiddle[1] <= atr * continuationMaxExtensionATR)
               {
                  signal = ENTRY_SIGNAL_CONTINUATION;
                  StoreLastTrendEntrySignal(true, signal);
                  return signal;
               }
            }
         }
      }
   }
   else
   {
      bool atr2Ok = g_atr2SellEvent.active && g_atr2SellEvent.tickIndex >= 3 &&
                    SymbolInfoDouble(_Symbol, SYMBOL_BID) < g_currentAtr2BoundarySell &&
                    (atr2MinExtensionSeconds <= 0.0 || sellAtr2ElapsedMs >= (long)(atr2MinExtensionSeconds * 1000.0));
      if (trendDown && g_superTrendDir[1] < 0 && atr2Ok)
      {
         signal = ENTRY_SIGNAL_ATR2_EXTENSION;
         StoreLastTrendEntrySignal(false, signal);
         return signal;
      }
      if (trendDown && g_superTrendDir[1] < 0 && g_superTrendReaccelSell)
      {
         signal = ENTRY_SIGNAL_REACCEL;
         StoreLastTrendEntrySignal(false, signal);
         return signal;
      }
      if (trendDown && g_superTrendDir[1] < 0)
      {
         if (g_initialBreakoutPriceReady && bbWidth / atr >= initialBreakoutMinBBATR)
         {
            double currentBid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
            if (currentBid < g_initialBreakoutLowestLow && (g_bbMiddle[1] - currentBid) <= atr * initialBreakoutMaxExtensionATR)
            {
               signal = ENTRY_SIGNAL_INITIAL_BREAKOUT;
               StoreLastTrendEntrySignal(false, signal);
               return signal;
            }
         }
         if (ArraySize(g_m1Close) >= 4 &&
             bbWidth / atr >= continuationMinBBATR &&
             g_m1Close[1] < g_bbMiddle[1] - atr * continuationMinDistanceATR &&
             g_m1Close[1] < g_m1Close[2] && g_m1Close[2] <= g_m1Close[3])
         {
            int lookback = MathMin(continuationLookback, MathMax(0, ArraySize(g_m1Low) - 2));
            if (lookback > 0)
            {
               double lowestLow = g_m1Low[2];
               for (int i = 3; i <= lookback + 1 && i < ArraySize(g_m1Low); i++)
                  if (g_m1Low[i] < lowestLow)
                     lowestLow = g_m1Low[i];
               if (g_m1Close[1] - lowestLow <= atr * continuationMinDistanceATR &&
                   g_bbMiddle[1] - g_m1Close[1] <= atr * continuationMaxExtensionATR)
               {
                  signal = ENTRY_SIGNAL_CONTINUATION;
                  StoreLastTrendEntrySignal(false, signal);
                  return signal;
               }
            }
         }
      }
   }

   StoreLastTrendEntrySignal(isBuy, ENTRY_SIGNAL_NONE);
   return ENTRY_SIGNAL_NONE;
}

void EvaluateCloseConditions(bool isBuy, double currentPrice, bool &stochasticCondition)
{
   stochasticCondition = EnableStochasticClose && (isBuy ? g_stochasticCloseBuy : g_stochasticCloseSell);
}

void LogCloseConditionAnalysis(bool isBuy, ulong ticket, ulong positionId, double currentPrice,
                               bool stochasticCondition)
{
   if (!EnableAnalysisCsv)
      return;
   SAnalysisRecord analysis;
   ResetAnalysisRecord(analysis, "EXIT_SIGNAL");
   SetAnalysisContext(analysis, TimeCurrent(), AnalysisCurrentTimeMsc());
   analysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
   analysis.values[AC_TICKET] = AnalysisLong((long)ticket);
   analysis.values[AC_POSITION] = AnalysisLong((long)positionId);
   analysis.values[AC_PRICE] = AnalysisNumber(currentPrice, _Digits);
   analysis.values[AC_CLOSE_STOCHASTIC] = stochasticCondition ? "true" : "false";
   analysis.values[AC_CLOSE_TREND_BB_MIDDLE] = "false";
   analysis.values[AC_REASON] = BuildCloseReason(stochasticCondition);
   analysis.values[AC_REASON_DETAIL] = "成立した決済条件。実際のDeal reasonはDEALレコードで記録。";
   WriteAnalysisRecord(analysis);
}

void ClosePositions(bool canClose, ENUM_POSITION_TYPE posType, double closePrice, double currentPrice)
{
   if (!canClose || closePrice <= 0)
      return;

   bool isBuy = (posType == POSITION_TYPE_BUY);
   bool stochasticCondition = false;
   EvaluateCloseConditions(isBuy, currentPrice, stochasticCondition);
   bool condition = stochasticCondition;
   if (!condition)
      return;

   string reason = BuildCloseReason(stochasticCondition);

   int count = isBuy ? BuyCount : SellCount;
   if (count <= 0)
      return;

   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      if (PositionGetInteger(POSITION_TYPE) != posType)
         continue;

      LogCloseConditionAnalysis(isBuy, ticket, (ulong)PositionGetInteger(POSITION_IDENTIFIER),
                                currentPrice, stochasticCondition);
      if (ClosePositionByTicket(ticket, reason))
      {
         if (isBuy)
            g_lastBuyCloseBarTime = LastM1;
         else
            g_lastSellCloseBarTime = LastM1;
      }
   }
}

// ===================================================================
// ヘルパー関数: エントリー処理
// グローバル変数 g_canEntryBuy/Sell, g_entryThresholdCrossedBuy/Sell を使用
// ===================================================================
void EnterPosition(bool canEntry, ENUM_POSITION_TYPE posType, double entryPrice, double currentPrice, double ask, double bid)
{
   if (!canEntry || entryPrice <= 0.0)
   {
      ClearEntrySuppressionState(posType == POSITION_TYPE_BUY, "Entry candidate no longer active.");
      return;
   }

   bool isBuy = posType == POSITION_TYPE_BUY;
   bool isTrend = IsDirectionalTrendType(g_TrendTypeH);
   bool isRange = g_TrendTypeH == TREND_RANGE;
   string signalText = "";
   if (EnableAnalysisCsv)
      signalText = isBuy ? EnumToString(g_lastTrendEntrySignalBuy) : EnumToString(g_lastTrendEntrySignalSell);
   if (!g_h1AllOk || !g_m15AllOk || !g_m1AllOk)
   {
      LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_INDICATOR,
                          "H1/M15/M1 indicator set is not ready.", ask, bid);
      return;
   }
   if (!IsIndicatorValueValid(entryPrice) || !IsIndicatorValueValid(ask) || !IsIndicatorValueValid(bid))
   {
      LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_INDICATOR,
                          "Entry price or current quote is invalid.", ask, bid);
      return;
   }

   EntrySignalType signal = EvaluateTrendEntrySignal(isBuy);
   if (signal == ENTRY_SIGNAL_NONE)
   {
      if (!isRange)
      {
         ClearEntrySuppressionState(isBuy, "No entry signal is active.");
         return;
      }
      if (EnableAnalysisCsv)
         signalText = "RANGE_BB_REENTRY";
   }
   else if (EnableAnalysisCsv)
      signalText = EntrySignalToString(signal);

   if (EnableAnalysisCsv)
      UpdateAtr2CurrentEntrySignal(isBuy, signalText);

   if (isRange)
   {
      if (ArraySize(g_bbUpper) <= 1 || ArraySize(g_bbLower) <= 1 ||
          ArraySize(g_m15_rsiArr) <= 1 || !g_m15_rsi_ok || !g_m1_bb_ok)
      {
         LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_INDICATOR,
                             "Range entry indicator value unavailable.", ask, bid);
         return;
      }
      double bbWidth = g_bbUpper[1] - g_bbLower[1];
      bool bbWidthOk = bbWidth >= SL_Points * 1.5 * _Point;
      bool rangeBuyOk = bbWidthOk && g_m15_rsiArr[1] <= rsiOversold &&
                        g_entryThresholdCrossedBuy && ask <= entryPrice;
      bool rangeSellOk = bbWidthOk && g_m15_rsiArr[1] >= rsiOverbought &&
                         g_entryThresholdCrossedSell && bid >= entryPrice;
      if ((isBuy && !rangeBuyOk) || (!isBuy && !rangeSellOk))
      {
         ClearEntrySuppressionState(isBuy, "Range entry condition is no longer active.");
         return;
      }
   }

   bool condition = isBuy
      ? (g_entryBuyOnOrBelow ? ask <= entryPrice : ask >= entryPrice)
      : (g_entrySellOnOrAbove ? bid >= entryPrice : bid <= entryPrice);
   if (!condition)
   {
      ClearEntrySuppressionState(isBuy, "Entry price condition is no longer active.");
      return;
   }

   int sameDirCount = isBuy ? BuyCount : SellCount;
   bool allowPyramid = false;
   if (sameDirCount > 0 && g_TrendTypeH == TREND_STRONG_UP && isBuy &&
       g_H1DiDir == 1 && g_H1EmaDir == 1)
      allowPyramid = true;
   if (sameDirCount > 0 && g_TrendTypeH == TREND_STRONG_DOWN && !isBuy &&
       g_H1DiDir == -1 && g_H1EmaDir == -1)
      allowPyramid = true;

   int suppressionReasons = 0;
   string suppressionDetails = "";
   if (g_weekendForceCloseActive)
   {
      suppressionReasons |= ENTRY_SUPPRESS_WEEKEND;
      if (EnableAnalysisCsv)
         suppressionDetails += "Weekend schedule stopped new entries;";
   }
   if (isTrend && !EnableTrendTrading)
   {
      suppressionReasons |= ENTRY_SUPPRESS_TREND_SETTING;
      if (EnableAnalysisCsv)
         suppressionDetails += "EnableTrendTrading=false;";
   }
   if (isRange && !EnableRangeTrading)
   {
      suppressionReasons |= ENTRY_SUPPRESS_RANGE_SETTING;
      if (EnableAnalysisCsv)
         suppressionDetails += "EnableRangeTrading=false;";
   }
   if (!isTrend && !isRange)
   {
      suppressionReasons |= ENTRY_SUPPRESS_H1_DIRECTION;
      if (EnableAnalysisCsv)
         suppressionDetails += "H1 classification is not tradable;";
   }
   if (isTrend && ((isBuy && (g_H1DiDir != 1 || ArraySize(g_superTrendDir) <= 1 || g_superTrendDir[1] <= 0)) ||
                   (!isBuy && (g_H1DiDir != -1 || ArraySize(g_superTrendDir) <= 1 || g_superTrendDir[1] >= 0))))
   {
      suppressionReasons |= ENTRY_SUPPRESS_H1_DIRECTION;
      if (EnableAnalysisCsv)
         suppressionDetails += "H1 DI or M1 SuperTrend direction mismatch;";
   }
   if ((isBuy && g_lastBuyCloseBarTime == LastM1) ||
       (!isBuy && g_lastSellCloseBarTime == LastM1))
   {
      suppressionReasons |= ENTRY_SUPPRESS_SAME_M1_CLOSE;
      if (EnableAnalysisCsv)
         suppressionDetails += "Same-direction close already occurred on this M1 bar;";
   }
   if (allowPyramid && sameDirCount > 0 && !IsPyramidAllowedByM15(isBuy))
   {
      suppressionReasons |= ENTRY_SUPPRESS_M15_PYRAMID;
      if (EnableAnalysisCsv)
         suppressionDetails += "Existing M15 pyramid restriction;";
   }
   if (!allowPyramid && sameDirCount >= maxPositionsNormal)
   {
      suppressionReasons |= ENTRY_SUPPRESS_POSITION_CAP;
      if (EnableAnalysisCsv)
         suppressionDetails += "Normal same-direction position cap;";
   }
   if (allowPyramid && sameDirCount >= maxPositionsPyramid)
   {
      suppressionReasons |= ENTRY_SUPPRESS_POSITION_CAP;
      if (EnableAnalysisCsv)
         suppressionDetails += "Pyramid same-direction position cap;";
   }
   if (suppressionReasons != 0)
   {
      LogEntrySuppression(isBuy, entryPrice, signalText, suppressionReasons,
                          suppressionDetails, ask, bid);
      return;
   }

   double price = currentPrice;
   if (!IsIndicatorValueValid(g_atr[1]) || g_atr[1] <= 0.0)
   {
      LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_INDICATOR,
                          "M1 ATR[1] is invalid.", ask, bid);
      return;
   }
   double stopsLevelDistance = SymbolInfoInteger(_Symbol, SYMBOL_TRADE_STOPS_LEVEL) * _Point;
   double slDistance = MathMax(MathMax(g_atr[1] * atrMultiplierSL, SL_Points * _Point), stopsLevelDistance);
   double sl = NormalizeDouble(isBuy ? (price - slDistance) : (price + slDistance), _Digits);
   double tp = 0.0;
   if (g_TrendTypeH == TREND_RANGE && EnableRangeTP)
   {
      tp = isBuy ? g_bbUpper[1] : g_bbLower[1];
      if (isBuy)
      {
         if (tp - ask < stopsLevelDistance)
         {
            LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_OTHER,
                                "Range TP is inside the broker minimum stop distance.", ask, bid);
            return;
         }
      }
      else if (bid - tp < stopsLevelDistance)
      {
         LogEntrySuppression(isBuy, entryPrice, signalText, ENTRY_SUPPRESS_OTHER,
                             "Range TP is inside the broker minimum stop distance.", ask, bid);
         return;
      }
   }

   double lot = BaseLot;
   if (g_TrendTypeH == TREND_RANGE)
      lot *= lot_range;
   else if (sameDirCount == 0)
      lot = BaseLot * lot_first_trend;
   else
      lot = BaseLot * lot_follow_trend;

   double vol_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double vol_min = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   if (vol_step <= 0)
      vol_step = 0.01;
   if (vol_min <= 0)
      vol_min = vol_step;
   double steps = MathRound(lot / vol_step);
   lot = MathMax(vol_min, steps * vol_step);

   if (lot > 0)
   {
      if (EnableAnalysisCsv)
      {
         double balance = AccountInfoDouble(ACCOUNT_BALANCE);
         double equity = AccountInfoDouble(ACCOUNT_EQUITY);
         double freeMargin = AccountInfoDouble(ACCOUNT_MARGIN_FREE);
         double requiredMargin = 0.0;
         bool marginCalculated = false;
         if (OrderCalcMargin((isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL), _Symbol, lot, (isBuy ? ask : bid), requiredMargin))
            marginCalculated = true;

         SAnalysisRecord marginAnalysis;
         ResetAnalysisRecord(marginAnalysis, "OTHER_ANALYSIS");
         SetAnalysisContext(marginAnalysis, TimeCurrent(), AnalysisCurrentTimeMsc());
         marginAnalysis.values[AC_REASON] = "Order margin check";
         marginAnalysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
         marginAnalysis.values[AC_LOT] = AnalysisNumber(lot, 2);
         marginAnalysis.values[AC_BALANCE] = AnalysisNumber(balance, 2);
         marginAnalysis.values[AC_EQUITY] = AnalysisNumber(equity, 2);
         marginAnalysis.values[AC_FREE_MARGIN] = AnalysisNumber(freeMargin, 2);
         if (marginCalculated)
            marginAnalysis.values[AC_REQUIRED_MARGIN] = AnalysisNumber(requiredMargin, 2);
         else
            marginAnalysis.values[AC_REASON_DETAIL] = "OrderCalcMargin failed";
         WriteAnalysisRecord(marginAnalysis);

         SAnalysisRecord signalAnalysis;
         ResetAnalysisRecord(signalAnalysis, "ENTRY_SIGNAL");
         SetAnalysisContext(signalAnalysis, TimeCurrent(), AnalysisCurrentTimeMsc());
         signalAnalysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
         signalAnalysis.values[AC_ENTRY_SIGNAL] = signalText;
         signalAnalysis.values[AC_SAME_DIRECTION_COUNT] = IntegerToString(sameDirCount);
         signalAnalysis.values[AC_LOT] = AnalysisNumber(lot, 2);
         signalAnalysis.values[AC_BID] = AnalysisNumber(bid, _Digits);
         signalAnalysis.values[AC_ASK] = AnalysisNumber(ask, _Digits);
         signalAnalysis.values[AC_SPREAD_POINTS] = AnalysisNumber((ask - bid) / _Point, 1);
         signalAnalysis.values[AC_ENTRY_PRICE] = AnalysisNumber(entryPrice, _Digits);
         signalAnalysis.values[AC_REASON] = isRange ? "Range entry conditions satisfied" : "Trend entry conditions satisfied";
         WriteAnalysisRecord(signalAnalysis);
      }

      ENUM_ORDER_TYPE orderType = isBuy ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
      bool orderSent = SendMarketOrder(orderType, lot, sl, tp, signal);
      ClearEntrySuppressionState(isBuy, "Entry suppression conditions cleared.");
      if (orderSent)
      {
         if (isBuy)
         {
            SetAnalysisFlag(g_entryThresholdCrossedBuy, "g_entryThresholdCrossedBuy", false,
                           "Entry order accepted.");
            if (allowPyramid)
               SetAnalysisFlag(g_superTrendPullbackBuy, "g_superTrendPullbackBuy", false,
                               "Entry order accepted after pullback.");
         }
         else
         {
            SetAnalysisFlag(g_entryThresholdCrossedSell, "g_entryThresholdCrossedSell", false,
                           "Entry order accepted.");
            if (allowPyramid)
               SetAnalysisFlag(g_superTrendPullbackSell, "g_superTrendPullbackSell", false,
                               "Entry order accepted after pullback.");
         }
      }
   }
}

