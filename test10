void OnTick()
{
   if (EnableAnalysisCsv)
   {
      MqlTick tick;
      ZeroMemory(tick);
      if (SymbolInfoTick(_Symbol, tick))
      {
         g_currentAnalysisEventTime = (datetime)tick.time;
         g_currentAnalysisEventTimeMsc = tick.time_msc;
         RecordTradeTickContext("TICK", 0, 0, tick, iTime(_Symbol, PERIOD_M1, 1));
      }
      else
      {
         g_currentAnalysisEventTime = 0;
         g_currentAnalysisEventTimeMsc = 0;
      }
   }

   MonitorAtr2ExtensionTicks();

   double ASK = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double BID = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   double spreadPts = (ASK - BID) / _Point;

   if (ASK <= 0 || BID <= 0)
   {
      PrintFormat("価格データが無効のため処理を中断します。ASK=%.5f BID=%.5f スプレッド=%.1fポイント",
                  ASK, BID, spreadPts);
      FlushPendingAtr2Records();
      return;
   }

   // BuyCount/SellCount の判定をg_closePrice 判定より前に移動
   NowPositions = 0;
   BuyCount = 0;
   SellCount = 0;
   for (int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if (!PositionSelectByTicket(ticket))
         continue;
      if (PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;
      if ((int)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;
      NowPositions++;
      if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY)
         BuyCount++;
      else if (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_SELL)
         SellCount++;
   }

   // 決済処理
   TrendM1.UpdatePullback(ASK, BID);
   if (g_TrendTypeH == TREND_RANGE)
   {
      if (BID <= g_bbLower[1])
         SetAnalysisFlag(g_entryThresholdCrossedBuy, "g_entryThresholdCrossedBuy", true,
                         "Current Bid reached the range entry threshold.");
      if (ASK >= g_bbUpper[1])
         SetAnalysisFlag(g_entryThresholdCrossedSell, "g_entryThresholdCrossedSell", true,
                         "Current Ask reached the range entry threshold.");
   }
   ClosePositions(g_canCloseBuy, POSITION_TYPE_BUY, g_closePriceBuy, BID);
   ClosePositions(g_canCloseSell, POSITION_TYPE_SELL, g_closePriceSell, ASK);
   UpdateRangeMinimumProfitStops();

   bool buyCloseSignal = false;
   bool sellCloseSignal = false;
   if (g_canCloseBuy && g_closePriceBuy > 0)
   {
      bool stochasticCondition = false;
      EvaluateCloseConditions(true, BID, stochasticCondition);
      buyCloseSignal = stochasticCondition;
   }
   if (g_canCloseSell && g_closePriceSell > 0)
   {
      bool stochasticCondition = false;
      EvaluateCloseConditions(false, ASK, stochasticCondition);
      sellCloseSignal = stochasticCondition;
   }

   UpdateTrailingStops();

   // 決済後にスプレッド閾値チェック（スプレッドが大きければエントリを中止）
   if (spreadPts > MaxAllowedSpread)
   {
      // PrintFormat("スプレッドが閾値を超えたため処理を中断します。ASK=%.5f BID=%.5f スプレッド=%.1fポイント 閾値=%dポイント",
      //             ASK, BID, spreadPts, MaxAllowedSpread);
      if (EnableAnalysisCsv && g_canEntryBuy)
         LogEntrySuppression(true, g_entryPriceBuy, EnumToString(g_lastTrendEntrySignalBuy),
                             ENTRY_SUPPRESS_SPREAD, "OnTick spread filter.",
                             ASK, BID);
      if (EnableAnalysisCsv && g_canEntrySell)
         LogEntrySuppression(false, g_entryPriceSell, EnumToString(g_lastTrendEntrySignalSell),
                             ENTRY_SUPPRESS_SPREAD, "OnTick spread filter.",
                             ASK, BID);
      FlushPendingAtr2Records();
      return;
   }

   // エントリ判定は OnTimer で算出した価格・フラグを使用
   if (g_canEntryBuy && !EnableEntryOnCloseSignal && buyCloseSignal)
   {
      if (EnableAnalysisCsv)
         LogEntrySuppression(true, g_entryPriceBuy, EnumToString(g_lastTrendEntrySignalBuy),
                             ENTRY_SUPPRESS_CLOSE_SIGNAL,
                             "EnableEntryOnCloseSignal=false while BUY close signal is active.",
                             ASK, BID);
   }
   else
   {
      EnterPosition(g_canEntryBuy, POSITION_TYPE_BUY, g_entryPriceBuy, ASK, ASK, BID);
   }
   if (g_canEntrySell && !EnableEntryOnCloseSignal && sellCloseSignal)
   {
      if (EnableAnalysisCsv)
         LogEntrySuppression(false, g_entryPriceSell, EnumToString(g_lastTrendEntrySignalSell),
                             ENTRY_SUPPRESS_CLOSE_SIGNAL,
                             "EnableEntryOnCloseSignal=false while SELL close signal is active.",
                             ASK, BID);
   }
   else
   {
      EnterPosition(g_canEntrySell, POSITION_TYPE_SELL, g_entryPriceSell, BID, ASK, BID);
   }
   FlushPendingAtr2Records();
}

