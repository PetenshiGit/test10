//| TradeTransaction function                                        |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
{
   switch (trans.type)
   {
      case TRADE_TRANSACTION_ORDER_ADD:
         PrintFormat("注文追加: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_ORDER_DELETE:
         PrintFormat("注文取消: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_ORDER_UPDATE:
         PrintFormat("注文更新: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_DEAL_ADD:
         AddTradeHistoryTimestamp(TimeCurrent());
         PrintFormat("約定発生: position=%I64u deal=%I64u", trans.position, trans.deal);
         break;
      case TRADE_TRANSACTION_POSITION:
         PrintFormat("ポジション情報変更: position=%I64u", trans.position);
         break;
      default:
         break;
   }
}

