bool WriteDetailedAnalysisFileRecord(SAnalysisRecord &record)
{
   if (!EnableAnalysisCsv)
      return true;

   datetime recordTime = StringToTime(record.values[AC_DATE_TIME]);
   if (record.values[AC_DATE_TIME] == "" || recordTime <= 0)
   {
      PrintFormat("CSV書き込み失敗：レコード日時が不正です。RecordType=%s DateTime=%s",
                  record.values[AC_RECORD_TYPE], record.values[AC_DATE_TIME]);
      g_analysisWriteFailureCount++;
      return false;
   }
   if (!OpenAnalysisCsv(recordTime))
   {
      g_analysisWriteFailureCount++;
      return false;
   }

   ResetLastError();
   uint written = FileWriteString(g_analysisFile, BuildAnalysisCsvLine(record.values));
   if (written == 0)
   {
      PrintFormat("CSV書き込み失敗：RecordType=%s error=%d", record.values[AC_RECORD_TYPE], GetLastError());
      g_analysisWriteFailureCount++;
      return false;
   }
   g_analysisWriteSuccessCount++;
   return true;
}

