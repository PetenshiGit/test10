string BuildCloseReason(bool stochasticCondition, bool rangeBBCondition, bool trendSuperTrendCondition, bool trendBBMiddleCondition)
{
   string reason = "";
   if (stochasticCondition)
      reason += "Stochastic過熱域クロス/反転";
   if (rangeBBCondition)
      reason += reason == "" ? "レンジBB逆側" : ", レンジBB逆側";
   if (trendSuperTrendCondition)
      reason += reason == "" ? "トレンドSuperTrend" : ", トレンドSuperTrend";
   if (trendBBMiddleCondition)
      reason += reason == "" ? "トレンドBB中央線" : ", トレンドBB中央線";
   return reason == "" ? "不明" : reason;
}

double LogArrayValue(const double &values[], int index)
{
   if (index < 0 || index >= ArraySize(values))
      return EMPTY_VALUE;
   return values[index];
}

string LogSuperTrendDirection(int index)
{
   if (index < 0 || index >= ArraySize(g_superTrendDir))
      return "不明";
   if (g_superTrendDir[index] > 0)
      return "上";
   if (g_superTrendDir[index] < 0)
      return "下";
   return "不明";
}

void EvaluateCloseConditions(bool isBuy, double currentPrice, bool &stochasticCondition, bool &rangeBBCondition, bool &trendSuperTrendCondition, bool &trendBBMiddleCondition)
{
   double closePrice = isBuy ? g_closePriceBuy : g_closePriceSell;
   bool priceReached = isBuy ? (g_closeBuyOnOrAbove ? currentPrice >= closePrice : currentPrice <= closePrice) // 決済価格到達状態
                             : (g_closeSellOnOrBelow ? currentPrice <= closePrice : currentPrice >= closePrice);
   rangeBBCondition = EnableRangeBBClose && (isBuy ? g_rangeBBCloseBuy : g_rangeBBCloseSell) && priceReached;
   trendSuperTrendCondition = EnableTrendSuperTrendClose && (isBuy ? g_trendSuperTrendCloseBuy : g_trendSuperTrendCloseSell) && priceReached;
   stochasticCondition = EnableStochasticClose && (isBuy ? g_stochasticCloseBuy : g_stochasticCloseSell);
   trendBBMiddleCondition = EnableTrendBBMiddleClose && (isBuy ? g_trendBBMiddleCloseBuy : g_trendBBMiddleCloseSell);
}

