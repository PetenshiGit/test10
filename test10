   g_tradeTickHistory[idx].diPlus = g_h1AllOk && ArraySize(g_h1_dipArr) > 1 ? g_h1_dipArr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].diMinus = g_h1AllOk && ArraySize(g_h1_dimArr) > 1 ? g_h1_dimArr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].emaShort = g_h1AllOk && ArraySize(g_h1_emaSArr) > 1 ? g_h1_emaSArr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].emaLong = g_h1AllOk && ArraySize(g_h1_emaLArr) > 1 ? g_h1_emaLArr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].diDirection = g_h1AllOk ? g_H1DiDir : 0;
   g_tradeTickHistory[idx].emaDirection = g_h1AllOk ? g_H1EmaDir : 0;
   g_tradeTickHistory[idx].rsi = g_m15AllOk && ArraySize(g_m15_rsiArr) > 1 ? g_m15_rsiArr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].macdMain = g_m15AllOk && ArraySize(g_m15_macdMainAll) > 1 ? g_m15_macdMainAll[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].macdSignal = g_m15AllOk && ArraySize(g_m15_macdSigAll) > 1 ? g_m15_macdSigAll[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].macdHistogram = g_m15AllOk && ArraySize(g_m15_macdMainAll) > 1 && ArraySize(g_m15_macdSigAll) > 1
      ? g_m15_macdMainAll[1] - g_m15_macdSigAll[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].macdCrossDirection = g_m15AllOk && g_M15Signal.hasMACDCross ? g_M15Signal.macdCrossDir : 0;
   g_tradeTickHistory[idx].bbUpper = g_m1_bb_ok && ArraySize(g_bbUpper) > 1 ? g_bbUpper[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].atr = g_m1_atr_ok && ArraySize(g_atr) > 1 ? g_atr[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].bbMiddle = g_m1_bb_ok && ArraySize(g_bbMiddle) > 1 ? g_bbMiddle[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].bbLower = g_m1_bb_ok && ArraySize(g_bbLower) > 1 ? g_bbLower[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].stochasticK = g_m1_stoch_ok && ArraySize(g_stochK) > 1 ? g_stochK[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].stochasticD = g_m1_stoch_ok && ArraySize(g_stochD) > 1 ? g_stochD[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].superTrend = ArraySize(g_superTrend) > 1 ? g_superTrend[1] : EMPTY_VALUE;
   g_tradeTickHistory[idx].superTrendDirection = ArraySize(g_superTrendDir) > 1 ? g_superTrendDir[1] : 0;
   g_tradeTickHistory[idx].eventId = eventId;
   g_tradeTickHistory[idx].recordType = recordType;
   g_tradeTickHistory[idx].relativeIndex = relativeIndex;
