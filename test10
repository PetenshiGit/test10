bool OpenAnalysisCsv(datetime recordTime)
{
   if (!EnableAnalysisCsv)
      return true;

   datetime weekStart = GetAnalysisWeekStart(recordTime);
   if (weekStart <= 0)
   {
      PrintFormat("CSV対象週の算出に失敗しました。recordTime=%s error=%d",
                  TimeToString(recordTime, TIME_DATE | TIME_SECONDS), GetLastError());
      return false;
   }

   string csvFileName = GenerateAnalysisCsvFileName(weekStart);
   if (csvFileName == "")
      return false;

   if (g_analysisFile != INVALID_HANDLE && g_currentAnalysisCsvFileName == csvFileName)
      return true;

   if (g_analysisFile != INVALID_HANDLE)
   {
      FileFlush(g_analysisFile);
      FileClose(g_analysisFile);
      g_analysisFile = INVALID_HANDLE;
      g_currentAnalysisCsvFileName = "";
   }

   bool initializedThisRun = IsAnalysisCsvInitialized(csvFileName);
   if (initializedThisRun)
   {
      g_analysisFile = FileOpen(csvFileName, FILE_READ | FILE_WRITE | FILE_TXT | FILE_ANSI, '\t', CP_UTF8);
   }
   else
   {
      if (FileIsExist(csvFileName) && !FileDelete(csvFileName))
      {
         PrintFormat("新規CSV作成前に既存ファイルを削除できません：%s error=%d",
                     csvFileName, GetLastError());
         return false;
      }
      g_analysisFile = FileOpen(csvFileName, FILE_WRITE | FILE_TXT | FILE_ANSI, '\t', CP_UTF8);
   }

   if (g_analysisFile == INVALID_HANDLE)
   {
      PrintFormat("CSVファイルを開けません：%s error=%d", csvFileName, GetLastError());
      return false;
   }

   if (initializedThisRun)
   {
      ResetLastError();
      if (!FileSeek(g_analysisFile, 0, SEEK_END))
      {
         PrintFormat("CSV追記位置への移動に失敗しました：%s error=%d", csvFileName, GetLastError());
         FileClose(g_analysisFile);
         g_analysisFile = INVALID_HANDLE;
         return false;
      }
   }
   else
   {
      ResetLastError();
      string headers[AC_COUNT] =
      {
         "RecordType", "DateTime", "TimeMsc", "Symbol", "Direction", "Price", "ExitPrice", "Bid", "Ask",
         "SpreadPoints", "Lot", "Ticket", "Order", "Deal", "Position", "Reason", "H1BarTime",
         "H1TrendType", "H1TrendState", "H1DIDirection", "H1EMADirection", "ADX", "DIPlus",
         "DIMinus", "EMAShort", "EMALong", "M15BarTime", "M15RSI", "M15MACDMain",
         "M15MACDSignal", "M15MACDHistogram", "M15MACDCross", "M1BarTime", "M1Open", "M1High",
         "M1Low", "M1Close", "M1TickVolume", "M1BBUpper", "M1BBMiddle", "M1BBLower",
         "M1StochK", "M1StochD", "M1ATR", "M1SuperTrend", "M1SuperTrendDirection", "EntrySignal",
         "CloseStochastic", "CloseTrendBBMiddle", "EntryPrice", "SL", "TP", "ElapsedSeconds",
         "SameDirectionCount", "LotCalculation", "Balance", "Equity", "FreeMargin", "RequiredMargin",
         "ReasonDetail", "ATR2Boundary", "ATR2Extension", "ATR2TickIndex", "ATR2ElapsedMs",
         "ATR2EventId", "ATR2InsideBoundary", "EntryExecuted", "TradeTickRecordType",
         "TradeTickEventId", "TradeTickRelativeIndex", "TradeTickTimeMsc", "TradeTickBid",
         "TradeTickAsk", "TradeTickSpreadPoints", "TradeTickM1BarTime", "TradeTickATR",
         "TradeTickBBMiddle", "TradeTickSuperTrend", "TradeTickDirection", "MagicNumber",
         "Retcode", "Comment", "PriceDifference", "RequestedPrice", "ExecutionPrice", "DealReason",
         "DealProfit", "DealCommission", "DealSwap", "DealFee", "OrderVolume", "DealVolume"
      };
      uint written = FileWriteString(g_analysisFile, BuildAnalysisCsvLine(headers));
      if (written == 0)
      {
         PrintFormat("CSVヘッダー書き込み失敗：%s error=%d", csvFileName, GetLastError());
         g_analysisWriteFailureCount++;
         FileClose(g_analysisFile);
         g_analysisFile = INVALID_HANDLE;
         return false;
      }

      int initializedCount = ArraySize(g_initializedAnalysisCsvFiles);
      if (ArrayResize(g_initializedAnalysisCsvFiles, initializedCount + 1) != initializedCount + 1)
      {
         PrintFormat("CSV初期化済み週の管理に失敗しました：%s error=%d", csvFileName, GetLastError());
         FileClose(g_analysisFile);
         g_analysisFile = INVALID_HANDLE;
         return false;
      }
      g_initializedAnalysisCsvFiles[initializedCount] = csvFileName;
   }

   g_currentAnalysisCsvFileName = csvFileName;
   return true;
}

void FlushPendingAtr2Records()
{
   if (!EnableAnalysisCsv)
      return;
   int index = 0;
   while (index < ArraySize(g_pendingAtr2Records))
   {
      if (!WriteAnalysisRecord(g_pendingAtr2Records[index].record))
      {
         index++;
         continue;
      }
      int count = ArraySize(g_pendingAtr2Records);
      for (int move = index; move < count - 1; move++)
         g_pendingAtr2Records[move] = g_pendingAtr2Records[move + 1];
      ArrayResize(g_pendingAtr2Records, count - 1);
   }
}

void QueueAtr2Record(SAnalysisRecord &record, bool isBuy)
{
   int size = ArraySize(g_pendingAtr2Records);
   if (ArrayResize(g_pendingAtr2Records, size + 1) != size + 1)
   {
      PrintFormat("ATR2記録キューを拡張できません。方向=%s error=%d",
                  isBuy ? "BUY" : "SELL", GetLastError());
      return;
   }
   g_pendingAtr2Records[size].record = record;
   g_pendingAtr2Records[size].isBuy = isBuy;
}

void UpdateAtr2CurrentEntrySignal(bool isBuy, const string signalText)
{
   long eventTimeMsc = g_currentAtr2TickTimeMsc;
   if (eventTimeMsc <= 0)
      return;
   if (isBuy && g_currentAtr2BuyRecordValid &&
       g_currentAtr2BuyRecord.values[AC_TIME_MSC] == AnalysisLong(eventTimeMsc))
      g_currentAtr2BuyRecord.values[AC_ENTRY_SIGNAL] = signalText;
   if (!isBuy && g_currentAtr2SellRecordValid &&
       g_currentAtr2SellRecord.values[AC_TIME_MSC] == AnalysisLong(eventTimeMsc))
      g_currentAtr2SellRecord.values[AC_ENTRY_SIGNAL] = signalText;
   for (int i = 0; i < ArraySize(g_pendingAtr2Records); i++)
      if (g_pendingAtr2Records[i].isBuy == isBuy &&
          g_pendingAtr2Records[i].record.values[AC_TIME_MSC] == AnalysisLong(eventTimeMsc))
         g_pendingAtr2Records[i].record.values[AC_ENTRY_SIGNAL] = signalText;
}

void MarkAtr2OrderAttempt(bool isBuy, EntrySignalType signal)
{
   if (!EnableAnalysisCsv || signal != ENTRY_SIGNAL_ATR2_EXTENSION ||
         g_currentAtr2TickTimeMsc <= 0 ||
         g_currentAtr2TickTimeMsc != g_currentAnalysisEventTimeMsc)
      return;
   SAnalysisRecord currentRecord;
   bool currentRecordValid = isBuy ? g_currentAtr2BuyRecordValid : g_currentAtr2SellRecordValid;
   if (!currentRecordValid)
      return;
   if (isBuy)
      currentRecord = g_currentAtr2BuyRecord;
   else
      currentRecord = g_currentAtr2SellRecord;
   if (currentRecord.values[AC_TIME_MSC] != AnalysisLong(g_currentAtr2TickTimeMsc))
      return;
   UpdateAtr2CurrentEntrySignal(isBuy, EntrySignalToString(signal));
   currentRecord.values[AC_ENTRY_SIGNAL] = EntrySignalToString(signal);
   for (int i = 0; i < ArraySize(g_pendingAtr2Records); i++)
      if (g_pendingAtr2Records[i].isBuy == isBuy &&
          g_pendingAtr2Records[i].record.values[AC_TIME_MSC] == AnalysisLong(g_currentAtr2TickTimeMsc))
         return;
   currentRecord.values[AC_REASON_DETAIL] = "SPECIAL_ENTRY_ORDER_ATTEMPT";
   QueueAtr2Record(currentRecord, isBuy);
}

void MarkAtr2EntryExecuted(bool isBuy, EntrySignalType signal)
{
   if (!EnableAnalysisCsv || signal != ENTRY_SIGNAL_ATR2_EXTENSION ||
       g_currentAtr2TickTimeMsc != g_currentAnalysisEventTimeMsc)
      return;
   for (int i = 0; i < ArraySize(g_pendingAtr2Records); i++)
      if (g_pendingAtr2Records[i].isBuy == isBuy &&
          g_pendingAtr2Records[i].record.values[AC_TIME_MSC] == AnalysisLong(g_currentAtr2TickTimeMsc))
         g_pendingAtr2Records[i].record.values[AC_ENTRY_EXECUTED] = "true";
      if (isBuy && g_currentAtr2BuyRecordValid &&
         g_currentAtr2BuyRecord.values[AC_TIME_MSC] == AnalysisLong(g_currentAtr2TickTimeMsc))
      g_currentAtr2BuyRecord.values[AC_ENTRY_EXECUTED] = "true";
      if (!isBuy && g_currentAtr2SellRecordValid &&
         g_currentAtr2SellRecord.values[AC_TIME_MSC] == AnalysisLong(g_currentAtr2TickTimeMsc))
      g_currentAtr2SellRecord.values[AC_ENTRY_EXECUTED] = "true";
}

void RecordTradeTickContext(const string recordType, long eventId, int relativeIndex, const MqlTick &tick, datetime m1BarTime)
{
   if (!EnableAnalysisCsv)
      return;
   if (tick.time <= 0 || tick.time_msc <= 0)
      return;
   if (tradeTickHistorySize <= 0)
      return;
   if (ArraySize(g_tradeTickHistory) != tradeTickHistorySize)
      ArrayResize(g_tradeTickHistory, tradeTickHistorySize);

   int idx = g_tradeTickWritePos % tradeTickHistorySize;
   g_tradeTickHistory[idx].time = (datetime)tick.time;
   g_tradeTickHistory[idx].timeMsc = tick.time_msc;
   g_tradeTickHistory[idx].bid = tick.bid;
   g_tradeTickHistory[idx].ask = tick.ask;
   g_tradeTickHistory[idx].spreadPoints = (tick.ask - tick.bid) / _Point;
   g_tradeTickHistory[idx].h1BarTime = iTime(_Symbol, PERIOD_H1, 1);
   g_tradeTickHistory[idx].m15BarTime = iTime(_Symbol, PERIOD_M15, 1);
   g_tradeTickHistory[idx].m1BarTime = m1BarTime;
   g_tradeTickHistory[idx].trendType = g_TrendTypeH;
   g_tradeTickHistory[idx].trendState = g_TrendStateH;
