void SetAnalysisContext(SAnalysisRecord &record, datetime dateTime, long timeMsc)
{
   if (timeMsc > 0)
      dateTime = (datetime)(timeMsc / 1000L);
   record.values[AC_DATE_TIME] = AnalysisDateTime(dateTime);
   if (timeMsc > 0)
      record.values[AC_TIME_MSC] = AnalysisLong(timeMsc);
   record.values[AC_SYMBOL] = _Symbol;
   record.values[AC_H1_BAR_TIME] = AnalysisDateTime(iTime(_Symbol, PERIOD_H1, 1));
   record.values[AC_H1_TREND_TYPE] = TrendTypeToString(g_TrendTypeH);
   record.values[AC_H1_TREND_STATE] = TrendStateToString(g_TrendStateH);
   record.values[AC_H1_DI_DIRECTION] = AnalysisDirection(g_H1DiDir);
   record.values[AC_H1_EMA_DIRECTION] = AnalysisDirection(g_H1EmaDir);
   record.values[AC_ADX] = AnalysisArrayValue(g_h1_adxArr, 1, 5);
   record.values[AC_DI_PLUS] = AnalysisArrayValue(g_h1_dipArr, 1, 5);
   record.values[AC_DI_MINUS] = AnalysisArrayValue(g_h1_dimArr, 1, 5);
   record.values[AC_EMA_SHORT] = AnalysisArrayValue(g_h1_emaSArr, 1, _Digits);
   record.values[AC_EMA_LONG] = AnalysisArrayValue(g_h1_emaLArr, 1, _Digits);
   record.values[AC_M15_BAR_TIME] = AnalysisDateTime(iTime(_Symbol, PERIOD_M15, 1));
   record.values[AC_M15_RSI] = AnalysisArrayValue(g_m15_rsiArr, 1, 3);
   record.values[AC_M15_MACD_MAIN] = AnalysisArrayValue(g_m15_macdMainAll, 1, 5);
   record.values[AC_M15_MACD_SIGNAL] = AnalysisArrayValue(g_m15_macdSigAll, 1, 5);
   if (ArraySize(g_m15_macdMainAll) > 1 && ArraySize(g_m15_macdSigAll) > 1)
      record.values[AC_M15_MACD_HISTOGRAM] = AnalysisNumber(g_m15_macdMainAll[1] - g_m15_macdSigAll[1], 5);
   record.values[AC_M15_MACD_CROSS] = MACDCrossDirToString(g_M15Signal.hasMACDCross ? g_M15Signal.macdCrossDir : 0);
   record.values[AC_M1_BAR_TIME] = AnalysisDateTime(iTime(_Symbol, PERIOD_M1, 1));
   record.values[AC_M1_BB_UPPER] = AnalysisArrayValue(g_bbUpper, 1, _Digits);
   record.values[AC_M1_BB_MIDDLE] = AnalysisArrayValue(g_bbMiddle, 1, _Digits);
   record.values[AC_M1_BB_LOWER] = AnalysisArrayValue(g_bbLower, 1, _Digits);
   record.values[AC_M1_STOCH_K] = AnalysisArrayValue(g_stochK, 1, 3);
   record.values[AC_M1_STOCH_D] = AnalysisArrayValue(g_stochD, 1, 3);
