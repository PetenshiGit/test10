void OnTimer()
{
   datetime bM1 = iTime(_Symbol, PERIOD_M1, 0);
   datetime bM15 = iTime(_Symbol, PERIOD_M15, 0);
   datetime bH1 = iTime(_Symbol, PERIOD_H1, 0);
   bool h1Updated = false;

   bool newM1Bar = bM1 != LastM1;

   // M1 更新判定
   if (newM1Bar || !g_m1AllOk)
   {
      g_superTrendPullbackBuy = false;
      g_superTrendPullbackSell = false;
      g_superTrendReaccelBuy = false;
      g_superTrendReaccelSell = false;
      if (newM1Bar)
         ResetM1Data();
      if (TrendM1.Calculate())
      {
         LastM1 = bM1;
         PrintFormat("OnTimer: 1分足更新ができた 時刻=%s", TimeToString(bM1, TIME_DATE | TIME_SECONDS));
      }
      else
      {
         g_m1AllOk = false;
         PrintFormat("OnTimer: 1分足更新ができなかった 時刻=%s", TimeToString(bM1, TIME_DATE | TIME_SECONDS));
      }
   }

   // M15 更新判定
   if (bM15 != LastM15 || !g_m15AllOk)
   {
      if (bM15 != LastM15)
         ResetM15Data();
      if (TrendM15.Calculate(bM15))
      {
         LastM15 = bM15;
         PrintFormat("OnTimer: 15分足更新ができた 時刻=%s", TimeToString(bM15, TIME_DATE | TIME_SECONDS));
      }
      else
      {
         g_m15AllOk = false;
         PrintFormat("OnTimer: 15分足更新ができなかった 時刻=%s", TimeToString(bM15, TIME_DATE | TIME_SECONDS));
      }
   }

   // H1 更新判定
   if (bH1 != LastH1 || !g_h1AllOk)
   {
      if (bH1 != LastH1)
         ResetH1Data();
      if (TrendH1.Calculate())
      {
         g_TrendTypeH = TrendH1.getType();
         g_TrendStateH = TrendH1.getState();
         g_TrendValueH = TrendH1.getValue();
         PrintFormat("OnTimer: 1時間足更新ができた 時刻=%s Type=%s State=%s",
                     TimeToString(bH1, TIME_DATE | TIME_SECONDS), TrendTypeToString(g_TrendTypeH), TrendStateToString(g_TrendStateH));
         // ADXの取得成功値表示はコメントアウト。
         LastH1 = bH1;
         h1Updated = true;
      }
      else
      {
         g_TrendTypeH = TREND_UNKNOWN;
         PrintFormat("OnTimer: 1時間足更新ができなかった 時刻=%s", TimeToString(bH1, TIME_DATE | TIME_SECONDS));
      }
   }

   // M1売買条件統合判定は、M15/H1更新後に実行する。
   if (newM1Bar)
      TrendM1.ComputeEntryExit(g_TrendTypeH);

   // M15シグナルは、M15確定後に最初に処理したM1足でのみ有効とする。
   // M1判定が完了した後に失効させ、同じ足の追撃判定では利用できるようにする。
   if (newM1Bar && g_M15Signal.pendingNextM1 && bM1 >= g_M15Signal.expireM1BarTime)
      g_M15Signal.pendingNextM1 = false;

   ProcessWeekendSession(TimeCurrent(), h1Updated);
}
