//+------------------------------------------------------------------+
//| TradeTransaction function                                        |
//+------------------------------------------------------------------+
void OnTradeTransaction(const MqlTradeTransaction &trans, const MqlTradeRequest &request, const MqlTradeResult &result)
{
   switch (trans.type)
   {
      case TRADE_TRANSACTION_ORDER_ADD:
         PrintFormat("注文追加: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_ORDER_DELETE:
         PrintFormat("注文取消: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_ORDER_UPDATE:
         PrintFormat("注文更新: チケット=%I64u", trans.order);
         break;
      case TRADE_TRANSACTION_DEAL_ADD:
      {
         AddTradeHistoryTimestamp(TimeCurrent());
         ResetLastError();
         if (!HistoryDealSelect(trans.deal))
         {
            PrintFormat("Deal情報取得中止：Deal選択失敗 deal=%I64u error=%d", trans.deal, GetLastError());
            break;
         }
         long dealType = HistoryDealGetInteger(trans.deal, DEAL_TYPE);
         long dealEntry = HistoryDealGetInteger(trans.deal, DEAL_ENTRY);
         long dealReason = HistoryDealGetInteger(trans.deal, DEAL_REASON);
         long dealTimeMsc = HistoryDealGetInteger(trans.deal, DEAL_TIME_MSC);
         ulong dealOrder = (ulong)HistoryDealGetInteger(trans.deal, DEAL_ORDER);
         ulong dealPosition = (ulong)HistoryDealGetInteger(trans.deal, DEAL_POSITION_ID);
         if (dealOrder == 0)
            dealOrder = trans.order;
         if (dealPosition == 0)
            dealPosition = trans.position;
         PrintFormat("Deal成立 deal=%I64u order=%I64u type=%s entry=%s reason=%s price=%.5f volume=%.2f",
                     trans.deal, dealOrder, dealType == DEAL_TYPE_BUY ? "BUY" : "SELL", dealEntry == DEAL_ENTRY_IN ? "IN" : dealEntry == DEAL_ENTRY_OUT ? "OUT" : dealEntry == DEAL_ENTRY_INOUT ? "INOUT" : dealEntry == DEAL_ENTRY_OUT_BY ? "OUT_BY" : "その他", DealReasonToString(dealReason), HistoryDealGetDouble(trans.deal, DEAL_PRICE), HistoryDealGetDouble(trans.deal, DEAL_VOLUME));
         if (dealEntry == DEAL_ENTRY_IN)
         {
            datetime inTime = (datetime)HistoryDealGetInteger(trans.deal, DEAL_TIME);
            SaveEntryLogRecord(dealPosition, trans.deal, inTime, dealTimeMsc);
            LogInAnalysis(trans.deal, dealOrder, dealType, inTime);
            LogPositionSummary(dealType == DEAL_TYPE_BUY ? "買い発注しました。" : "売り発注しました。");
         }
         else if (dealEntry == DEAL_ENTRY_OUT)
         {
            long positionType = dealType == DEAL_TYPE_SELL ? POSITION_TYPE_BUY : POSITION_TYPE_SELL;
            datetime outTime = (datetime)HistoryDealGetInteger(trans.deal, DEAL_TIME);
            LogOutAnalysis(trans.deal, dealOrder, positionType, dealReason, outTime, dealPosition);
            LogPositionSummary(dealType == DEAL_TYPE_SELL ? "買い決済しました。" : "売り決済しました。");
         }
         else
            LogPositionSummary("取引が発生しました。");
         break;
      }
      case TRADE_TRANSACTION_POSITION:
         PrintFormat("ポジション情報変更: position=%I64u", trans.position);
         break;
      default:
         break;
   }
}

