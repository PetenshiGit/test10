string RequestEvaluationToString(RequestEvaluation evaluation)
{
   if (evaluation == REQUEST_SEND_FAILED)
      return "SEND_FAILED";
   if (evaluation == REQUEST_EXECUTION_FAILED)
      return "EXECUTION_FAILED";
   return "SUCCEEDED";
}

string GenerateRequestCsvFileName()
{
   if (g_analysisRunId == "")
   {
      Print("リクエスト履歴CSVファイル名の生成に失敗しました。実行IDがありません。");
      return "";
   }
   return "EA_Requests_" + g_analysisRunId + ".csv";
}

bool OpenRequestCsv()
{
   if (g_requestCsvFile != INVALID_HANDLE)
      return true;

   if (g_requestCsvFileName == "")
      g_requestCsvFileName = GenerateRequestCsvFileName();
   if (g_requestCsvFileName == "")
      return false;

   if (g_requestCsvInitializedThisRun)
   {
      g_requestCsvFile = FileOpen(g_requestCsvFileName,
                                  FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI, ',', CP_UTF8);
   }
   else
   {
      g_requestCsvFile = FileOpen(g_requestCsvFileName,
                                  FILE_WRITE | FILE_CSV | FILE_ANSI, ',', CP_UTF8);
   }

   if (g_requestCsvFile == INVALID_HANDLE)
   {
      PrintFormat("リクエスト履歴CSVを開けません：%s error=%d",
                  g_requestCsvFileName, GetLastError());
      return false;
   }

   if (g_requestCsvInitializedThisRun)
   {
      ResetLastError();
      if (!FileSeek(g_requestCsvFile, 0, SEEK_END))
      {
         PrintFormat("リクエスト履歴CSVの追記位置への移動に失敗しました：%s error=%d",
                     g_requestCsvFileName, GetLastError());
         FileClose(g_requestCsvFile);
         g_requestCsvFile = INVALID_HANDLE;
         return false;
      }
      return true;
   }

   ResetLastError();
   if (FileWrite(g_requestCsvFile, "ServerTime", "RequestType", "Result", "Retcode") == 0)
   {
      PrintFormat("リクエスト履歴CSVのヘッダー書き込みに失敗しました：%s error=%d",
                  g_requestCsvFileName, GetLastError());
      FileClose(g_requestCsvFile);
      g_requestCsvFile = INVALID_HANDLE;
      return false;
   }
   FileFlush(g_requestCsvFile);
   g_requestCsvInitializedThisRun = true;
   return true;
}

void WriteRequestCsvRecord(datetime requestTime, const string requestType,
                           RequestEvaluation evaluation, uint retcode)
{
   if (!OpenRequestCsv())
      return;

   ResetLastError();
   if (FileWrite(g_requestCsvFile, TimeToString(requestTime, TIME_DATE | TIME_SECONDS),
                 requestType, RequestEvaluationToString(evaluation), retcode) == 0)
   {
      PrintFormat("リクエスト履歴CSVの書き込みに失敗しました：%s error=%d",
                  g_requestCsvFileName, GetLastError());
      FileClose(g_requestCsvFile);
      g_requestCsvFile = INVALID_HANDLE;
      return;
   }
   FileFlush(g_requestCsvFile);
}

void PruneRequestRecords(datetime nowTime)
{
   int total = ArraySize(g_requestRecords);
   int validCount = 0;
   for (int i = 0; i < total; i++)
   {
      long ageSeconds = (long)(nowTime - g_requestRecords[i].requestTime);
      if (ageSeconds < 0 || ageSeconds >= requestLogWindowSeconds)
         continue;
      if (validCount != i)
         g_requestRecords[validCount] = g_requestRecords[i];
      validCount++;
   }
   if (validCount < total)
      ArrayResize(g_requestRecords, validCount);
}

datetime GetRequestServerTime()
{
   datetime requestTime = TimeTradeServer();
   return requestTime > 0 ? requestTime : TimeCurrent();
}

bool CanSendSLTPRequest(datetime requestTime)
{
   PruneRequestRecords(requestTime);
   return ArraySize(g_requestRecords) < requestLogThreshold;
}

int RequestEvaluationCount(RequestEvaluation evaluation)
{
   int count = 0;
   for (int i = 0; i < ArraySize(g_requestRecords); i++)
      if (g_requestRecords[i].evaluation == evaluation)
         count++;
   return count;
}

void RecordRequest(const string requestType, RequestEvaluation evaluation, uint retcode,
                   datetime requestTime)
{
   WriteRequestCsvRecord(requestTime, requestType, evaluation, retcode);

   PruneRequestRecords(requestTime);

   int index = ArraySize(g_requestRecords);
   if (ArrayResize(g_requestRecords, index + 1) != index + 1)
   {
      PrintFormat("取引リクエスト監視履歴の更新に失敗しました。種別=%s retcode=%u error=%d",
                  requestType, retcode, GetLastError());
      return;
   }
   g_requestRecords[index].requestTime = requestTime;
   g_requestRecords[index].evaluation = evaluation;
   g_requestRecords[index].retcode = retcode;
   int count = ArraySize(g_requestRecords);
   if (count > requestLogThreshold)
   {
      PrintFormat("取引リクエスト頻度警告 時刻=%s 直近%d秒=%d 種別=%s 結果=%s retcode=%u 成功=%d 実行失敗=%d 送信失敗=%d",
                  TimeToString(requestTime, TIME_DATE | TIME_SECONDS), requestLogWindowSeconds,
                  count, requestType, RequestEvaluationToString(evaluation), retcode,
                  RequestEvaluationCount(REQUEST_EXECUTION_SUCCEEDED),
                  RequestEvaluationCount(REQUEST_EXECUTION_FAILED),
                  RequestEvaluationCount(REQUEST_SEND_FAILED));
   }
}

void AddTradeHistoryTimestamp(datetime t)
{
   if (TradeHistorySize < MAX_HISTORY)
   {
      for (int i = TradeHistorySize; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
      TradeHistorySize++;
   }
   else
   {
      for (int i = MAX_HISTORY - 1; i > 0; i--)
         TradeHistory[i] = TradeHistory[i - 1];
      TradeHistory[0] = t;
   }
}

