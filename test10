void RecordAtr2Direction(SAtr2Event &event, bool isBuy, const MqlTick &tick, double boundary, bool beyondBoundary)
{
   if (!MathIsValidNumber(boundary) || boundary == 0.0)
      return;

   if (!event.active && beyondBoundary)
   {
      event.active = true;
      if (EnableAnalysisCsv)
         event.eventId = g_nextAtr2EventId++;
      event.tickIndex = 1;
      event.startTimeMsc = tick.time_msc;
   }
   else if (event.active && beyondBoundary)
   {
      event.tickIndex++;
   }
   else if (event.active && !beyondBoundary)
   {
      event.tickIndex++;
      event.active = false;
   }
   else
   {
      return;
   }

   if (!EnableAnalysisCsv)
      return;

   if (tick.time <= 0 || tick.time_msc <= 0)
      return;

   bool recordTick = (beyondBoundary && event.tickIndex <= 3) || (!beyondBoundary && !event.active);

   SAnalysisRecord atr2Analysis;
   ResetAnalysisRecord(atr2Analysis, "ATR2_EXTENSION_TICK");
   SetAnalysisContext(atr2Analysis, (datetime)tick.time, tick.time_msc);
   atr2Analysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
   atr2Analysis.values[AC_BID] = AnalysisNumber(tick.bid, _Digits);
   atr2Analysis.values[AC_ASK] = AnalysisNumber(tick.ask, _Digits);
   atr2Analysis.values[AC_SPREAD_POINTS] = AnalysisNumber((tick.ask - tick.bid) / _Point, 1);
   atr2Analysis.values[AC_ATR2_BOUNDARY] = AnalysisNumber(boundary, _Digits);
   atr2Analysis.values[AC_ATR2_EXTENSION] = AnalysisNumber(isBuy ? tick.ask - boundary : boundary - tick.bid, _Digits);
   atr2Analysis.values[AC_ATR2_TICK_INDEX] = IntegerToString(event.tickIndex);
   atr2Analysis.values[AC_ATR2_ELAPSED_MS] = AnalysisLong(tick.time_msc - event.startTimeMsc);
   atr2Analysis.values[AC_ATR2_EVENT_ID] = AnalysisLong(event.eventId);
   atr2Analysis.values[AC_ATR2_INSIDE_BOUNDARY] = (!beyondBoundary) ? "true" : "false";
   atr2Analysis.values[AC_ENTRY_SIGNAL] = EnumToString(isBuy ? g_lastTrendEntrySignalBuy : g_lastTrendEntrySignalSell);
   atr2Analysis.values[AC_ENTRY_EXECUTED] = "false";

   if (isBuy)
   {
      g_currentAtr2BuyRecord = atr2Analysis;
      g_currentAtr2BuyRecordValid = true;
   }
   else
   {
      g_currentAtr2SellRecord = atr2Analysis;
      g_currentAtr2SellRecordValid = true;
   }

   if (recordTick)
      QueueAtr2Record(atr2Analysis, isBuy);

   if (!beyondBoundary)
      event.active = false;
}

void MonitorAtr2ExtensionTicks()
{
   if (EnableAnalysisCsv)
      FlushPendingAtr2Records();

   MqlTick tick;
   ZeroMemory(tick);
   if (!SymbolInfoTick(_Symbol, tick) || tick.bid <= 0.0 || tick.ask <= 0.0 ||
       !MathIsValidNumber(tick.bid) || !MathIsValidNumber(tick.ask) || _Point <= 0.0)
      return;
   if (!g_m1_bb_ok || !g_m1_atr_ok ||
       ArraySize(g_bbMiddle) <= 1 || ArraySize(g_atr) <= 1 ||
       !IsIndicatorValueValid(g_bbMiddle[1]) || g_bbMiddle[1] <= 0.0 ||
       !IsIndicatorValueValid(g_atr[1]) || g_atr[1] <= 0.0)
      return;

   datetime currentM1Bar = iTime(_Symbol, PERIOD_M1, 1);
   if (g_atr2M1BarTime != 0 && currentM1Bar != g_atr2M1BarTime)
      ResetAtr2StateForM1();
   g_atr2M1BarTime = currentM1Bar;

   if (EnableAnalysisCsv)
      g_currentAtr2TickTimeMsc = tick.time_msc;
   g_currentAtr2BoundaryBuy = g_bbMiddle[1] + g_atr[1] * initialBreakoutMaxExtensionATR;
   g_currentAtr2BoundarySell = g_bbMiddle[1] - g_atr[1] * initialBreakoutMaxExtensionATR;
   if (!MathIsValidNumber(g_currentAtr2BoundaryBuy) || !MathIsValidNumber(g_currentAtr2BoundarySell))
      return;

   RecordAtr2Direction(g_atr2BuyEvent, true, tick, g_currentAtr2BoundaryBuy, tick.ask > g_currentAtr2BoundaryBuy);
   RecordAtr2Direction(g_atr2SellEvent, false, tick, g_currentAtr2BoundarySell, tick.bid < g_currentAtr2BoundarySell);
}

bool IsIndicatorValueValid(double v)
{
   return (MathIsValidNumber(v) && v != EMPTY_VALUE);
}

bool AreIndicatorValuesValid(const double &values[])
{
   for (int i = 0; i < ArraySize(values); i++)
      if (!IsIndicatorValueValid(values[i]))
         return false;
   return ArraySize(values) == INDICATOR_BARS;
}

bool ArePriceValuesValid(const double &values[])
{
   int checkBars = MathMin(ArraySize(values), INDICATOR_BARS);
   if (checkBars <= 0)
      return(false);
   for (int i = 0; i < checkBars; i++)
      if (!IsIndicatorValueValid(values[i]))
         return(false);
   return(true);
}

