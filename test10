string EntrySuppressionReasonText(int mask)
{
   string reasons = "";
   if ((mask & ENTRY_SUPPRESS_WEEKEND) != 0) reasons += "Weekend stop;";
   if ((mask & ENTRY_SUPPRESS_INDICATOR) != 0) reasons += "Indicator data unavailable;";
   if ((mask & ENTRY_SUPPRESS_TREND_SETTING) != 0) reasons += "Trend entry disabled;";
   if ((mask & ENTRY_SUPPRESS_RANGE_SETTING) != 0) reasons += "Range entry disabled;";
   if ((mask & ENTRY_SUPPRESS_H1_DIRECTION) != 0) reasons += "H1 direction mismatch or unknown;";
   if ((mask & ENTRY_SUPPRESS_SAME_M1_CLOSE) != 0) reasons += "Same M1 bar as same-direction close;";
   if ((mask & ENTRY_SUPPRESS_CLOSE_SIGNAL) != 0) reasons += "Close signal active;";
   if ((mask & ENTRY_SUPPRESS_SPREAD) != 0) reasons += "Spread limit exceeded;";
   if ((mask & ENTRY_SUPPRESS_POSITION_CAP) != 0) reasons += "Same-direction position limit;";
   if ((mask & ENTRY_SUPPRESS_M15_PYRAMID) != 0) reasons += "M15 pyramid restriction;";
   if ((mask & ENTRY_SUPPRESS_OTHER) != 0) reasons += "Other existing entry constraint;";
   if ((mask & ENTRY_SUPPRESS_SEND_FAILURE) != 0) reasons += "Order request failed;";
   if (StringLen(reasons) > 0)
      reasons = StringSubstr(reasons, 0, StringLen(reasons) - 1) + ".";
   return reasons;
}

void ClearEntrySuppressionState(bool isBuy, const string reason)
{
   if (isBuy)
   {
      if (!g_entrySuppressionActiveBuy)
         return;
      g_entrySuppressionActiveBuy = false;
      g_entrySuppressionReasonBuy = 0;
      LogAnalysisFlagTransition("entrySuppressionBuy", true, false, reason);
      return;
   }
   if (!g_entrySuppressionActiveSell)
      return;
   g_entrySuppressionActiveSell = false;
   g_entrySuppressionReasonSell = 0;
   LogAnalysisFlagTransition("entrySuppressionSell", true, false, reason);
}

void LogEntrySuppression(bool isBuy, double entryPrice, const string signal, int reasonMask,
                         const string detail, double ask, double bid)
{
   if (!EnableAnalysisCsv)
      return;
   if (reasonMask == 0)
      return;

   bool transientFailure = (reasonMask & ENTRY_SUPPRESS_SEND_FAILURE) != 0;
   bool alreadyActive = false;
   int previousReasonMask = 0;
   if (!transientFailure)
   {
      alreadyActive = isBuy ? g_entrySuppressionActiveBuy : g_entrySuppressionActiveSell;
      previousReasonMask = isBuy ? g_entrySuppressionReasonBuy : g_entrySuppressionReasonSell;
      if (alreadyActive && previousReasonMask == reasonMask)
         return;
   }

   if (g_currentAnalysisEventTime <= 0 || g_currentAnalysisEventTimeMsc <= 0)
      return;
   if (!transientFailure)
   {
      if (isBuy)
      {
         g_entrySuppressionActiveBuy = true;
         g_entrySuppressionReasonBuy = reasonMask;
      }
      else
      {
         g_entrySuppressionActiveSell = true;
         g_entrySuppressionReasonSell = reasonMask;
      }
      if (!alreadyActive)
         LogAnalysisFlagTransitionAt(isBuy ? "entrySuppressionBuy" : "entrySuppressionSell",
                                     false, true, EntrySuppressionReasonText(reasonMask),
                                     g_currentAnalysisEventTime, g_currentAnalysisEventTimeMsc);
   }

   SAnalysisRecord analysis;
   ResetAnalysisRecord(analysis, "ENTRY_SUPPRESSION");
   SetAnalysisContext(analysis, g_currentAnalysisEventTime, g_currentAnalysisEventTimeMsc);
   analysis.values[AC_DIRECTION] = isBuy ? "BUY" : "SELL";
   analysis.values[AC_ENTRY_PRICE] = AnalysisNumber(entryPrice, _Digits);
   analysis.values[AC_ENTRY_SIGNAL] = signal;
   analysis.values[AC_BID] = AnalysisNumber(bid, _Digits);
   analysis.values[AC_ASK] = AnalysisNumber(ask, _Digits);
   if (ask > 0.0 && bid > 0.0 && _Point > 0.0)
      analysis.values[AC_SPREAD_POINTS] = AnalysisNumber((ask - bid) / _Point, 1);
   analysis.values[AC_REASON] = EntrySuppressionReasonText(reasonMask);
   analysis.values[AC_REASON_DETAIL] = detail;
   SLightAnalysisRecord lightRecord;
   BuildLightEntrySuppressionRecord(lightRecord, isBuy, reasonMask, g_currentAnalysisEventTimeMsc);
   bool detailedWritten = false;
   bool lightAttempted = false;
   bool lightWritten = false;
   WriteAnalysisEvent(analysis, true, detailedWritten, lightRecord, true,
                      lightAttempted, lightWritten);
}

